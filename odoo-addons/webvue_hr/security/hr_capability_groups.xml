<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_cap_hr_employees_read" model="res.groups"><field name="name">Capability: read employees</field><field name="privilege_id" ref="webvue_core.res_groups_privilege_webvue"/><field name="implied_ids" eval="[Command.clear()]"/></record>
    <!-- Odoo's private employee model protects inherited hr.version fields
         behind hr.group_hr_user. HR management capability grants that model
         field access; the model override still keeps account and archive
         mutations behind their dedicated actions. The contract fields are
         opened to this capability on the models themselves (hr_version.py,
         hr_employee.py), so the stock manager group, which bypasses company
         isolation on hr.version, is not implied. -->
    <record id="group_cap_hr_employees_manage" model="res.groups"><field name="name">Capability: manage employees</field><field name="privilege_id" ref="webvue_core.res_groups_privilege_webvue"/><field name="implied_ids" eval="[Command.link(ref('hr.group_hr_user'))]"/></record>
    <record id="group_cap_hr_employees_archive" model="res.groups"><field name="name">Capability: archive employees</field><field name="privilege_id" ref="webvue_core.res_groups_privilege_webvue"/><field name="implied_ids" eval="[Command.link(ref('hr.group_hr_user'))]"/></record>
    <record id="group_cap_hr_employees_access_status_read" model="res.groups"><field name="name">Capability: read employee access status</field><field name="privilege_id" ref="webvue_core.res_groups_privilege_webvue"/><field name="implied_ids" eval="[Command.link(ref('hr.group_hr_user'))]"/></record>
    <record id="group_cap_hr_departments_read" model="res.groups"><field name="name">Capability: read departments</field><field name="privilege_id" ref="webvue_core.res_groups_privilege_webvue"/></record>
    <record id="group_cap_hr_departments_manage" model="res.groups"><field name="name">Capability: manage departments</field><field name="privilege_id" ref="webvue_core.res_groups_privilege_webvue"/></record>
    <record id="group_cap_hr_documents_read" model="res.groups"><field name="name">Capability: read HR documents</field><field name="privilege_id" ref="webvue_core.res_groups_privilege_webvue"/></record>
    <record id="group_cap_hr_documents_manage" model="res.groups"><field name="name">Capability: manage HR documents</field><field name="privilege_id" ref="webvue_core.res_groups_privilege_webvue"/></record>

    <record id="group_hr_manager" model="res.groups">
        <field name="name">HR Manager</field><field name="privilege_id" ref="webvue_core.res_groups_privilege_webvue"/>
        <field name="implied_ids" eval="[Command.set([ref('webvue_core.group_employee'),ref('group_cap_hr_employees_read'),ref('group_cap_hr_employees_manage'),ref('group_cap_hr_employees_archive'),ref('group_cap_hr_employees_access_status_read'),ref('group_cap_hr_departments_read'),ref('group_cap_hr_departments_manage'),ref('group_cap_hr_documents_read'),ref('group_cap_hr_documents_manage')])]"/>
    </record>

    <!-- webvue_core's support group and user-directory rule reach HR through these links. -->
    <record id="webvue_core.group_vendor_support" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_hr_manager'))]"/>
    </record>
    <record id="webvue_core.rule_access_users_company" model="ir.rule">
        <field name="groups" eval="[Command.link(ref('group_cap_hr_employees_archive'))]"/>
    </record>
</odoo>
