<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Record rules of the payroll engine. The OCA payroll rules target its own groups,
         which nobody holds; these rules scope the WebVue groups instead. The OCA global
         company rule on hr.payslip still applies to every one of them. An employee reads
         only the approved payslips and lines of the employee record linked to their user;
         the payroll read capability reads every payslip of its companies (the global company
         rules below and OCA's bound the (1, '=', 1) group rules). -->
    <!-- OCA scopes only the payslip and its configuration models by company. The child
         tables and the batch carry no company rule of their own, so every group rule
         below would reach other companies without these global rules. -->
    <record id="rule_hr_payslip_line_company" model="ir.rule">
        <field name="name">webvue payroll: payslip line multi company</field>
        <field name="model_id" ref="payroll.model_hr_payslip_line"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('slip_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_hr_payslip_input_company" model="ir.rule">
        <field name="name">webvue payroll: payslip input multi company</field>
        <field name="model_id" ref="payroll.model_hr_payslip_input"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('payslip_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_hr_payslip_worked_days_company" model="ir.rule">
        <field name="name">webvue payroll: payslip worked days multi company</field>
        <field name="model_id" ref="payroll.model_hr_payslip_worked_days"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('payslip_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_hr_payslip_run_company" model="ir.rule">
        <field name="name">webvue payroll: payslip batch multi company</field>
        <field name="model_id" ref="payroll.model_hr_payslip_run"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Compensation is company-scoped for everyone (a rule without groups is global). -->
    <record id="rule_webvue_hr_compensation_company" model="ir.rule">
        <field name="name">webvue compensation: multi company</field>
        <field name="model_id" ref="model_webvue_hr_compensation"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- GOSI rates: the shared seed rows (no company) are readable by every company but writable by none;
         a company writes only its own rows. -->
    <record id="rule_webvue_hr_gosi_rate_company" model="ir.rule">
        <field name="name">webvue GOSI rate: shared or multi company</field>
        <field name="model_id" ref="model_webvue_hr_gosi_rate"/>
        <field name="global" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_webvue_hr_gosi_rate_write" model="ir.rule">
        <field name="name">webvue GOSI rate: own company rows only</field>
        <field name="model_id" ref="model_webvue_hr_gosi_rate"/>
        <field name="global" eval="True"/>
        <field name="perm_read" eval="False"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_webvue_hr_payroll_settings_company" model="ir.rule">
        <field name="name">webvue payroll settings: multi company</field>
        <field name="model_id" ref="model_webvue_hr_payroll_settings"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Salary file profiles: the shared seed rows (no company) are readable by every company but
         writable by none; a company writes only its own rows. -->
    <record id="rule_webvue_hr_bank_profile_read" model="ir.rule">
        <field name="name">webvue salary file profile: shared or multi company</field>
        <field name="model_id" ref="model_webvue_hr_payroll_bank_profile"/>
        <field name="global" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_webvue_hr_bank_profile_write" model="ir.rule">
        <field name="name">webvue salary file profile: own company rows only</field>
        <field name="model_id" ref="model_webvue_hr_payroll_bank_profile"/>
        <field name="global" eval="True"/>
        <field name="perm_read" eval="False"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_webvue_hr_bank_profile_column_read" model="ir.rule">
        <field name="name">webvue salary file profile column: shared or multi company</field>
        <field name="model_id" ref="model_webvue_hr_payroll_bank_profile_column"/>
        <field name="global" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">['|', ('profile_id.company_id', '=', False), ('profile_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_webvue_hr_bank_profile_column_write" model="ir.rule">
        <field name="name">webvue salary file profile column: own company rows only</field>
        <field name="model_id" ref="model_webvue_hr_payroll_bank_profile_column"/>
        <field name="global" eval="True"/>
        <field name="perm_read" eval="False"/>
        <field name="domain_force">[('profile_id.company_id', 'in', company_ids)]</field>
    </record>

    <!-- End-of-service case map: shared seed rows are readable by every company, a company writes only its own. -->
    <record id="rule_webvue_hr_eos_case_read" model="ir.rule">
        <field name="name">webvue end-of-service case: shared or multi company</field>
        <field name="model_id" ref="model_webvue_hr_payroll_eos_case"/>
        <field name="global" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_webvue_hr_eos_case_write" model="ir.rule">
        <field name="name">webvue end-of-service case: own company rows only</field>
        <field name="model_id" ref="model_webvue_hr_payroll_eos_case"/>
        <field name="global" eval="True"/>
        <field name="perm_read" eval="False"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_webvue_hr_eos_settlement_company" model="ir.rule">
        <field name="name">webvue end-of-service settlement: multi company</field>
        <field name="model_id" ref="model_webvue_hr_payroll_eos_settlement"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_hr_payslip_own_approved" model="ir.rule">
        <field name="name">webvue payroll: own approved payslips</field>
        <field name="model_id" ref="payroll.model_hr_payslip"/>
        <field name="groups" eval="[Command.link(ref('group_cap_hr_employees_read'))]"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id), ('state', '=', 'done')]</field>
        <field name="perm_create" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_hr_payslip_line_own_approved" model="ir.rule">
        <field name="name">webvue payroll: own approved payslip lines</field>
        <field name="model_id" ref="payroll.model_hr_payslip_line"/>
        <field name="groups" eval="[Command.link(ref('group_cap_hr_employees_read'))]"/>
        <field name="domain_force">[('slip_id.employee_id.user_id', '=', user.id), ('slip_id.state', '=', 'done')]</field>
        <field name="perm_create" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_hr_payslip_payroll_read" model="ir.rule">
        <field name="name">webvue payroll: read every payslip</field>
        <field name="model_id" ref="payroll.model_hr_payslip"/>
        <field name="groups" eval="[Command.link(ref('group_cap_hr_payroll_read'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_hr_payslip_line_payroll_read" model="ir.rule">
        <field name="name">webvue payroll: read every payslip line</field>
        <field name="model_id" ref="payroll.model_hr_payslip_line"/>
        <field name="groups" eval="[Command.link(ref('group_cap_hr_payroll_read'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- Payroll turns leave and allocations into pay: the reader sees them for every
         employee of its companies, for reading only. -->
    <record id="rule_hr_leave_payroll_read" model="ir.rule">
        <field name="name">webvue payroll: read company leaves</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="groups" eval="[Command.link(ref('group_cap_hr_payroll_read'))]"/>
        <field name="domain_force">[('employee_id.company_id', 'in', company_ids)]</field>
        <field name="perm_create" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_hr_leave_allocation_payroll_read" model="ir.rule">
        <field name="name">webvue payroll: read company leave allocations</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave_allocation"/>
        <field name="groups" eval="[Command.link(ref('group_cap_hr_payroll_read'))]"/>
        <field name="domain_force">[('employee_id.company_id', 'in', company_ids)]</field>
        <field name="perm_create" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
