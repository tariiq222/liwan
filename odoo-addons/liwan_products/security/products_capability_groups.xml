<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Technical: read, write and create on product.template and product.product, never unlink, narrowed for write
         and create by the rules of products_rules.xml to the service's products. The product.template and
         product.product overrides of this addon let a definition field change only through liwan.products.service.
         Both write capabilities imply it: a price-only holder writes list_price through the service. -->
    <record id="group_products_writer" model="res.groups"><field name="name">Technical: write service products</field><field name="privilege_id" ref="liwan_core.res_groups_privilege_liwan"/></record>
    <record id="group_cap_products_read" model="res.groups"><field name="name">Capability: read products</field><field name="privilege_id" ref="liwan_core.res_groups_privilege_liwan"/></record>
    <record id="group_cap_products_manage" model="res.groups"><field name="name">Capability: manage products</field><field name="privilege_id" ref="liwan_core.res_groups_privilege_liwan"/><field name="implied_ids" eval="[Command.link(ref('group_products_writer'))]"/></record>
    <record id="group_cap_products_prices_manage" model="res.groups"><field name="name">Capability: manage product prices</field><field name="privilege_id" ref="liwan_core.res_groups_privilege_liwan"/><field name="implied_ids" eval="[Command.link(ref('group_products_writer'))]"/></record>
    <record id="group_cap_products_settings_manage" model="res.groups"><field name="name">Capability: manage product settings</field><field name="privilege_id" ref="liwan_core.res_groups_privilege_liwan"/></record>
</odoo>
