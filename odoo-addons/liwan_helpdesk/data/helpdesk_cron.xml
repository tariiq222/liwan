<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- One run a day, as the system: it walks every company whose settings ask for it. -->
        <record id="ir_cron_helpdesk_auto_close" model="ir.cron">
            <field name="name">Support: close inactive tickets</field>
            <field name="model_id" ref="model_liwan_helpdesk_cron"/>
            <field name="state">code</field>
            <field name="code">model._liwan_auto_close()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
