<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="permission_helpdesk_tickets_read" model="liwan.access.permission">
        <field name="key">helpdesk.tickets.read</field><field name="domain">helpdesk</field>
        <field name="resource">tickets</field><field name="action">read</field>
        <field name="name_ar">قراءة تذاكر الدعم</field><field name="name_en">Read support tickets</field>
        <field name="description_ar">قراءة تذاكر الدعم وفق سياسة الرؤية المضبوطة للشركة</field><field name="description_en">Read support tickets under the company's visibility policy</field>
        <field name="group_xmlid">liwan_helpdesk.group_cap_helpdesk_tickets_read</field>
        <field name="custom_role_allowed" eval="True"/><field name="sensitive" eval="False"/>
    </record>
    <record id="permission_helpdesk_requests_read" model="liwan.access.permission">
        <field name="key">helpdesk.requests.read</field><field name="domain">helpdesk</field>
        <field name="resource">requests</field><field name="action">read</field>
        <field name="name_ar">متابعة طلبات الدعم الخاصة</field><field name="name_en">Follow own support requests</field>
        <field name="description_ar">قراءة طلبات الدعم التي فتحها الموظف بنفسه والرد عليها</field><field name="description_en">Read the support requests the employee opened and answer them</field>
        <field name="group_xmlid">liwan_helpdesk.group_cap_helpdesk_requests_read</field>
        <field name="custom_role_allowed" eval="True"/><field name="sensitive" eval="False"/>
    </record>
    <record id="permission_helpdesk_requests_create" model="liwan.access.permission">
        <field name="key">helpdesk.requests.create</field><field name="domain">helpdesk</field>
        <field name="resource">requests</field><field name="action">create</field>
        <field name="name_ar">فتح طلب دعم</field><field name="name_en">Open a support request</field>
        <field name="description_ar">فتح طلب دعم باسم الموظف نفسه</field><field name="description_en">Open a support request for oneself</field>
        <field name="group_xmlid">liwan_helpdesk.group_cap_helpdesk_requests_create</field>
        <field name="custom_role_allowed" eval="True"/><field name="sensitive" eval="False"/>
    </record>
    <record id="permission_helpdesk_tickets_write" model="liwan.access.permission">
        <field name="key">helpdesk.tickets.write</field><field name="domain">helpdesk</field>
        <field name="resource">tickets</field><field name="action">write</field>
        <field name="name_ar">معالجة تذاكر الدعم</field><field name="name_en">Work support tickets</field>
        <field name="description_ar">فتح تذكرة عن عميل، والرد عليها، وتغيير مرحلتها وأولويتها وبياناتها</field><field name="description_en">Open a ticket for a customer, reply to it and change its stage, priority and details</field>
        <field name="group_xmlid">liwan_helpdesk.group_cap_helpdesk_tickets_write</field>
        <field name="custom_role_allowed" eval="True"/><field name="sensitive" eval="False"/>
    </record>
    <record id="permission_helpdesk_tickets_assign" model="liwan.access.permission">
        <field name="key">helpdesk.tickets.assign</field><field name="domain">helpdesk</field>
        <field name="resource">tickets</field><field name="action">assign</field>
        <field name="name_ar">إسناد تذاكر الدعم</field><field name="name_en">Assign support tickets</field>
        <field name="description_ar">إسناد التذكرة لأي موظف ونقلها بين الفرق؛ ويفتح التذاكر كلها في الشركة</field><field name="description_en">Assign a ticket to any employee and move it between teams; opens every ticket of the company</field>
        <field name="group_xmlid">liwan_helpdesk.group_cap_helpdesk_tickets_assign</field>
        <field name="custom_role_allowed" eval="True"/><field name="sensitive" eval="True"/>
    </record>
    <record id="permission_helpdesk_tickets_close" model="liwan.access.permission">
        <field name="key">helpdesk.tickets.close</field><field name="domain">helpdesk</field>
        <field name="resource">tickets</field><field name="action">close</field>
        <field name="name_ar">إغلاق تذاكر الدعم وإعادة فتحها</field><field name="name_en">Close and reopen support tickets</field>
        <field name="description_ar">إغلاق التذكرة وإعادة فتحها داخل المدة التي تسمح بها سياسة الشركة</field><field name="description_en">Close a ticket and reopen it within the window the company policy allows</field>
        <field name="group_xmlid">liwan_helpdesk.group_cap_helpdesk_tickets_close</field>
        <field name="custom_role_allowed" eval="True"/><field name="sensitive" eval="False"/>
    </record>
                <record id="permission_helpdesk_tickets_merge" model="liwan.access.permission">
        <field name="key">helpdesk.tickets.merge</field><field name="domain">helpdesk</field>
        <field name="resource">tickets</field><field name="action">merge</field>
        <field name="name_ar">دمج تذاكر الدعم</field><field name="name_en">Merge support tickets</field>
        <field name="description_ar">دمج التذاكر المكرّرة في تذكرة واحدة ونقل مرفقاتها</field><field name="description_en">Merge duplicate tickets into one and move their attachments</field>
        <field name="group_xmlid">liwan_helpdesk.group_cap_helpdesk_tickets_merge</field>
        <field name="custom_role_allowed" eval="True"/><field name="sensitive" eval="True"/>
    </record>
    <record id="permission_helpdesk_reports_read" model="liwan.access.permission">
        <field name="key">helpdesk.reports.read</field><field name="domain">helpdesk</field>
        <field name="resource">reports</field><field name="action">read</field>
        <field name="name_ar">قراءة تقارير الدعم</field><field name="name_en">Read support reports</field>
        <field name="description_ar">قراءة زمن أول ردّ والحل والالتزام بالمهل وحِمل كل موظف</field><field name="description_en">Read first-response and resolution time, service-level compliance and workload per agent</field>
        <field name="group_xmlid">liwan_helpdesk.group_cap_helpdesk_reports_read</field>
        <field name="custom_role_allowed" eval="True"/><field name="sensitive" eval="False"/>
    </record>
    <record id="permission_helpdesk_settings_read" model="liwan.access.permission">
        <field name="key">helpdesk.settings.read</field><field name="domain">helpdesk</field>
        <field name="resource">settings</field><field name="action">read</field>
        <field name="name_ar">قراءة إعدادات الدعم</field><field name="name_en">Read support settings</field>
        <field name="description_ar">قراءة سياسة الدعم والمراحل والتصنيفات واتفاقيات الخدمة</field><field name="description_en">Read the support policy, stages, categories and service levels</field>
        <field name="group_xmlid">liwan_helpdesk.group_cap_helpdesk_settings_read</field>
        <field name="custom_role_allowed" eval="True"/><field name="sensitive" eval="False"/>
    </record>
    <record id="permission_helpdesk_settings_manage" model="liwan.access.permission">
        <field name="key">helpdesk.settings.manage</field><field name="domain">helpdesk</field>
        <field name="resource">settings</field><field name="action">manage</field>
        <field name="name_ar">إدارة إعدادات الدعم</field><field name="name_en">Manage support settings</field>
        <field name="description_ar">تغيير سياسة الرؤية والافتراضيات والترقيم والمراحل والتصنيفات والوسوم والقنوات</field><field name="description_en">Change the visibility policy, defaults, numbering, stages, categories, tags and channels</field>
        <field name="group_xmlid">liwan_helpdesk.group_cap_helpdesk_settings_manage</field>
        <field name="custom_role_allowed" eval="True"/><field name="sensitive" eval="True"/>
    </record>
            <data noupdate="1">
        <record id="role_helpdesk_agent" model="liwan.access.role">
            <field name="key">helpdesk_agent</field><field name="name_ar">وكيل الدعم الفني</field><field name="name_en">Support agent</field>
            <field name="description">Support agent</field><field name="type">built_in</field><field name="protected" eval="True"/><field name="assignable" eval="True"/>
            <field name="permission_ids" eval="[Command.set([ref('permission_helpdesk_tickets_read'),ref('permission_helpdesk_requests_read'),ref('permission_helpdesk_requests_create'),ref('permission_helpdesk_tickets_write')])]"/>
        </record>
        <record id="role_helpdesk_supervisor" model="liwan.access.role">
            <field name="key">helpdesk_supervisor</field><field name="name_ar">مشرف الدعم الفني</field><field name="name_en">Support supervisor</field>
            <field name="description">Support supervisor</field><field name="type">built_in</field><field name="protected" eval="True"/><field name="assignable" eval="True"/>
            <field name="permission_ids" eval="[Command.set([ref('permission_helpdesk_tickets_read'),ref('permission_helpdesk_requests_read'),ref('permission_helpdesk_requests_create'),ref('permission_helpdesk_tickets_write'),ref('permission_helpdesk_tickets_assign'),ref('permission_helpdesk_tickets_close'),ref('permission_helpdesk_tickets_merge'),ref('permission_helpdesk_reports_read'),ref('permission_helpdesk_settings_read')])]"/>
        </record>
        <record id="role_helpdesk_manager" model="liwan.access.role">
            <field name="key">helpdesk_manager</field><field name="name_ar">مدير الدعم الفني</field><field name="name_en">Support manager</field>
            <field name="description">Support manager</field><field name="type">built_in</field><field name="protected" eval="True"/><field name="assignable" eval="True"/>
            <field name="permission_ids" eval="[Command.set([ref('permission_helpdesk_tickets_read'),ref('permission_helpdesk_requests_read'),ref('permission_helpdesk_requests_create'),ref('permission_helpdesk_tickets_write'),ref('permission_helpdesk_tickets_assign'),ref('permission_helpdesk_tickets_close'),ref('permission_helpdesk_tickets_merge'),ref('permission_helpdesk_reports_read'),ref('permission_helpdesk_settings_read'),ref('permission_helpdesk_settings_manage')])]"/>
        </record>
    </data>
    <!-- Built-in roles are noupdate records: these hooks link this addon's grants and
         dependencies on install and on every upgrade. -->
    <function model="liwan.access.service" name="_liwan_configure_permission_dependencies"/>
    <function model="liwan.access.service" name="_liwan_repair_builtin_role_grants"/>
</odoo>
