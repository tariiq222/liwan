<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="liwan_inbox_catalog_company_rule" model="ir.rule">
        <field name="name">liwan.inbox.catalog: multi-company</field>
        <field name="model_id" ref="model_liwan_inbox_catalog"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="liwan_inbox_catalog_item_company_rule" model="ir.rule">
        <field name="name">liwan.inbox.catalog.item: multi-company</field>
        <field name="model_id" ref="model_liwan_inbox_catalog_item"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="liwan_inbox_order_company_rule" model="ir.rule">
        <field name="name">liwan.inbox.order: multi-company</field>
        <field name="model_id" ref="model_liwan_inbox_order"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="liwan_inbox_order_line_company_rule" model="ir.rule">
        <field name="name">liwan.inbox.order.line: multi-company</field>
        <field name="model_id" ref="model_liwan_inbox_order_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <!-- The catalog manager reaches the channels of the companies it manages, like the other channel managers. -->
    <record id="liwan_inbox.liwan_inbox_channel_company_rule" model="ir.rule">
        <field name="groups" eval="[Command.link(ref('group_cap_inbox_catalog_manage'))]"/>
    </record>
</odoo>
