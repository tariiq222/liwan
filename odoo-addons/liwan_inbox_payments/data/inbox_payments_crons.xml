<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_inbox_catalog_sync" model="ir.cron">
        <field name="name">liwan inbox: sync catalog items with Meta</field>
        <field name="model_id" ref="model_liwan_inbox_catalog"/>
        <field name="state">code</field>
        <field name="code">model._liwan_run_sync()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
