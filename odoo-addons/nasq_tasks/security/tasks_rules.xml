<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- A project-less task without company_id fails closed: nobody sees it, so every
         create path (the Task 3 service) must set company_id. -->
    <!-- A GLOBAL rule (no groups), on purpose. Odoo's task_visibility_rule lets a
         follower read a task and group rules are OR-ed, so only a global rule, which
         is AND-ed with them, keeps a follower who is neither creator nor assignee out
         of someone else's personal task. Project tasks pass through it untouched. -->
    <record id="rule_personal_task_visible" model="ir.rule">
        <field name="name">Tasks: personal tasks are private to creator and assignees</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="domain_force">['|', ('nasq_personal', '=', False),
            '&amp;', ('company_id', '=', company_id),
            '|', ('create_uid', '=', user.id), ('user_ids', 'in', [user.id])]</field>
    </record>
    <!-- Group rules are OR-ed with Odoo's own edition rule (assignees only), so a creator
         who is no longer an assignee can still write what they made, in every config.
         The global rule above keeps AND-ing: company and privacy are unchanged. -->
    <record id="rule_personal_task_creator_write" model="ir.rule">
        <field name="name">Tasks: the creator or an assignee writes a personal task</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="domain_force">[('nasq_personal', '=', True),
            '|', ('create_uid', '=', user.id), ('user_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('group_cap_tasks_tasks_write'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="perm_write" eval="True"/>
    </record>
</odoo>
