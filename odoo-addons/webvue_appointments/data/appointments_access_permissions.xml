<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="permission_appointments_records_read" model="webvue.access.permission">
        <field name="key">appointments.records.read</field><field name="domain">appointments</field>
        <field name="resource">records</field><field name="action">read</field>
        <field name="name_ar">قراءة سجلات المواعيد</field><field name="name_en">Read Appointments records</field>
        <field name="description_ar">قراءة سجلات المواعيد</field><field name="description_en">Read Appointments records</field>
        <field name="group_xmlid">webvue_appointments.group_cap_appointments_records_read</field>
        <field name="custom_role_allowed" eval="True"/><field name="sensitive" eval="False"/>
    </record>
    <record id="permission_appointments_records_manage" model="webvue.access.permission">
        <field name="key">appointments.records.manage</field><field name="domain">appointments</field>
        <field name="resource">records</field><field name="action">manage</field>
        <field name="name_ar">إدارة سجلات المواعيد</field><field name="name_en">Manage Appointments records</field>
        <field name="description_ar">إدارة سجلات المواعيد</field><field name="description_en">Manage Appointments records</field>
        <field name="group_xmlid">webvue_appointments.group_cap_appointments_records_manage</field>
        <field name="custom_role_allowed" eval="True"/><field name="sensitive" eval="True"/>
    </record>
    <data noupdate="1">
        <record id="role_appointments_manager" model="webvue.access.role">
            <field name="key">appointments_manager</field><field name="name_ar">مدير المواعيد</field><field name="name_en">Appointments manager</field>
            <field name="description">Appointments manager</field><field name="type">built_in</field><field name="protected" eval="True"/><field name="assignable" eval="True"/>
            <field name="permission_ids" eval="[Command.set([ref('permission_appointments_records_read'),ref('permission_appointments_records_manage')])]"/>
        </record>
    </data>
    <!-- Built-in roles are noupdate records: these hooks link this addon's grants and
         dependencies on install and on every upgrade. -->
    <function model="webvue.access.service" name="_webvue_configure_permission_dependencies"/>
    <function model="webvue.access.service" name="_webvue_repair_builtin_role_grants"/>
</odoo>
