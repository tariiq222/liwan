<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Each capability group holds its own ACL rows (ir.model.access.csv) and record rules
         (appointments_rules.xml) on the engine models; none implies the engine's group_user.
         manage -> book -> view mirrors the permission dependencies. Only manage implies the
         engine's group_manager, which keeps its modifications-deadline bypass for managers. -->
    <record id="group_cap_appointments_view" model="res.groups"><field name="name">Capability: view Appointments</field><field name="privilege_id" ref="webvue_core.res_groups_privilege_webvue"/></record>
    <record id="group_cap_appointments_book" model="res.groups">
        <field name="name">Capability: book Appointments</field><field name="privilege_id" ref="webvue_core.res_groups_privilege_webvue"/>
        <field name="implied_ids" eval="[Command.link(ref('group_cap_appointments_view'))]"/>
    </record>
    <record id="group_cap_appointments_manage" model="res.groups">
        <field name="name">Capability: manage Appointments</field><field name="privilege_id" ref="webvue_core.res_groups_privilege_webvue"/>
        <field name="implied_ids" eval="[Command.set([ref('group_cap_appointments_book'),ref('resource_booking.group_manager')])]"/>
    </record>

    <record id="group_appointments_manager" model="res.groups">
        <field name="name">Appointments Manager</field><field name="privilege_id" ref="webvue_core.res_groups_privilege_webvue"/>
        <field name="implied_ids" eval="[Command.set([ref('webvue_core.group_employee'),ref('group_cap_appointments_manage')])]"/>
    </record>

    <!-- webvue_core's support group reaches this application through this link. -->
    <record id="webvue_core.group_vendor_support" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_appointments_manager'))]"/>
    </record>

    <!-- System administration does not imply Appointments management: the engine adds
         base.user_admin to its manager group; only the superuser keeps it. -->
    <record id="resource_booking.group_manager" model="res.groups">
        <field name="user_ids" eval="[Command.unlink(ref('base.user_admin'))]"/>
    </record>
</odoo>
