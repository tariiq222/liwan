<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_cap_appointments_types_read" model="res.groups"><field name="name">Capability: read Appointments booking types</field><field name="privilege_id" ref="webvue_core.res_groups_privilege_webvue"/></record>
    <record id="group_cap_appointments_types_manage" model="res.groups"><field name="name">Capability: manage Appointments booking types</field><field name="privilege_id" ref="webvue_core.res_groups_privilege_webvue"/></record>

    <record id="group_appointments_manager" model="res.groups">
        <field name="name">Appointments Manager</field><field name="privilege_id" ref="webvue_core.res_groups_privilege_webvue"/>
        <field name="implied_ids" eval="[Command.set([ref('webvue_core.group_employee'),ref('group_cap_appointments_types_read'),ref('group_cap_appointments_types_manage')])]"/>
    </record>

    <!-- webvue_core's support group reaches this application through this link. -->
    <record id="webvue_core.group_vendor_support" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_appointments_manager'))]"/>
    </record>
</odoo>
