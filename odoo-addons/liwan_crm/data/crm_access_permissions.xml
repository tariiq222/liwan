<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="permission_crm_leads_read" model="liwan.access.permission">
        <field name="key">crm.leads.read</field><field name="domain">crm</field>
        <field name="resource">leads</field><field name="action">read</field>
        <field name="name_ar">قراءة الفرص</field><field name="name_en">Read opportunities</field>
        <field name="description_ar">قراءة الفرص</field><field name="description_en">Read opportunities</field>
        <field name="group_xmlid">liwan_crm.group_cap_crm_leads_read</field>
        <field name="custom_role_allowed" eval="True"/><field name="sensitive" eval="False"/>
    </record>
    <record id="permission_crm_leads_work" model="liwan.access.permission">
        <field name="key">crm.leads.work</field><field name="domain">crm</field>
        <field name="resource">leads</field><field name="action">work</field>
        <field name="name_ar">العمل على الفرص</field><field name="name_en">Work opportunities</field>
        <field name="description_ar">العمل على الفرص</field><field name="description_en">Work opportunities</field>
        <field name="group_xmlid">liwan_crm.group_cap_crm_leads_work</field>
        <field name="custom_role_allowed" eval="True"/><field name="sensitive" eval="False"/>
    </record>
    <record id="permission_crm_leads_assign" model="liwan.access.permission">
        <field name="key">crm.leads.assign</field><field name="domain">crm</field>
        <field name="resource">leads</field><field name="action">assign</field>
        <field name="name_ar">توزيع الفرص</field><field name="name_en">Assign opportunities</field>
        <field name="description_ar">توزيع الفرص</field><field name="description_en">Assign opportunities</field>
        <field name="group_xmlid">liwan_crm.group_cap_crm_leads_assign</field>
        <field name="custom_role_allowed" eval="True"/><field name="sensitive" eval="True"/>
    </record>
    <record id="permission_crm_leads_import" model="liwan.access.permission">
        <field name="key">crm.leads.import</field><field name="domain">crm</field>
        <field name="resource">leads</field><field name="action">import</field>
        <field name="name_ar">استيراد الفرص</field><field name="name_en">Import opportunities</field>
        <field name="description_ar">استيراد الفرص</field><field name="description_en">Import opportunities</field>
        <field name="group_xmlid">liwan_crm.group_cap_crm_leads_import</field>
        <field name="custom_role_allowed" eval="True"/><field name="sensitive" eval="True"/>
    </record>
    <record id="permission_crm_leads_export" model="liwan.access.permission">
        <field name="key">crm.leads.export</field><field name="domain">crm</field>
        <field name="resource">leads</field><field name="action">export</field>
        <field name="name_ar">تصدير الفرص</field><field name="name_en">Export opportunities</field>
        <field name="description_ar">تصدير الفرص</field><field name="description_en">Export opportunities</field>
        <field name="group_xmlid">liwan_crm.group_cap_crm_leads_export</field>
        <field name="custom_role_allowed" eval="True"/><field name="sensitive" eval="True"/>
    </record>
    <record id="permission_crm_discount_approve" model="liwan.access.permission">
        <field name="key">crm.discount.approve</field><field name="domain">crm</field>
        <field name="resource">discount</field><field name="action">approve</field>
        <field name="name_ar">اعتماد الخصم</field><field name="name_en">Approve discounts</field>
        <field name="description_ar">اعتماد الخصم</field><field name="description_en">Approve discounts</field>
        <field name="group_xmlid">liwan_crm.group_cap_crm_discount_approve</field>
        <field name="custom_role_allowed" eval="True"/><field name="sensitive" eval="True"/>
    </record>
    <record id="permission_crm_settings_read" model="liwan.access.permission">
        <field name="key">crm.settings.read</field><field name="domain">crm</field>
        <field name="resource">settings</field><field name="action">read</field>
        <field name="name_ar">قراءة إعدادات العملاء</field><field name="name_en">Read CRM settings</field>
        <field name="description_ar">قراءة إعدادات العملاء</field><field name="description_en">Read CRM settings</field>
        <field name="group_xmlid">liwan_crm.group_cap_crm_settings_read</field>
        <field name="custom_role_allowed" eval="True"/><field name="sensitive" eval="False"/>
    </record>
    <record id="permission_crm_settings_manage" model="liwan.access.permission">
        <field name="key">crm.settings.manage</field><field name="domain">crm</field>
        <field name="resource">settings</field><field name="action">manage</field>
        <field name="name_ar">إدارة إعدادات العملاء</field><field name="name_en">Manage CRM settings</field>
        <field name="description_ar">إدارة إعدادات العملاء</field><field name="description_en">Manage CRM settings</field>
        <field name="group_xmlid">liwan_crm.group_cap_crm_settings_manage</field>
        <field name="custom_role_allowed" eval="True"/><field name="sensitive" eval="True"/>
    </record>
    <record id="permission_crm_audit_read" model="liwan.access.permission">
        <field name="key">crm.audit.read</field><field name="domain">crm</field>
        <field name="resource">audit</field><field name="action">read</field>
        <field name="name_ar">قراءة سجل التدقيق</field><field name="name_en">Read the CRM audit log</field>
        <field name="description_ar">قراءة سجل التدقيق</field><field name="description_en">Read the CRM audit log</field>
        <field name="group_xmlid">liwan_crm.group_cap_crm_audit_read</field>
        <field name="custom_role_allowed" eval="True"/><field name="sensitive" eval="True"/>
    </record>
    <data noupdate="1">
        <record id="role_crm_agent" model="liwan.access.role">
            <field name="key">crm_agent</field><field name="name_ar">موظف العملاء</field><field name="name_en">CRM agent</field>
            <field name="description">CRM agent</field><field name="type">built_in</field><field name="protected" eval="True"/><field name="assignable" eval="True"/>
            <field name="permission_ids" eval="[Command.set([ref('permission_crm_leads_read'),ref('permission_crm_leads_work')])]"/>
        </record>
    </data>
    <data noupdate="1">
        <record id="role_crm_manager" model="liwan.access.role">
            <field name="key">crm_manager</field><field name="name_ar">مدير العملاء</field><field name="name_en">CRM manager</field>
            <field name="description">CRM manager</field><field name="type">built_in</field><field name="protected" eval="True"/><field name="assignable" eval="True"/>
            <field name="permission_ids" eval="[Command.set([ref('permission_crm_leads_read'),ref('permission_crm_leads_work'),ref('permission_crm_leads_assign'),ref('permission_crm_leads_import'),ref('permission_crm_leads_export'),ref('permission_crm_discount_approve'),ref('permission_crm_settings_read'),ref('permission_crm_settings_manage'),ref('permission_crm_audit_read')])]"/>
        </record>
    </data>
    <!-- Built-in roles are noupdate records: these hooks link this addon's grants and
         dependencies on install and on every upgrade. -->
    <function model="liwan.access.service" name="_liwan_configure_permission_dependencies"/>
    <function model="liwan.access.service" name="_liwan_repair_builtin_role_grants"/>
</odoo>
