<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_liwan_crm_settings_company" model="ir.rule">
        <field name="name">liwan CRM settings: current company</field>
        <field name="model_id" ref="model_liwan_crm_settings"/>
        <field name="domain_force">[('company_id', '=', company_id)]</field>
    </record>
    <record id="rule_liwan_crm_rotation_company" model="ir.rule">
        <field name="name">liwan CRM rotation: current company</field>
        <field name="model_id" ref="model_liwan_crm_rotation"/>
        <field name="domain_force">[('company_id', '=', company_id)]</field>
    </record>
</odoo>
