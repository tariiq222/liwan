<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="role_payroll_finance_manager" model="liwan.access.role">
            <field name="key">payroll_finance_manager</field><field name="name_ar">مدير مالي للرواتب</field><field name="name_en">Payroll finance manager</field>
            <field name="description">Payroll finance manager</field><field name="type">built_in</field><field name="protected" eval="True"/><field name="assignable" eval="True"/>
            <field name="permission_ids" eval="[Command.set([ref('liwan_hr.permission_hr_employees_read'),ref('liwan_hr.permission_hr_payroll_read'),ref('liwan_hr.permission_hr_payroll_finance_manage'),ref('liwan_finance.permission_finance_invoices_read'),ref('liwan_finance.permission_finance_entries_read'),ref('liwan_finance.permission_finance_entries_manage'),ref('liwan_finance.permission_finance_entries_post'),ref('liwan_finance.permission_finance_payments_read'),ref('liwan_finance.permission_finance_payments_manage')])]"/>
        </record>
    </data>
    <!-- Built-in roles are noupdate records: this hook links the bridge's grants on install and on every upgrade. -->
    <function model="liwan.access.service" name="_liwan_repair_builtin_role_grants"/>
</odoo>
