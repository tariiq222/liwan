<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_access_assignment_company" model="ir.rule">
        <field name="name">Access assignments in current companies</field>
        <field name="model_id" ref="model_webvue_access_assignment"/>
        <field name="domain_force">[('company_id', '=', company_id)]</field>
        <field name="groups" eval="[Command.link(ref('group_cap_access_users_read'))]"/>
    </record>
    <record id="rule_access_audit_company" model="ir.rule">
        <field name="name">Access audit in current companies</field>
        <field name="model_id" ref="model_webvue_access_audit"/>
        <field name="domain_force">[('company_id', '=', company_id)]</field>
        <field name="groups" eval="[Command.link(ref('group_cap_access_audit_read'))]"/>
    </record>
    <record id="rule_access_users_company" model="ir.rule">
        <field name="name">Access users in current companies</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="domain_force">[('company_id', '=', company_id)]</field>
        <field name="groups" eval="[Command.set([ref('group_cap_access_users_read')])]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_access_users_protected_write" model="ir.rule">
        <field name="name">Protected user operations after model scope validation</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.set([ref('base.group_user')])]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_access_partner_company" model="ir.rule">
        <field name="name">Account grant contacts in current companies</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', '=', company_id)]</field>
        <field name="groups" eval="[Command.set([ref('group_cap_access_users_grant'), ref('group_cap_settings_branding_manage'), ref('group_cap_settings_company_manage')])]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_access_company_current" model="ir.rule">
        <field name="name">Branding administration in current companies</field>
        <field name="model_id" ref="base.model_res_company"/>
        <field name="domain_force">[('id', '=', company_id)]</field>
        <field name="groups" eval="[Command.set([ref('group_cap_settings_branding_manage'), ref('group_cap_settings_company_manage')])]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_access_role_company" model="ir.rule">
        <field name="name">Built-in and current-company access roles</field>
        <field name="model_id" ref="model_webvue_access_role"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', '=', company_id)]</field>
        <field name="groups" eval="[Command.link(ref('group_cap_access_roles_read'))]"/>
    </record>
    <record id="rule_access_branch_company" model="ir.rule">
        <field name="name">Branch policies in current company</field>
        <field name="model_id" ref="model_webvue_access_branch_rule"/>
        <field name="domain_force">[('company_id', '=', company_id)]</field>
    </record>
    <record id="rule_access_company_branch_admin" model="ir.rule">
        <field name="name">Branch administration in current company</field>
        <field name="model_id" ref="base.model_res_company"/>
        <field name="domain_force">[('id', '=', company_id)]</field>
        <field name="groups" eval="[Command.link(ref('group_cap_access_users_assign_roles'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
