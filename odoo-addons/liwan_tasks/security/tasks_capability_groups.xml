<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_cap_tasks_tasks_read" model="res.groups"><field name="name">Capability: read personal tasks</field><field name="privilege_id" ref="liwan_core.res_groups_privilege_liwan"/></record>
    <record id="group_cap_tasks_tasks_create" model="res.groups"><field name="name">Capability: create personal tasks</field><field name="privilege_id" ref="liwan_core.res_groups_privilege_liwan"/></record>
    <record id="group_cap_tasks_tasks_write" model="res.groups"><field name="name">Capability: write personal tasks</field><field name="privilege_id" ref="liwan_core.res_groups_privilege_liwan"/></record>

    <!-- Stock project adds base.user_admin (the vendor support account) to its manager group; only the superuser keeps it. -->
    <record id="project.group_project_manager" model="res.groups">
        <field name="user_ids" eval="[Command.unlink(ref('base.user_admin'))]"/>
    </record>
</odoo>
