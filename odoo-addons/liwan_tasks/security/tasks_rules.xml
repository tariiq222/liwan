<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- A project-less task without company_id fails closed: nobody sees it, so every
         create path (the Task 3 service) must set company_id. -->
    <!-- A GLOBAL rule (no groups), on purpose. Odoo's task_visibility_rule lets a
         follower read a task and group rules are OR-ed, so only a global rule, which
         is AND-ed with them, keeps a follower who is neither creator nor assignee out
         of someone else's personal task. Project tasks pass through it untouched. -->
    <record id="rule_personal_task_visible" model="ir.rule">
        <field name="name">Tasks: personal tasks are private to creator and assignees</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="domain_force">['|', ('liwan_personal', '=', False),
            '&amp;', ('company_id', 'in', company_ids),
            '|', '|', ('create_uid', '=', user.id), ('user_ids', 'in', [user.id]),
            '|', ('liwan_parent_id.create_uid', '=', user.id), ('liwan_parent_id.user_ids', 'in', [user.id])]</field>
    </record>
    <!-- A personal sub-task belongs to the participants of its parent (creator and assignees),
         so both rules also accept them through liwan_parent_id. The field bypasses search
         access: the path is a plain join, otherwise the parent's own rules would nest
         without end. -->
    <!-- Odoo's own visibility rules do not know liwan_parent_id, and a global rule can only
         narrow. This group rule is the OR that lets a parent participant read the sub-task. -->
    <record id="rule_personal_subtask_parent_read" model="ir.rule">
        <field name="name">Tasks: the participants of a parent read its personal sub-tasks</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="domain_force">[('liwan_personal', '=', True),
            '|', ('liwan_parent_id.create_uid', '=', user.id), ('liwan_parent_id.user_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('group_cap_tasks_tasks_read'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <!-- Group rules are OR-ed with Odoo's own edition rule (assignees only), so a creator
         who is no longer an assignee can still write what they made, in every config.
         The global rule above keeps AND-ing: company and privacy are unchanged. -->
    <record id="rule_personal_task_creator_write" model="ir.rule">
        <field name="name">Tasks: the creator or an assignee writes a personal task</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="domain_force">[('liwan_personal', '=', True),
            '|', '|', ('create_uid', '=', user.id), ('user_ids', 'in', [user.id]),
            '|', ('liwan_parent_id.create_uid', '=', user.id), ('liwan_parent_id.user_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('group_cap_tasks_tasks_write'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="perm_write" eval="True"/>
    </record>
</odoo>
