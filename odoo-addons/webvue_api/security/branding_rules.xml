<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="webvue_api_branding_company_partner_rule" model="ir.rule">
            <field name="name">webvue branding: customer-admin company contacts</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">[('id', 'in', user.company_ids.partner_id.ids)]</field>
            <field name="groups" eval="[Command.link(ref('webvue_core.group_customer_admin'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
