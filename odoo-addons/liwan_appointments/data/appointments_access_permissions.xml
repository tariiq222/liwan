<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="permission_appointments_bookings_read" model="liwan.access.permission">
        <field name="key">appointments.bookings.read</field><field name="domain">appointments</field>
        <field name="resource">bookings</field><field name="action">read</field>
        <field name="name_ar">عرض المواعيد</field><field name="name_en">View Appointments</field>
        <field name="description_ar">عرض مواعيدي والمواعيد المسندة إليّ وأنواع المواعيد</field><field name="description_en">View own and assigned bookings and the booking types</field>
        <field name="group_xmlid">liwan_appointments.group_cap_appointments_bookings_read</field>
        <field name="custom_role_allowed" eval="True"/><field name="sensitive" eval="False"/>
    </record>
    <record id="permission_appointments_bookings_write" model="liwan.access.permission">
        <field name="key">appointments.bookings.write</field><field name="domain">appointments</field>
        <field name="resource">bookings</field><field name="action">write</field>
        <field name="name_ar">حجز المواعيد</field><field name="name_en">Book Appointments</field>
        <field name="description_ar">إنشاء المواعيد وجدولتها وتعديلها لأي شخص في الشركة</field><field name="description_en">Create, schedule and reschedule bookings for anyone in the company</field>
        <field name="group_xmlid">liwan_appointments.group_cap_appointments_bookings_write</field>
        <field name="custom_role_allowed" eval="True"/><field name="sensitive" eval="False"/>
    </record>
    <record id="permission_appointments_bookings_manage" model="liwan.access.permission">
        <field name="key">appointments.bookings.manage</field><field name="domain">appointments</field>
        <field name="resource">bookings</field><field name="action">manage</field>
        <field name="name_ar">إدارة المواعيد</field><field name="name_en">Manage Appointments</field>
        <field name="description_ar">إدارة أنواع المواعيد والمجموعات وكل المواعيد وحذفها</field><field name="description_en">Manage booking types, combinations and every booking, including deletion</field>
        <field name="group_xmlid">liwan_appointments.group_cap_appointments_bookings_manage</field>
        <field name="custom_role_allowed" eval="True"/><field name="sensitive" eval="True"/>
    </record>
    <data noupdate="1">
        <record id="role_appointments_manager" model="liwan.access.role">
            <field name="key">appointments_manager</field><field name="name_ar">مدير المواعيد</field><field name="name_en">Appointments manager</field>
            <field name="description">Appointments manager</field><field name="type">built_in</field><field name="protected" eval="True"/><field name="assignable" eval="True"/>
            <field name="permission_ids" eval="[Command.set([ref('permission_appointments_bookings_read'),ref('permission_appointments_bookings_write'),ref('permission_appointments_bookings_manage')])]"/>
        </record>
    </data>
    <!-- Built-in roles are noupdate records: these hooks link this addon's grants and
         dependencies on install and on every upgrade. -->
    <function model="liwan.access.service" name="_liwan_configure_permission_dependencies"/>
    <function model="liwan.access.service" name="_liwan_repair_builtin_role_grants"/>
</odoo>
