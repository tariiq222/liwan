<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Native company boundary. Publication/participation and owning-company
         privileges are checked by the Operations fresh authorization fence,
         outside Odoo's native rule cache, so revocation takes effect immediately. -->
    <record id="rule_liwan_operation_process" model="ir.rule">
        <field name="name">Operations company visibility: processes</field>
        <field name="model_id" ref="model_liwan_operation_process"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_liwan_operation_process_step" model="ir.rule">
        <field name="name">Operations company visibility: process stages</field>
        <field name="model_id" ref="model_liwan_operation_process_step"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_liwan_operation_request" model="ir.rule">
        <field name="name">Operations company visibility: requests</field>
        <field name="model_id" ref="model_liwan_operation_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_liwan_operation_event" model="ir.rule">
        <field name="name">Operations company visibility: audit events</field>
        <field name="model_id" ref="model_liwan_operation_event"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
