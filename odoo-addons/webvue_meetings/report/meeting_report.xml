<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="webvue_meeting_minutes_landscape" model="report.paperformat">
        <field name="name">webvue meeting minutes landscape</field>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">12</field>
        <field name="margin_bottom">12</field>
        <field name="margin_left">12</field>
        <field name="margin_right">12</field>
        <field name="header_line">False</field>
        <field name="dpi">90</field>
    </record>
    <record id="action_report_meeting_minutes" model="ir.actions.report">
        <field name="name">Meeting Minutes</field>
        <field name="model">webvue.meeting.minute</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">webvue_meetings.report_meeting_minutes</field>
        <field name="report_file">webvue_meetings.report_meeting_minutes</field>
        <field name="binding_model_id" ref="model_webvue_meeting_minute"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="webvue_meeting_minutes_landscape"/>
        <field name="print_report_name">'Meeting Minutes - %s' % (object.reference or '')</field>
    </record>
</odoo>
