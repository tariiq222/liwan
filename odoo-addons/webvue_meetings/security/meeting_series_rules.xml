<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_meeting_series_capability_scope" model="ir.rule">
        <field name="name">WebVue meeting series: capability and participation</field>
        <field name="model_id" ref="model_webvue_meeting_series"/>
        <field name="domain_force">user._webvue_meeting_series_access_domain(company_id)</field>
    </record>
    <record id="rule_meeting_event_current_company" model="ir.rule">
        <field name="name">WebVue meeting events: current company</field>
        <field name="model_id" ref="model_webvue_meeting_event"/>
        <field name="domain_force">user._webvue_meeting_access_domain(company_id, True)</field>
    </record>
    <record id="rule_meeting_minutes_version_current_company" model="ir.rule">
        <field name="name">WebVue meeting versions: current company</field>
        <field name="model_id" ref="model_webvue_meeting_minutes_version"/>
        <field name="domain_force">user._webvue_meeting_access_domain(company_id, True)</field>
    </record>
</odoo>
