<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_cap_meetings_read" model="res.groups"><field name="name">Capability: read meetings</field><field name="privilege_id" ref="webvue_core.res_groups_privilege_webvue"/></record>
    <record id="group_cap_meetings_create" model="res.groups"><field name="name">Capability: create meetings</field><field name="privilege_id" ref="webvue_core.res_groups_privilege_webvue"/></record>
    <record id="group_cap_meetings_manage" model="res.groups"><field name="name">Capability: manage meetings</field><field name="privilege_id" ref="webvue_core.res_groups_privilege_webvue"/></record>
    <record id="group_cap_meetings_settings_manage" model="res.groups"><field name="name">Capability: manage meetings settings</field><field name="privilege_id" ref="webvue_core.res_groups_privilege_webvue"/></record>

    <!-- webvue_core's groups reach meetings through these links. -->
    <record id="webvue_core.group_access_admin" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_cap_meetings_manage')), Command.link(ref('group_cap_meetings_settings_manage'))]"/>
    </record>
    <record id="webvue_core.group_vendor_support" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_cap_meetings_manage')), Command.link(ref('group_cap_meetings_settings_manage'))]"/>
    </record>
</odoo>
