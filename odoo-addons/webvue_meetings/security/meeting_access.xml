<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Global rules intersect Cyan's support-group rules for every ORM access path. -->
    <record id="rule_meeting_capability_scope" model="ir.rule">
        <field name="name">WebVue meetings: current company capability and participation</field>
        <field name="model_id" ref="cyan_meeting_minutes.model_cyan_meeting_minute"/>
        <field name="domain_force">user._webvue_meeting_access_domain(company_id)</field>
    </record>
    <record id="rule_resolution_capability_scope" model="ir.rule">
        <field name="name">WebVue resolutions: current company capability and participation</field>
        <field name="model_id" ref="cyan_meeting_minutes.model_cyan_meeting_resolution"/>
        <field name="domain_force">user._webvue_meeting_access_domain(company_id, resolution=True)</field>
    </record>
</odoo>
