<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="liwan_hr_people_partner_company_rule" model="ir.rule">
            <field name="name">liwan people: customer-admin company contacts</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">[
                '|',
                ('company_id', 'in', company_ids),
                '&amp;',
                ('company_id', '=', False),
                ('user_ids.company_ids', 'in', company_ids)
            ]</field>
            <field name="groups" eval="[Command.link(ref('liwan_core.group_customer_admin'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
