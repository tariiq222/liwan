<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_cap_hr_employees_read" model="res.groups"><field name="name">Capability: read employees</field><field name="privilege_id" ref="liwan_core.res_groups_privilege_liwan"/><field name="implied_ids" eval="[Command.clear()]"/></record>
    <!-- Odoo's private employee model protects inherited hr.version fields
         behind hr.group_hr_user. HR management capability grants that model
         field access; the model override still keeps account and archive
         mutations behind their dedicated actions. The contract fields are
         opened to this capability on the models themselves (hr_version.py,
         hr_employee.py), so the stock manager group, which bypasses company
         isolation on hr.version, is not implied. -->
    <record id="group_cap_hr_employees_manage" model="res.groups"><field name="name">Capability: manage employees</field><field name="privilege_id" ref="liwan_core.res_groups_privilege_liwan"/><field name="implied_ids" eval="[Command.link(ref('hr.group_hr_user'))]"/></record>
    <record id="group_cap_hr_employees_archive" model="res.groups"><field name="name">Capability: archive employees</field><field name="privilege_id" ref="liwan_core.res_groups_privilege_liwan"/><field name="implied_ids" eval="[Command.link(ref('hr.group_hr_user'))]"/></record>
    <record id="group_cap_hr_employees_access_status_read" model="res.groups"><field name="name">Capability: read employee access status</field><field name="privilege_id" ref="liwan_core.res_groups_privilege_liwan"/><field name="implied_ids" eval="[Command.link(ref('hr.group_hr_user'))]"/></record>
    <record id="group_cap_hr_departments_read" model="res.groups"><field name="name">Capability: read departments</field><field name="privilege_id" ref="liwan_core.res_groups_privilege_liwan"/></record>
    <record id="group_cap_hr_departments_manage" model="res.groups"><field name="name">Capability: manage departments</field><field name="privilege_id" ref="liwan_core.res_groups_privilege_liwan"/></record>
    <!-- Leave runs on stock hr_holidays. Reading and requesting stay on the stock
         employee rules (own records only). Approving and managing need the stock
         time-off officer group, which hr_holidays checks for every state change; that
         group is narrowed in hr_leave_officer_group.xml so it no longer implies
         hr.group_hr_user, and it never implies the time-off manager group or a
         payroll group. -->
    <record id="group_cap_hr_leave_read" model="res.groups"><field name="name">Capability: read leave</field><field name="privilege_id" ref="liwan_core.res_groups_privilege_liwan"/></record>
    <record id="group_cap_hr_leave_request" model="res.groups"><field name="name">Capability: request leave</field><field name="privilege_id" ref="liwan_core.res_groups_privilege_liwan"/></record>
    <record id="group_cap_hr_leave_approve" model="res.groups"><field name="name">Capability: approve leave</field><field name="privilege_id" ref="liwan_core.res_groups_privilege_liwan"/><field name="implied_ids" eval="[Command.link(ref('hr_holidays.group_hr_holidays_user'))]"/></record>
    <record id="group_cap_hr_leave_manage" model="res.groups"><field name="name">Capability: manage leave</field><field name="privilege_id" ref="liwan_core.res_groups_privilege_liwan"/><field name="implied_ids" eval="[Command.link(ref('hr_holidays.group_hr_holidays_user'))]"/></record>
    <record id="group_cap_hr_leave_config" model="res.groups"><field name="name">Capability: configure leave</field><field name="privilege_id" ref="liwan_core.res_groups_privilege_liwan"/></record>
    <!-- Recruitment, shifts, onboarding, offboarding and assets run on the stock
         hr_recruitment, OCA hr_employee_calendar_planning and stock hr_maintenance
         engines. Only the two manage groups that need the engine's own records link a
         stock group: hr_recruitment.group_hr_recruitment_user (which implies only
         interviewer → base.group_user) and maintenance.group_equipment_manager (which
         implies only base.group_user). No group here implies hr.group_hr_user,
         hr.group_hr_manager, the time-off officer group or a payroll group. The read
         groups hold their own read ACLs in ir.model.access.csv. -->
    <record id="group_cap_hr_recruitment_read" model="res.groups"><field name="name">Capability: read recruitment</field><field name="privilege_id" ref="liwan_core.res_groups_privilege_liwan"/></record>
    <record id="group_cap_hr_recruitment_manage" model="res.groups"><field name="name">Capability: manage recruitment</field><field name="privilege_id" ref="liwan_core.res_groups_privilege_liwan"/><field name="implied_ids" eval="[Command.link(ref('hr_recruitment.group_hr_recruitment_user'))]"/></record>
    <record id="group_cap_hr_shifts_read" model="res.groups"><field name="name">Capability: read shifts</field><field name="privilege_id" ref="liwan_core.res_groups_privilege_liwan"/></record>
    <!-- Shifts and offboarding writes are employee-record mutations: the capability
         itself depends on hr.employees.manage (access_service.py), whose group already
         implies hr.group_hr_user for the engine ACLs, so these two groups imply
         nothing of their own. -->
    <record id="group_cap_hr_shifts_manage" model="res.groups"><field name="name">Capability: manage shifts</field><field name="privilege_id" ref="liwan_core.res_groups_privilege_liwan"/></record>
    <record id="group_cap_hr_onboarding_read" model="res.groups"><field name="name">Capability: read onboarding</field><field name="privilege_id" ref="liwan_core.res_groups_privilege_liwan"/></record>
    <record id="group_cap_hr_onboarding_manage" model="res.groups"><field name="name">Capability: manage onboarding</field><field name="privilege_id" ref="liwan_core.res_groups_privilege_liwan"/></record>
    <record id="group_cap_hr_offboarding_read" model="res.groups"><field name="name">Capability: read offboarding</field><field name="privilege_id" ref="liwan_core.res_groups_privilege_liwan"/></record>
    <record id="group_cap_hr_offboarding_manage" model="res.groups"><field name="name">Capability: manage offboarding</field><field name="privilege_id" ref="liwan_core.res_groups_privilege_liwan"/></record>
    <record id="group_cap_hr_assets_read" model="res.groups"><field name="name">Capability: read assets</field><field name="privilege_id" ref="liwan_core.res_groups_privilege_liwan"/></record>
    <record id="group_cap_hr_assets_manage" model="res.groups"><field name="name">Capability: manage assets</field><field name="privilege_id" ref="liwan_core.res_groups_privilege_liwan"/><field name="implied_ids" eval="[Command.link(ref('maintenance.group_equipment_manager'))]"/></record>
    <!-- Administrative warnings are disciplinary records: no stock HR group comes with them, and the read group
         holds its own ACL rows in ir.model.access.csv. -->
    <record id="group_cap_hr_warnings_read" model="res.groups"><field name="name">Capability: read warnings</field><field name="privilege_id" ref="liwan_core.res_groups_privilege_liwan"/><field name="implied_ids" eval="[Command.clear()]"/></record>
    <record id="group_cap_hr_warnings_manage" model="res.groups"><field name="name">Capability: manage warnings</field><field name="privilege_id" ref="liwan_core.res_groups_privilege_liwan"/><field name="implied_ids" eval="[Command.clear()]"/></record>
    <!-- Payroll capabilities imply nothing: no stock HR or OCA payroll group, and group_hr_manager does not imply them. -->
    <record id="group_cap_hr_payroll_read" model="res.groups"><field name="name">Capability: read payroll</field><field name="privilege_id" ref="liwan_core.res_groups_privilege_liwan"/><field name="implied_ids" eval="[Command.clear()]"/></record>
    <record id="group_cap_hr_payroll_manage" model="res.groups"><field name="name">Capability: manage payroll</field><field name="privilege_id" ref="liwan_core.res_groups_privilege_liwan"/><field name="implied_ids" eval="[Command.clear()]"/></record>
    <record id="group_cap_hr_payroll_approve" model="res.groups"><field name="name">Capability: approve payroll runs</field><field name="privilege_id" ref="liwan_core.res_groups_privilege_liwan"/><field name="implied_ids" eval="[Command.clear()]"/></record>
    <record id="group_cap_hr_payroll_config" model="res.groups"><field name="name">Capability: configure payroll</field><field name="privilege_id" ref="liwan_core.res_groups_privilege_liwan"/><field name="implied_ids" eval="[Command.clear()]"/></record>
    <record id="group_cap_hr_payroll_audit_read" model="res.groups"><field name="name">Capability: read the payroll audit trail</field><field name="privilege_id" ref="liwan_core.res_groups_privilege_liwan"/><field name="implied_ids" eval="[Command.clear()]"/></record>
    <record id="group_cap_hr_payroll_finance_manage" model="res.groups"><field name="name">Capability: configure payroll finance settings</field><field name="privilege_id" ref="liwan_core.res_groups_privilege_liwan"/><field name="implied_ids" eval="[Command.clear()]"/></record>

    <record id="group_hr_manager" model="res.groups">
        <field name="name">HR Manager</field><field name="privilege_id" ref="liwan_core.res_groups_privilege_liwan"/>
        <field name="implied_ids" eval="[Command.set([ref('liwan_core.group_employee'),ref('group_cap_hr_employees_read'),ref('group_cap_hr_employees_manage'),ref('group_cap_hr_employees_archive'),ref('group_cap_hr_employees_access_status_read'),ref('group_cap_hr_departments_read'),ref('group_cap_hr_departments_manage'),ref('group_cap_hr_leave_read'),ref('group_cap_hr_leave_request'),ref('group_cap_hr_leave_approve'),ref('group_cap_hr_leave_manage'),ref('group_cap_hr_recruitment_read'),ref('group_cap_hr_recruitment_manage'),ref('group_cap_hr_shifts_read'),ref('group_cap_hr_shifts_manage'),ref('group_cap_hr_onboarding_read'),ref('group_cap_hr_onboarding_manage'),ref('group_cap_hr_offboarding_read'),ref('group_cap_hr_offboarding_manage'),ref('group_cap_hr_assets_read'),ref('group_cap_hr_assets_manage'),ref('group_cap_hr_warnings_read'),ref('group_cap_hr_warnings_manage')])]"/>
    </record>

    <!-- liwan_core's support group and user-directory rule reach HR through these links. -->
    <record id="liwan_core.group_vendor_support" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_hr_manager')),Command.link(ref('group_cap_hr_leave_config'))]"/>
    </record>
    <record id="liwan_core.rule_access_users_company" model="ir.rule">
        <field name="groups" eval="[Command.link(ref('group_cap_hr_employees_archive'))]"/>
    </record>
</odoo>
