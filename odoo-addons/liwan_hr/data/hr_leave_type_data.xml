<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The Saudi leave types are stock hr_holidays data (l10n_sa_leave_type_*); LiwanOS
         uses them as they are and only corrects two defects of that data:

         1. hr_holidays writes requires_allocation as the text "no", which a Boolean
            field reads as True, so event leaves (unpaid sick, marriage, maternity,
            iddah, hajj, paternity, study, emergency) wrongly demand a balance.
         2. hr_work_entry_holidays gives five of them no work entry type, and a leave
            type without one cannot be paid by the payroll engine.

         Annual leave is the stock global "Paid Time Off". -->
    <data noupdate="1">
        <record id="hr_holidays.l10n_sa_leave_type_sick_leave_0" model="hr.leave.type" forcecreate="0">
            <field name="requires_allocation" eval="False"/>
        </record>
        <record id="hr_holidays.l10n_sa_leave_type_maternity" model="hr.leave.type" forcecreate="0">
            <field name="requires_allocation" eval="False"/>
        </record>
        <record id="hr_holidays.l10n_sa_leave_type_emergency" model="hr.leave.type" forcecreate="0">
            <field name="requires_allocation" eval="False"/>
        </record>
        <record id="hr_holidays.l10n_sa_leave_type_marriage" model="hr.leave.type" forcecreate="0">
            <field name="requires_allocation" eval="False"/>
            <field name="work_entry_type_id" ref="hr_work_entry.work_entry_type_leave"/>
        </record>
        <record id="hr_holidays.l10n_sa_leave_type_iddah" model="hr.leave.type" forcecreate="0">
            <field name="requires_allocation" eval="False"/>
            <field name="work_entry_type_id" ref="hr_work_entry.work_entry_type_leave"/>
        </record>
        <record id="hr_holidays.l10n_sa_leave_type_hajj" model="hr.leave.type" forcecreate="0">
            <field name="requires_allocation" eval="False"/>
            <field name="work_entry_type_id" ref="hr_work_entry.work_entry_type_leave"/>
        </record>
        <record id="hr_holidays.l10n_sa_leave_type_paternity" model="hr.leave.type" forcecreate="0">
            <field name="requires_allocation" eval="False"/>
            <field name="work_entry_type_id" ref="hr_work_entry.work_entry_type_leave"/>
        </record>
        <record id="hr_holidays.l10n_sa_leave_type_study" model="hr.leave.type" forcecreate="0">
            <field name="requires_allocation" eval="False"/>
            <field name="work_entry_type_id" ref="hr_work_entry.work_entry_type_leave"/>
        </record>
    </data>
</odoo>
