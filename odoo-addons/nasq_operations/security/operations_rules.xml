<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="rule_nasq_operation_process" model="ir.rule"><field name="name">Operations current-company visibility: nasq_operation_process</field><field name="model_id" ref="model_nasq_operation_process"/><field name="domain_force">[('company_id', '=', company_id)] + ([] if user._operations_can_manage(company_id) else [('state', '=', 'published')])</field></record>
<record id="rule_nasq_operation_process_step" model="ir.rule"><field name="name">Operations current-company visibility: nasq_operation_process_step</field><field name="model_id" ref="model_nasq_operation_process_step"/><field name="domain_force">[('company_id', '=', company_id)] + ([] if user._operations_can_manage(company_id) else [('process_id.state', '=', 'published')])</field></record>
<record id="rule_nasq_operation_request" model="ir.rule"><field name="name">Operations current-company visibility: nasq_operation_request</field><field name="model_id" ref="model_nasq_operation_request"/><field name="domain_force">[('company_id', '=', company_id)] + ([] if user._operations_can_monitor(company_id) else ['|', ('requester_id', '=', user.id), ('participant_ids', 'in', [user.id])])</field></record>
<record id="rule_nasq_operation_event" model="ir.rule"><field name="name">Operations current-company visibility: nasq_operation_event</field><field name="model_id" ref="model_nasq_operation_event"/><field name="domain_force">[('company_id', '=', company_id)] + ([] if user._operations_can_monitor(company_id) else ['|', ('request_id.requester_id', '=', user.id), ('request_id.participant_ids', 'in', [user.id])])</field></record>
</odoo>
