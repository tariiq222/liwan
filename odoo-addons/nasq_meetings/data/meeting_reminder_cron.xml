<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_nasq_meeting_reminders" model="ir.cron">
        <field name="name">nasq: meeting reminders</field>
        <field name="model_id" ref="cyan_meeting_minutes.model_cyan_meeting_minute"/>
        <field name="state">code</field>
        <field name="code">model._nasq_run_meeting_reminders()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
