<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="privilege_meeting_minutes" model="res.groups.privilege">
            <field name="name">Meeting Minutes</field>
            <field name="sequence">35</field>
            <field name="category_id" ref="base.module_category_productivity"/>
        </record>
        <record id="group_meeting_user" model="res.groups">
            <field name="name">User</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="privilege_meeting_minutes"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="group_meeting_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="privilege_meeting_minutes"/>
            <field name="implied_ids" eval="[(4, ref('group_meeting_user'))]"/>
        </record>
        <record id="rule_meeting_company" model="ir.rule">
            <field name="name">Meeting Minutes: current company isolation</field>
            <field name="model_id" ref="model_cyan_meeting_minute"/>
            <field name="domain_force">[('company_id', '=', company_id)]</field>
        </record>
        <record id="rule_resolution_company" model="ir.rule">
            <field name="name">Meeting Resolutions: current company isolation</field>
            <field name="model_id" ref="model_cyan_meeting_resolution"/>
            <field name="domain_force">[('company_id', '=', company_id)]</field>
        </record>
    </data>
    <data noupdate="1">
        <record id="rule_meeting_user_read" model="ir.rule">
            <field name="name">Meeting Minutes: users read participants</field>
            <field name="model_id" ref="model_cyan_meeting_minute"/>
            <field name="groups" eval="[(4, ref('group_meeting_user'))]"/>
            <field name="domain_force">['|', '|', ('organizer_id', '=', user.id), ('secretary_id', '=', user.id), ('attendee_ids', 'in', [user.id])]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_meeting_user_write" model="ir.rule">
            <field name="name">Meeting Minutes: organizers and secretaries write</field>
            <field name="model_id" ref="model_cyan_meeting_minute"/>
            <field name="groups" eval="[(4, ref('group_meeting_user'))]"/>
            <field name="domain_force">['|', ('organizer_id', '=', user.id), ('secretary_id', '=', user.id)]</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_meeting_manager_all" model="ir.rule">
            <field name="name">Meeting Minutes: managers company records</field>
            <field name="model_id" ref="model_cyan_meeting_minute"/>
            <field name="groups" eval="[(4, ref('group_meeting_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        <record id="rule_resolution_user_read" model="ir.rule">
            <field name="name">Meeting Resolutions: users read participant meetings</field>
            <field name="model_id" ref="model_cyan_meeting_resolution"/>
            <field name="groups" eval="[(4, ref('group_meeting_user'))]"/>
            <field name="domain_force">['|', '|', ('meeting_id.organizer_id', '=', user.id), ('meeting_id.secretary_id', '=', user.id), ('meeting_id.attendee_ids', 'in', [user.id])]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_resolution_user_write" model="ir.rule">
            <field name="name">Meeting Resolutions: editors and assignees write</field>
            <field name="model_id" ref="model_cyan_meeting_resolution"/>
            <field name="groups" eval="[(4, ref('group_meeting_user'))]"/>
            <field name="domain_force">['|', '|', ('meeting_id.organizer_id', '=', user.id), ('meeting_id.secretary_id', '=', user.id), ('responsible_id', '=', user.id)]</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_resolution_manager_all" model="ir.rule">
            <field name="name">Meeting Resolutions: managers company records</field>
            <field name="model_id" ref="model_cyan_meeting_resolution"/>
            <field name="groups" eval="[(4, ref('group_meeting_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
    </data>
</odoo>
