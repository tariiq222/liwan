<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_ai_audit_own" model="ir.rule">
        <field name="name">AI audit: own rows, plus content-free message rows, in current companies</field>
        <field name="model_id" ref="model_nasq_ai_audit"/>
        <field name="domain_force">[('company_id', 'in', company_ids), '|', ('user_id', '=', user.id), ('kind', '=', 'message')]</field>
        <field name="groups" eval="[Command.link(ref('nasq_core.group_employee'))]"/>
    </record>
    <record id="rule_ai_audit_company" model="ir.rule">
        <field name="name">AI audit: company rows for audit readers</field>
        <field name="model_id" ref="model_nasq_ai_audit"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('nasq_core.group_cap_access_audit_read')), Command.link(ref('base.group_system'))]"/>
    </record>
</odoo>
