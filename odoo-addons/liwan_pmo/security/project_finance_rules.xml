<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extra floor only: the real read/write gate is
         liwan.project.finance.entry's own _search/_check_access/create/write/
         unlink overrides (capability + live project visibility + manage
         check). The entry follows its project's company, so this rule accepts
         every company of the request's pinned subtree (current company + its
         own branches) and still excludes a company-less row: a finance entry
         can never resolve outside the pinned companies, company-less
         included, even if the Python floor above is bypassed. -->
    <record id="rule_project_finance_entry_current_company" model="ir.rule">
        <field name="name">LiwanOS finance entries in the pinned company subtree</field>
        <field name="model_id" ref="model_liwan_project_finance_entry"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
