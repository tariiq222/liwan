<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- company_ids is the request's pinned set (current company + its own
         branches) from liwan_api's _pin_current_company, so a parent session
         reads its subtree and a branch session reads only itself. A
         company-less row matches no id in the set and stays hidden. -->
    <record id="rule_project_current_company" model="ir.rule">
        <field name="name">LiwanOS projects in the pinned company subtree</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_task_current_company" model="ir.rule">
        <field name="name">LiwanOS tasks in the pinned company subtree</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
