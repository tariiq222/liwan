<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_liwan_project_stakeholder_visible" model="ir.rule">
        <field name="name">Governance stakeholders follow project access</field>
        <field name="model_id" ref="model_liwan_project_stakeholder"/>
        <field name="domain_force">[('project_id', 'any', [('active', '=', True), ('company_id', 'in', company_ids)])]</field>
    </record>
    <record id="rule_liwan_project_raci_visible" model="ir.rule">
        <field name="name">Governance RACI follows project and task access</field>
        <field name="model_id" ref="model_liwan_project_raci"/>
        <field name="domain_force">[
            ('project_id', 'any', [('active', '=', True), ('company_id', 'in', company_ids)]),
            ('task_id', 'any', [('active', '=', True)])
        ]</field>
    </record>
    <record id="rule_liwan_project_register_visible" model="ir.rule">
        <field name="name">Governance register follows project and optional task access</field>
        <field name="model_id" ref="model_liwan_project_register"/>
        <field name="domain_force">[
            ('project_id', 'any', [('active', '=', True), ('company_id', 'in', company_ids)]),
            '|', ('task_id', '=', False), ('task_id', 'any', [('active', '=', True)])
        ]</field>
    </record>
    <record id="rule_liwan_project_change_visible" model="ir.rule">
        <field name="name">Change requests follow project access</field>
        <field name="model_id" ref="model_liwan_project_change"/>
        <field name="domain_force">[('project_id', 'any', [('active', '=', True), ('company_id', 'in', company_ids)])]</field>
    </record>
    <record id="rule_liwan_project_baseline_visible" model="ir.rule">
        <field name="name">Baselines follow project access</field>
        <field name="model_id" ref="model_liwan_project_baseline"/>
        <field name="domain_force">[('project_id', 'any', [('active', '=', True), ('company_id', 'in', company_ids)])]</field>
    </record>
    <record id="rule_liwan_project_baseline_task_visible" model="ir.rule">
        <field name="name">Baseline task lines follow project access</field>
        <field name="model_id" ref="model_liwan_project_baseline_task"/>
        <field name="domain_force">[('project_id', 'any', [('active', '=', True), ('company_id', 'in', company_ids)])]</field>
    </record>
</odoo>
