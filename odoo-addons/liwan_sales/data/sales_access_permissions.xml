<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="permission_sales_read" model="liwan.access.permission">
        <field name="key">sales.read</field><field name="domain">sales</field>
        <field name="resource">orders</field><field name="action">read</field>
        <field name="name_ar">قراءة عروض الأسعار والطلبات</field><field name="name_en">Read quotations and orders</field>
        <field name="description_ar">قراءة عروض الأسعار والطلبات</field><field name="description_en">Read quotations and orders</field>
        <field name="group_xmlid">liwan_sales.group_cap_sales_read</field>
        <field name="custom_role_allowed" eval="True"/><field name="sensitive" eval="False"/>
    </record>
    <record id="permission_sales_quotations_manage" model="liwan.access.permission">
        <field name="key">sales.quotations.manage</field><field name="domain">sales</field>
        <field name="resource">quotations</field><field name="action">manage</field>
        <field name="name_ar">إدارة عروض الأسعار</field><field name="name_en">Manage quotations</field>
        <field name="description_ar">إدارة عروض الأسعار</field><field name="description_en">Manage quotations</field>
        <field name="group_xmlid">liwan_sales.group_cap_sales_quotations_manage</field>
        <field name="custom_role_allowed" eval="True"/><field name="sensitive" eval="False"/>
    </record>
    <record id="permission_sales_orders_confirm" model="liwan.access.permission">
        <field name="key">sales.orders.confirm</field><field name="domain">sales</field>
        <field name="resource">orders</field><field name="action">confirm</field>
        <field name="name_ar">اعتماد الطلبات</field><field name="name_en">Confirm orders</field>
        <field name="description_ar">اعتماد الطلبات</field><field name="description_en">Confirm orders</field>
        <field name="group_xmlid">liwan_sales.group_cap_sales_orders_confirm</field>
        <field name="custom_role_allowed" eval="True"/><field name="sensitive" eval="True"/>
    </record>
    <record id="permission_sales_discounts_approve" model="liwan.access.permission">
        <field name="key">sales.discounts.approve</field><field name="domain">sales</field>
        <field name="resource">discounts</field><field name="action">approve</field>
        <field name="name_ar">اعتماد الخصم</field><field name="name_en">Approve discounts</field>
        <field name="description_ar">اعتماد الخصم</field><field name="description_en">Approve discounts</field>
        <field name="group_xmlid">liwan_sales.group_cap_sales_discounts_approve</field>
        <field name="custom_role_allowed" eval="True"/><field name="sensitive" eval="True"/>
    </record>
    <record id="permission_sales_documents_assign" model="liwan.access.permission">
        <field name="key">sales.documents.assign</field><field name="domain">sales</field>
        <field name="resource">documents</field><field name="action">assign</field>
        <field name="name_ar">توزيع مستندات المبيعات</field><field name="name_en">Assign sales documents</field>
        <field name="description_ar">توزيع مستندات المبيعات</field><field name="description_en">Assign sales documents</field>
        <field name="group_xmlid">liwan_sales.group_cap_sales_documents_assign</field>
        <field name="custom_role_allowed" eval="True"/><field name="sensitive" eval="True"/>
    </record>
    <record id="permission_sales_settings_manage" model="liwan.access.permission">
        <field name="key">sales.settings.manage</field><field name="domain">sales</field>
        <field name="resource">settings</field><field name="action">manage</field>
        <field name="name_ar">إدارة إعدادات المبيعات</field><field name="name_en">Manage Sales settings</field>
        <field name="description_ar">إدارة إعدادات المبيعات</field><field name="description_en">Manage Sales settings</field>
        <field name="group_xmlid">liwan_sales.group_cap_sales_settings_manage</field>
        <field name="custom_role_allowed" eval="True"/><field name="sensitive" eval="True"/>
    </record>
    <data noupdate="1">
        <record id="role_sales_agent" model="liwan.access.role">
            <field name="key">sales_agent</field><field name="name_ar">موظف المبيعات</field><field name="name_en">Sales agent</field>
            <field name="description">Sales agent</field><field name="type">built_in</field><field name="protected" eval="True"/><field name="assignable" eval="True"/>
            <field name="permission_ids" eval="[Command.set([ref('permission_sales_read'),ref('permission_sales_quotations_manage'),ref('permission_sales_orders_confirm')])]"/>
        </record>
        <record id="role_sales_manager" model="liwan.access.role">
            <field name="key">sales_manager</field><field name="name_ar">مدير المبيعات</field><field name="name_en">Sales manager</field>
            <field name="description">Sales manager</field><field name="type">built_in</field><field name="protected" eval="True"/><field name="assignable" eval="True"/>
            <field name="permission_ids" eval="[Command.set([ref('permission_sales_read'),ref('permission_sales_quotations_manage'),ref('permission_sales_orders_confirm'),ref('permission_sales_discounts_approve'),ref('permission_sales_documents_assign'),ref('permission_sales_settings_manage')])]"/>
        </record>
    </data>
    <!-- Built-in roles are noupdate records: these hooks link this addon's grants and
         dependencies on install and on every upgrade. -->
    <function model="liwan.access.service" name="_liwan_configure_permission_dependencies"/>
    <function model="liwan.access.service" name="_liwan_repair_builtin_role_grants"/>
</odoo>
