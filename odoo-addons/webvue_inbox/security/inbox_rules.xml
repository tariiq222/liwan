    <!-- Channels and events: group rules, so the webhook identity (no company membership beyond its
         home company, no capability) is not bound by the staff company rule. The hook rule is
         unrestricted by record, so a webhook reaches the channels of every company; what the hook may
         do is fixed by its ACL rows (read channel, create event). Both models name their company field
         owner_company_id, which keeps them out of webvue_core's per-request company fence. -->
    <record id="webvue_inbox_channel_company_rule" model="ir.rule">
        <field name="name">webvue.inbox.channel: multi-company</field>
        <field name="model_id" ref="model_webvue_inbox_channel"/>
        <field name="domain_force">[('owner_company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('group_cap_inbox_conversations_read')), Command.link(ref('group_cap_inbox_channels_manage')), Command.link(ref('group_cap_inbox_templates_manage')), Command.link(ref('group_cap_inbox_automation_manage')), Command.link(ref('group_cap_inbox_flows_manage'))]"/>
    </record>
    <record id="webvue_inbox_channel_hook_rule" model="ir.rule">
        <field name="name">webvue.inbox.channel: webhook identity</field>
        <field name="model_id" ref="model_webvue_inbox_channel"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_inbox_hook'))]"/>
    </record>
    <record id="webvue_inbox_event_company_rule" model="ir.rule">
        <field name="name">webvue.inbox.event: multi-company</field>
        <field name="model_id" ref="model_webvue_inbox_event"/>
        <field name="domain_force">[('owner_company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('group_cap_inbox_channels_manage'))]"/>
    </record>
    <record id="webvue_inbox_event_hook_rule" model="ir.rule">
        <field name="name">webvue.inbox.event: webhook identity</field>
        <field name="model_id" ref="model_webvue_inbox_event"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_inbox_hook'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
