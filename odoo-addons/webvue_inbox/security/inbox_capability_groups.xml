<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_cap_inbox_conversations_read" model="res.groups"><field name="name">Capability: read Customer Inbox conversations</field><field name="privilege_id" ref="webvue_core.res_groups_privilege_webvue"/></record>
    <record id="group_cap_inbox_conversations_reply" model="res.groups"><field name="name">Capability: reply Customer Inbox conversations</field><field name="privilege_id" ref="webvue_core.res_groups_privilege_webvue"/></record>
    <record id="group_cap_inbox_conversations_assign" model="res.groups"><field name="name">Capability: assign Customer Inbox conversations</field><field name="privilege_id" ref="webvue_core.res_groups_privilege_webvue"/></record>
    <record id="group_cap_inbox_conversations_export" model="res.groups"><field name="name">Capability: export Customer Inbox conversations</field><field name="privilege_id" ref="webvue_core.res_groups_privilege_webvue"/></record>
    <record id="group_cap_inbox_channels_manage" model="res.groups"><field name="name">Capability: manage Customer Inbox channels</field><field name="privilege_id" ref="webvue_core.res_groups_privilege_webvue"/></record>
    <record id="group_cap_inbox_templates_manage" model="res.groups"><field name="name">Capability: manage Customer Inbox message templates</field><field name="privilege_id" ref="webvue_core.res_groups_privilege_webvue"/></record>
    <record id="group_cap_inbox_automation_manage" model="res.groups"><field name="name">Capability: manage Customer Inbox automation</field><field name="privilege_id" ref="webvue_core.res_groups_privilege_webvue"/></record>
    <record id="group_cap_inbox_flows_manage" model="res.groups"><field name="name">Capability: manage Customer Inbox WhatsApp forms</field><field name="privilege_id" ref="webvue_core.res_groups_privilege_webvue"/></record>
    <record id="group_cap_inbox_settings_manage" model="res.groups"><field name="name">Capability: manage Customer Inbox settings</field><field name="privilege_id" ref="webvue_core.res_groups_privilege_webvue"/></record>

    <record id="group_inbox_manager" model="res.groups">
        <field name="name">Customer Inbox Manager</field><field name="privilege_id" ref="webvue_core.res_groups_privilege_webvue"/>
        <field name="implied_ids" eval="[Command.set([ref('webvue_core.group_employee')] + [ref(key) for key in (
            'group_cap_inbox_conversations_read', 'group_cap_inbox_conversations_reply',
            'group_cap_inbox_conversations_assign', 'group_cap_inbox_conversations_export',
            'group_cap_inbox_channels_manage', 'group_cap_inbox_templates_manage', 'group_cap_inbox_settings_manage',
            'group_cap_inbox_automation_manage', 'group_cap_inbox_flows_manage')])]"/>
    </record>

    <!-- The machine identity of the WhatsApp webhook (data/inbox_hook_user.xml). It reads channels
         (with their secrets) and creates raw events, nothing else; see security/ir.model.access.csv. -->
    <record id="group_inbox_hook" model="res.groups"><field name="name">Customer Inbox webhook</field></record>

    <!-- webvue_core's support group reaches this application through this link. -->
    <record id="webvue_core.group_vendor_support" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_inbox_manager'))]"/>
    </record>
</odoo>
