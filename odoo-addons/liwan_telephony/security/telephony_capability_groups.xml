<?xml version="1.0" encoding="utf-8"?>
<!-- The four capabilities of design section 6. Listening to a recording is its own capability and is implied by no
     other one, so an ordinary employee cannot listen to a colleague's call. -->
<odoo>
    <!-- The own-calls rule applies to this group only: `telephony.use` implies it, and `telephony.calls.read_all`
         is left out of it, so a manager who reads the whole company log is not narrowed to their own calls. -->
    <record id="group_telephony_own_calls" model="res.groups">
        <field name="name">Telephony own calls</field>
    </record>

    <record id="group_cap_telephony_use" model="res.groups">
        <field name="name">Capability: use the phone</field>
        <field name="privilege_id" ref="liwan_core.res_groups_privilege_liwan"/>
        <field name="implied_ids" eval="[Command.set([ref('group_telephony_own_calls')])]"/>
    </record>
    <record id="group_cap_telephony_calls_read_all" model="res.groups">
        <field name="name">Capability: read the company call log</field>
        <field name="privilege_id" ref="liwan_core.res_groups_privilege_liwan"/>
    </record>
    <record id="group_cap_telephony_recordings_listen" model="res.groups">
        <field name="name">Capability: listen to call recordings</field>
        <field name="privilege_id" ref="liwan_core.res_groups_privilege_liwan"/>
    </record>
    <record id="group_cap_telephony_manage" model="res.groups">
        <field name="name">Capability: manage telephony</field>
        <field name="privilege_id" ref="liwan_core.res_groups_privilege_liwan"/>
    </record>

    <!-- The machine route's own group: write the call and the event receipt and read what an event needs to place
         them, nothing else. It is not assignable to a person; only the events identity holds the capability that
         projects onto it (telephony.events.apply), and no role carries that capability. -->
    <record id="group_telephony_events" model="res.groups">
        <field name="name">Telephony events (machine)</field>
        <field name="privilege_id" ref="liwan_core.res_groups_privilege_liwan"/>
    </record>

    <record id="group_telephony_manager" model="res.groups">
        <field name="name">Telephony Manager</field>
        <field name="privilege_id" ref="liwan_core.res_groups_privilege_liwan"/>
        <field name="implied_ids" eval="[Command.set([ref('liwan_core.group_employee'),ref('group_cap_telephony_use'),ref('group_cap_telephony_calls_read_all'),ref('group_cap_telephony_recordings_listen'),ref('group_cap_telephony_manage')])]"/>
    </record>
</odoo>
