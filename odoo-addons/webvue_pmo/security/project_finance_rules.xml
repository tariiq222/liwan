<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extra floor only: the real read/write gate is
         webvue.project.finance.entry's own _search/_check_access/create/write/
         unlink overrides (capability + live project visibility + manage
         check). Unlike webvue_pmo_rules.xml's project/task company rules
         (which allow a company-less `False` row through), finance is
         explicitly out of scope for legacy company-less projects, so this
         rule requires a strict match - a finance entry can never resolve
         outside the caller's current company, company-less included, even
         if the Python floor above is bypassed. -->
    <record id="rule_project_finance_entry_current_company" model="ir.rule">
        <field name="name">WebVue finance entries in current company</field>
        <field name="model_id" ref="model_webvue_project_finance_entry"/>
        <field name="domain_force">[('company_id', '=', company_id)]</field>
    </record>
</odoo>
