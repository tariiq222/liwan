<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_liwan_login_code_purge" model="ir.cron">
        <field name="name">liwan: purge sign-in codes and devices</field>
        <field name="model_id" ref="model_liwan_login_code"/>
        <field name="state">code</field>
        <field name="code">model._liwan_purge(); env['liwan.login.device']._liwan_purge()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
