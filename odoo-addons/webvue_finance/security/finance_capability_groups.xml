<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Stock account ACLs and multi-company record rules do the reading; the routes gate on the capability.
         Every capability group implies account.group_account_readonly on purpose: the routes read in the caller's
         own environment (no sudo allowed), so the caller needs ORM read rights, and any one capability therefore
         grants ORM read of all accounting data. The per-capability gate is the route, pinned by
         tests/test_finance_capability_isolation.py. -->
    <record id="group_cap_finance_invoices_read" model="res.groups"><field name="name">Capability: read finance invoices</field><field name="privilege_id" ref="webvue_core.res_groups_privilege_webvue"/><field name="implied_ids" eval="[Command.link(ref('account.group_account_readonly'))]"/></record>
    <record id="group_cap_finance_payments_read" model="res.groups"><field name="name">Capability: read finance payments</field><field name="privilege_id" ref="webvue_core.res_groups_privilege_webvue"/><field name="implied_ids" eval="[Command.link(ref('account.group_account_readonly'))]"/></record>
    <record id="group_cap_finance_accounts_read" model="res.groups"><field name="name">Capability: read finance accounts</field><field name="privilege_id" ref="webvue_core.res_groups_privilege_webvue"/><field name="implied_ids" eval="[Command.link(ref('account.group_account_readonly'))]"/></record>
    <record id="group_cap_finance_journals_read" model="res.groups"><field name="name">Capability: read finance journals</field><field name="privilege_id" ref="webvue_core.res_groups_privilege_webvue"/><field name="implied_ids" eval="[Command.link(ref('account.group_account_readonly'))]"/></record>
    <record id="group_cap_finance_setup_read" model="res.groups"><field name="name">Capability: read finance setup</field><field name="privilege_id" ref="webvue_core.res_groups_privilege_webvue"/><field name="implied_ids" eval="[Command.link(ref('account.group_account_readonly'))]"/></record>
    <record id="group_cap_finance_setup_manage" model="res.groups"><field name="name">Capability: manage finance setup</field><field name="privilege_id" ref="webvue_core.res_groups_privilege_webvue"/><field name="implied_ids" eval="[Command.link(ref('account.group_account_readonly'))]"/></record>
    <record id="group_cap_finance_reports_read" model="res.groups"><field name="name">Capability: read finance reports</field><field name="privilege_id" ref="webvue_core.res_groups_privilege_webvue"/><field name="implied_ids" eval="[Command.link(ref('account.group_account_readonly'))]"/></record>


    <!-- Write capabilities imply the least stock group that lets the ORM do the operation, because the routes
         run in the caller's own environment (no sudo). account.group_account_manager is never implied.
         - partners.read: nothing; every internal user already reads res.partner (company rule), the route gates.
         - partners.manage: base.group_partner_manager, the stock group with res.partner create/write.
         - invoices.manage: account.group_account_invoice, the stock group with account.move and move-line
           create/write/unlink, plus read of journals, accounts and taxes.
         - invoices.post: account.group_account_invoice, the same group; posting, cancelling and resetting
           need no extra ACL, only the route separates it from drafting.
         - payments.manage: account.group_account_invoice, the stock group with account.payment and
           account.payment.register (wizard) create/write, and the payment method lines.
         Consequence, as for the read grants: the stock group is broader than the capability (it allows ORM
         writes on every invoice and payment), so the per-capability gate is the route, pinned by
         tests/test_finance_write_access.py. -->
    <record id="group_cap_finance_partners_read" model="res.groups"><field name="name">Capability: read finance partners</field><field name="privilege_id" ref="webvue_core.res_groups_privilege_webvue"/><field name="implied_ids" eval="[Command.clear()]"/></record>
    <record id="group_cap_finance_partners_manage" model="res.groups"><field name="name">Capability: manage finance partners</field><field name="privilege_id" ref="webvue_core.res_groups_privilege_webvue"/><field name="implied_ids" eval="[Command.link(ref('base.group_partner_manager'))]"/></record>
    <record id="group_cap_finance_invoices_manage" model="res.groups"><field name="name">Capability: manage finance invoices</field><field name="privilege_id" ref="webvue_core.res_groups_privilege_webvue"/><field name="implied_ids" eval="[Command.link(ref('account.group_account_invoice'))]"/></record>
    <record id="group_cap_finance_invoices_post" model="res.groups"><field name="name">Capability: post finance invoices</field><field name="privilege_id" ref="webvue_core.res_groups_privilege_webvue"/><field name="implied_ids" eval="[Command.link(ref('account.group_account_invoice'))]"/></record>
    <record id="group_cap_finance_payments_manage" model="res.groups"><field name="name">Capability: manage finance payments</field><field name="privilege_id" ref="webvue_core.res_groups_privilege_webvue"/><field name="implied_ids" eval="[Command.link(ref('account.group_account_invoice'))]"/></record>

    <!-- Journal entries: entries.read implies the read group like every read capability; entries.manage and
         entries.post imply account.group_account_invoice (account.move create/write/unlink and posting need
         no more), only the route separates drafting from posting. -->
    <record id="group_cap_finance_entries_read" model="res.groups"><field name="name">Capability: read finance journal entries</field><field name="privilege_id" ref="webvue_core.res_groups_privilege_webvue"/><field name="implied_ids" eval="[Command.link(ref('account.group_account_readonly'))]"/></record>
    <record id="group_cap_finance_entries_manage" model="res.groups"><field name="name">Capability: manage finance journal entries</field><field name="privilege_id" ref="webvue_core.res_groups_privilege_webvue"/><field name="implied_ids" eval="[Command.link(ref('account.group_account_invoice'))]"/></record>
    <record id="group_cap_finance_entries_post" model="res.groups"><field name="name">Capability: post finance journal entries</field><field name="privilege_id" ref="webvue_core.res_groups_privilege_webvue"/><field name="implied_ids" eval="[Command.link(ref('account.group_account_invoice'))]"/></record>

    <!-- Reports, assets and bank capabilities (OCA modules), the least stock group that lets the ORM do the operation:
         - statements.read, zakat.read, bank.read: account.group_account_readonly, which sees all journal items, the
           bank statements and their lines (the OCA report models and mis_builder read them in the caller's own
           environment; the report wizards and mis.report are open to every internal user).
         - assets.read: account.group_account_readonly, plus read-only ACLs on the account_asset_management models in
           security/ir.model.access.csv (that module grants the readonly group nothing). It cannot write assets or
           create journal entries.
         - assets.manage: account.group_account_invoice, which also creates and posts the depreciation entries
           (account.asset create/write and account.move create/write).
         - bank.manage: account.group_account_basic, the stock group for basic bank reconciliation: statements and
           statement lines create/write/unlink. It implies the Invoicing group, so it is BROADER than the capability:
           the holder can also create, edit and post invoices, bills and payments through the ORM. Reconciling
           writes journal entries, which that group may do.
         Consequence, as for the grants above: the stock group is broader than the capability, so the route is the
         per-capability gate (tests/test_finance_oca_access.py). -->
    <record id="group_cap_finance_statements_read" model="res.groups"><field name="name">Capability: read finance statements</field><field name="privilege_id" ref="webvue_core.res_groups_privilege_webvue"/><field name="implied_ids" eval="[Command.link(ref('account.group_account_readonly'))]"/></record>
    <record id="group_cap_finance_zakat_read" model="res.groups"><field name="name">Capability: read the Zakat base</field><field name="privilege_id" ref="webvue_core.res_groups_privilege_webvue"/><field name="implied_ids" eval="[Command.link(ref('account.group_account_readonly'))]"/></record>
    <record id="group_cap_finance_bank_read" model="res.groups"><field name="name">Capability: read finance bank statements</field><field name="privilege_id" ref="webvue_core.res_groups_privilege_webvue"/><field name="implied_ids" eval="[Command.link(ref('account.group_account_readonly'))]"/></record>
    <record id="group_cap_finance_bank_manage" model="res.groups"><field name="name">Capability: manage finance bank statements</field><field name="privilege_id" ref="webvue_core.res_groups_privilege_webvue"/><field name="implied_ids" eval="[Command.link(ref('account.group_account_basic'))]"/></record>
    <record id="group_cap_finance_assets_read" model="res.groups"><field name="name">Capability: read finance fixed assets</field><field name="privilege_id" ref="webvue_core.res_groups_privilege_webvue"/><field name="implied_ids" eval="[Command.set([ref('account.group_account_readonly')])]"/></record>
    <record id="group_cap_finance_assets_manage" model="res.groups"><field name="name">Capability: manage finance fixed assets</field><field name="privilege_id" ref="webvue_core.res_groups_privilege_webvue"/><field name="implied_ids" eval="[Command.link(ref('account.group_account_invoice'))]"/></record>

    <record id="group_finance_manager" model="res.groups">
        <field name="name">Finance Manager</field><field name="privilege_id" ref="webvue_core.res_groups_privilege_webvue"/>
        <field name="implied_ids" eval="[Command.set([ref('webvue_core.group_employee'),ref('group_cap_finance_invoices_read'),ref('group_cap_finance_payments_read'),ref('group_cap_finance_accounts_read'),ref('group_cap_finance_journals_read'),ref('group_cap_finance_partners_read'),ref('group_cap_finance_partners_manage'),ref('group_cap_finance_invoices_manage'),ref('group_cap_finance_invoices_post'),ref('group_cap_finance_payments_manage'),ref('group_cap_finance_setup_read'),ref('group_cap_finance_setup_manage'),ref('group_cap_finance_reports_read'),ref('group_cap_finance_entries_read'),ref('group_cap_finance_entries_manage'),ref('group_cap_finance_entries_post'),ref('group_cap_finance_statements_read'),ref('group_cap_finance_zakat_read'),ref('group_cap_finance_bank_read'),ref('group_cap_finance_bank_manage'),ref('group_cap_finance_assets_read'),ref('group_cap_finance_assets_manage')])]"/>
    </record>

    <!-- webvue_core's support group reaches Finance through this link. -->
    <record id="webvue_core.group_vendor_support" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_finance_manager'))]"/>
    </record>
</odoo>
