<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="permission_integrations_read" model="webvue.access.permission">
        <field name="key">integrations.read</field><field name="domain">integrations</field>
        <field name="resource">connections</field><field name="action">read</field>
        <field name="name_ar">قراءة حالة الربط الحكومي والمصرفي</field><field name="name_en">Read integration status</field>
        <field name="description_ar">قراءة حالة الربط مع هيئة الزكاة والضريبة والجمارك والبنوك</field><field name="description_en">Read the status of the ZATCA and bank links</field>
        <field name="group_xmlid">webvue_integrations_sa.group_cap_integrations_read</field>
        <field name="custom_role_allowed" eval="True"/><field name="sensitive" eval="False"/><field name="project_contextual" eval="False"/>
    </record>
    <record id="permission_integrations_manage" model="webvue.access.permission">
        <field name="key">integrations.manage</field><field name="domain">integrations</field>
        <field name="resource">connections</field><field name="action">manage</field>
        <field name="name_ar">إدارة الربط الحكومي والمصرفي</field><field name="name_en">Manage integrations</field>
        <field name="description_ar">إدارة الربط مع هيئة الزكاة والضريبة والجمارك والبنوك</field><field name="description_en">Manage the ZATCA and bank links</field>
        <field name="group_xmlid">webvue_integrations_sa.group_cap_integrations_manage</field>
        <field name="custom_role_allowed" eval="True"/><field name="sensitive" eval="True"/><field name="project_contextual" eval="False"/>
    </record>
    <!-- Built-in roles are noupdate records: these hooks link this addon's grants and
         dependencies on install and on every upgrade. -->
    <function model="webvue.access.service" name="_webvue_configure_permission_dependencies"/>
    <function model="webvue.access.service" name="_webvue_repair_builtin_role_grants"/>
</odoo>
