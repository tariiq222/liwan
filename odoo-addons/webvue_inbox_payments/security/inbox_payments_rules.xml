<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="webvue_inbox_catalog_company_rule" model="ir.rule">
        <field name="name">webvue.inbox.catalog: multi-company</field>
        <field name="model_id" ref="model_webvue_inbox_catalog"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="webvue_inbox_catalog_item_company_rule" model="ir.rule">
        <field name="name">webvue.inbox.catalog.item: multi-company</field>
        <field name="model_id" ref="model_webvue_inbox_catalog_item"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="webvue_inbox_order_company_rule" model="ir.rule">
        <field name="name">webvue.inbox.order: multi-company</field>
        <field name="model_id" ref="model_webvue_inbox_order"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="webvue_inbox_order_line_company_rule" model="ir.rule">
        <field name="name">webvue.inbox.order.line: multi-company</field>
        <field name="model_id" ref="model_webvue_inbox_order_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <!-- The catalog manager writes and creates only the products the catalog editor made; the ACL rows give it the
         rights, these rules narrow them. Reading products is not restricted. -->
    <record id="product_template_catalog_manage_rule" model="ir.rule">
        <field name="name">product.template: catalog managers change only catalog products</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="domain_force">[('webvue_inbox_catalog', '=', True)]</field>
        <field name="groups" eval="[Command.link(ref('group_cap_inbox_catalog_manage'))]"/>
        <field name="perm_read" eval="False"/>
    </record>
    <record id="product_product_catalog_manage_rule" model="ir.rule">
        <field name="name">product.product: catalog managers change only catalog products</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="domain_force">[('product_tmpl_id.webvue_inbox_catalog', '=', True)]</field>
        <field name="groups" eval="[Command.link(ref('group_cap_inbox_catalog_manage'))]"/>
        <field name="perm_read" eval="False"/>
    </record>
    <!-- The catalog manager reaches the channels of the companies it manages, like the other channel managers. -->
    <record id="webvue_inbox.webvue_inbox_channel_company_rule" model="ir.rule">
        <field name="groups" eval="[Command.link(ref('group_cap_inbox_catalog_manage'))]"/>
    </record>
</odoo>
