<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_followup" model="ir.cron">
        <field name="name">webvue CRM: recycles and due follow-ups</field>
        <field name="model_id" ref="model_webvue_crm_followup"/>
        <field name="state">code</field>
        <field name="code">model._webvue_cron_tick()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
