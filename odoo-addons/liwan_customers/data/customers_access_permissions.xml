<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="permission_customers_read" model="liwan.access.permission">
        <field name="key">customers.read</field><field name="domain">customers</field>
        <field name="resource">customers</field><field name="action">read</field>
        <field name="name_ar">عرض دليل العملاء</field><field name="name_en">Read customers</field>
        <field name="description_ar">عرض دليل العملاء وبيانات التواصل معهم وحقولهم المخصصة وقراءة إعدادات العملاء</field><field name="description_en">Read the customer directory, the customers' contact details and custom fields, and the customer settings</field>
        <field name="group_xmlid">liwan_customers.group_cap_customers_read</field>
        <field name="custom_role_allowed" eval="True"/><field name="sensitive" eval="False"/>
    </record>
    <record id="permission_customers_manage" model="liwan.access.permission">
        <field name="key">customers.manage</field><field name="domain">customers</field>
        <field name="resource">customers</field><field name="action">manage</field>
        <field name="name_ar">تعديل دليل العملاء</field><field name="name_en">Manage customers</field>
        <field name="description_ar">إضافة العملاء وتعديل بياناتهم وحقولهم المخصصة وأرشفتهم واستعادتهم</field><field name="description_en">Add customers, edit their details and custom fields, archive and restore them</field>
        <field name="group_xmlid">liwan_customers.group_cap_customers_manage</field>
        <field name="custom_role_allowed" eval="True"/><field name="sensitive" eval="False"/>
    </record>
    <record id="permission_customers_export" model="liwan.access.permission">
        <field name="key">customers.export</field><field name="domain">customers</field>
        <field name="resource">customers</field><field name="action">export</field>
        <field name="name_ar">تصدير دليل العملاء</field><field name="name_en">Export customers</field>
        <field name="description_ar">تنزيل دليل العملاء مع حقولهم المخصصة في ملف CSV</field><field name="description_en">Download the customer directory with its custom fields as a CSV file</field>
        <field name="group_xmlid">liwan_customers.group_cap_customers_export</field>
        <field name="custom_role_allowed" eval="True"/><field name="sensitive" eval="True"/>
    </record>
    <record id="permission_customers_settings_manage" model="liwan.access.permission">
        <field name="key">customers.settings.manage</field><field name="domain">customers</field>
        <field name="resource">settings</field><field name="action">manage</field>
        <field name="name_ar">إدارة إعدادات العملاء</field><field name="name_en">Manage customer settings</field>
        <field name="description_ar">تغيير مشاركة العملاء بين الفروع ودولة أرقام الهاتف وأنواع العملاء وحقولهم المخصصة</field><field name="description_en">Change how customers are shared between branches, the phone country, the kinds of customer and the custom fields</field>
        <field name="group_xmlid">liwan_customers.group_cap_customers_settings_manage</field>
        <field name="custom_role_allowed" eval="True"/><field name="sensitive" eval="True"/>
    </record>
    <record id="permission_customers_erase" model="liwan.access.permission">
        <field name="key">customers.erase</field><field name="domain">customers</field>
        <field name="resource">customers</field><field name="action">erase</field>
        <field name="name_ar">محو بيانات عميل</field><field name="name_en">Erase a customer's data</field>
        <field name="description_ar">محو هوية عميل واحد وبياناته الشخصية في كل التطبيقات مع إبقاء المستندات المحاسبية المرحّلة، بطلب موثّق في السجل</field><field name="description_en">Anonymise one customer and the personal data held about them in every application, keeping posted accounting documents, with a logged request</field>
        <field name="group_xmlid">liwan_customers.group_cap_customers_erase</field>
        <field name="custom_role_allowed" eval="False"/><field name="sensitive" eval="True"/>
    </record>
    <record id="permission_customers_privacy_export" model="liwan.access.permission">
        <field name="key">customers.privacy.export</field><field name="domain">customers</field>
        <field name="resource">privacy</field><field name="action">export</field>
        <field name="name_ar">تصدير كل ما نحتفظ به عن عميل</field><field name="name_en">Export everything held about a customer</field>
        <field name="description_ar">تنزيل ملف واحد بكل ما تحتفظ به المنصة عن عميل واحد، بطلب موثّق في السجل</field><field name="description_en">Download one file with everything the platform holds about one customer, with a logged request</field>
        <field name="group_xmlid">liwan_customers.group_cap_customers_privacy_export</field>
        <field name="custom_role_allowed" eval="False"/><field name="sensitive" eval="True"/>
    </record>
    <!-- Built-in roles are noupdate records: these hooks link this addon's grants and
         dependencies on install and on every upgrade. -->
    <function model="liwan.access.service" name="_liwan_configure_permission_dependencies"/>
    <function model="liwan.access.service" name="_liwan_repair_builtin_role_grants"/>
</odoo>
