<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_nasq_project_stakeholder_visible" model="ir.rule">
        <field name="name">Governance stakeholders follow project access</field>
        <field name="model_id" ref="model_nasq_project_stakeholder"/>
        <field name="domain_force">[('project_id', 'any', [('active', '=', True), ('company_id', '=', company_id)])]</field>
    </record>
    <record id="rule_nasq_project_raci_visible" model="ir.rule">
        <field name="name">Governance RACI follows project and task access</field>
        <field name="model_id" ref="model_nasq_project_raci"/>
        <field name="domain_force">[
            ('project_id', 'any', [('active', '=', True), ('company_id', '=', company_id)]),
            ('task_id', 'any', [('active', '=', True)])
        ]</field>
    </record>
    <record id="rule_nasq_project_register_visible" model="ir.rule">
        <field name="name">Governance register follows project and optional task access</field>
        <field name="model_id" ref="model_nasq_project_register"/>
        <field name="domain_force">[
            ('project_id', 'any', [('active', '=', True), ('company_id', '=', company_id)]),
            '|', ('task_id', '=', False), ('task_id', 'any', [('active', '=', True)])
        ]</field>
    </record>
</odoo>
