<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_nasq_project_type_current_company" model="ir.rule">
        <field name="name">Nasq project types in current company</field>
        <field name="model_id" ref="model_nasq_project_type"/>
        <field name="domain_force">[('company_id', '=', company_id)]</field>
    </record>
    <record id="rule_nasq_project_owning_unit_current_company" model="ir.rule">
        <field name="name">Nasq owning units in current company</field>
        <field name="model_id" ref="model_nasq_project_owning_unit"/>
        <field name="domain_force">[('company_id', '=', company_id)]</field>
    </record>
</odoo>
