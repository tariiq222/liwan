<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_project_current_company" model="ir.rule">
        <field name="name">Nasq projects in current company</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="domain_force">[('company_id', '=', company_id)]</field>
    </record>
    <record id="rule_task_current_company" model="ir.rule">
        <field name="name">Nasq tasks in current company</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="domain_force">[('company_id', '=', company_id)]</field>
    </record>
</odoo>
