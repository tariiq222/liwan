diff --git a/apps/web/app/components/project/ProjectCreateForm.vue b/apps/web/app/components/project/ProjectCreateForm.vue
index d2f6e60..f1d0f02 100644
--- a/apps/web/app/components/project/ProjectCreateForm.vue
+++ b/apps/web/app/components/project/ProjectCreateForm.vue
@@ -1,21 +1,99 @@
 <script setup lang="ts">
+import type { CalendarDate } from '@internationalized/date'
+import { refDebounced } from '@vueuse/core'
+import { Check } from 'lucide-vue-next'
+import { formatCalendarDate, fromCalendarDate, toCalendarDate } from '@/composables/calendarDate'
 import { ApiError } from '@/composables/useApi'
+import { usePeople } from '@/composables/usePeople'
+import { useProjectCreateDefaults } from '@/composables/useProjectSettings'
 import { useCreateProject } from '@/composables/useProjects'
 
 const emit = defineEmits<{ created: [id: number]; cancel: [] }>()
-const { t } = useI18n()
+const { t, locale } = useI18n()
 const hydrated = useHydrated()
+const { me } = useMe()
+const {
+  data: defaults,
+  isPending: defaultsLoading,
+  isError: defaultsFailed,
+  error: defaultsError,
+  refetch: refetchDefaults,
+  isFetching: defaultsFetching,
+} = useProjectCreateDefaults()
 const { mutateAsync, isPending } = useCreateProject()
 
 const name = ref('')
+const managerId = ref<number | null>(null)
+const dateEnd = ref<string | null>(null)
 const error = ref<string | null>(null)
+const managerOpen = ref(false)
+const managerQ = ref('')
+const debouncedManagerQ = refDebounced(managerQ, 250)
+const { data: people } = usePeople(debouncedManagerQ)
+const defaultApplied = ref(false)
+const selectedManagerName = ref<string | null>(null)
+
+const forbidden = computed(() => (
+  defaultsError.value instanceof ApiError
+  && (defaultsError.value.status === 403 || defaultsError.value.code === 'create_forbidden')
+))
+const defaultsReady = computed(() => !!defaults.value && !forbidden.value)
+const requireManager = computed(() => !!defaults.value?.require_manager_on_create)
+const requireEndDate = computed(() => !!defaults.value?.require_end_date_on_create)
+const submitBlocked = computed(() => !hydrated.value || isPending.value || !defaultsReady.value || defaultsLoading.value || defaultsFailed.value)
+
+watch(
+  () => defaults.value,
+  (value) => {
+    if (!value || defaultApplied.value) return
+    defaultApplied.value = true
+    if (managerId.value === null && value.default_manager_id) {
+      managerId.value = value.default_manager_id
+      if (value.default_manager_id === me.value?.id) selectedManagerName.value = me.value.name
+    }
+  },
+  { immediate: true },
+)
+
+const endValue = computed(() => toCalendarDate(dateEnd.value))
+const endLabel = computed(() => formatCalendarDate(dateEnd.value, locale.value) || t('projects.create.chooseEndDate'))
+const managerName = computed(() => {
+  if (!managerId.value) return t('projects.settings.noManager')
+  if (selectedManagerName.value) return selectedManagerName.value
+  if (managerId.value === me.value?.id) return me.value.name
+  return people.value?.find(person => person.id === managerId.value)?.name ?? t('projects.settings.manager')
+})
+
+function selectManager(id: number | null, label: string | null) {
+  managerId.value = id
+  selectedManagerName.value = label
+  managerOpen.value = false
+}
+
+async function retryDefaults() {
+  error.value = null
+  await refetchDefaults()
+}
 
 async function submit() {
   error.value = null
+  if (!defaultsReady.value || !defaults.value) return
   const trimmed = name.value.trim()
   if (!trimmed) return
+  if (defaults.value.require_manager_on_create && !managerId.value) {
+    error.value = t('projects.create.managerRequired')
+    return
+  }
+  if (defaults.value.require_end_date_on_create && !dateEnd.value) {
+    error.value = t('projects.create.endDateRequired')
+    return
+  }
   try {
-    const created = await mutateAsync({ name: trimmed })
+    const created = await mutateAsync({
+      name: trimmed,
+      user_id: managerId.value,
+      date_end: dateEnd.value,
+    })
     emit('created', created.id)
   } catch (e) {
     error.value = e instanceof ApiError && e.code === 'create_forbidden' ? t('projects.createForbidden') : e instanceof ApiError ? e.message : t('errors.generic')
@@ -25,14 +103,95 @@ async function submit() {
 
 <template>
   <form data-testid="project-create-form" class="grid gap-4" @submit.prevent="submit">
+    <p class="text-sm text-muted-foreground">{{ t('projects.create.defaultsHint') }}</p>
+    <p v-if="defaultsLoading" data-testid="project-create-loading" class="text-sm text-muted-foreground">{{ t('projects.create.loading') }}</p>
+    <div v-else-if="forbidden" role="alert" class="grid gap-2" data-testid="project-create-forbidden">
+      <p class="text-sm text-destructive">{{ t('projects.createForbidden') }}</p>
+    </div>
+    <div v-else-if="defaultsFailed" role="alert" class="grid gap-2" data-testid="project-create-defaults-error">
+      <p class="text-sm text-destructive">{{ t('projects.create.defaultsError') }}</p>
+      <Button type="button" variant="outline" size="sm" :disabled="!hydrated || defaultsFetching" data-testid="project-create-retry" @click="retryDefaults">
+        {{ t('projects.create.retry') }}
+      </Button>
+    </div>
     <div class="grid gap-2">
       <Label for="new-project-name">{{ t('projects.newName') }}</Label>
       <Input id="new-project-name" v-model="name" data-testid="project-create-name" required :disabled="!hydrated || isPending" />
     </div>
+    <div class="grid gap-2">
+      <Label for="project-create-manager">
+        {{ t('projects.settings.manager') }}
+        <span v-if="requireManager" class="text-destructive">*</span>
+      </Label>
+      <Popover v-model:open="managerOpen">
+        <PopoverTrigger as-child>
+          <Button
+            id="project-create-manager"
+            variant="outline"
+            class="w-full justify-start"
+            type="button"
+            data-testid="project-create-manager"
+            :disabled="!hydrated || isPending || !defaultsReady"
+            :aria-required="requireManager"
+          >
+            {{ managerName }}
+          </Button>
+        </PopoverTrigger>
+        <PopoverContent class="w-64 p-0" align="start">
+          <div class="border-b p-2">
+            <Input v-model="managerQ" :placeholder="t('app.search')" class="h-8" />
+          </div>
+          <Command>
+            <CommandList>
+              <CommandEmpty>{{ t('app.noResults') }}</CommandEmpty>
+              <CommandGroup>
+                <CommandItem v-if="!requireManager" value="none" @select="selectManager(null, null)">
+                  <span class="flex-1">{{ t('projects.settings.noManager') }}</span>
+                  <Check v-if="!managerId" class="size-4" />
+                </CommandItem>
+                <CommandItem
+                  v-for="p in people ?? []"
+                  :key="p.id"
+                  :value="String(p.id)"
+                  @select="selectManager(p.id, p.name)"
+                >
+                  <span class="flex-1">{{ p.name }}</span>
+                  <Check v-if="managerId === p.id" class="size-4" />
+                </CommandItem>
+              </CommandGroup>
+            </CommandList>
+          </Command>
+        </PopoverContent>
+      </Popover>
+    </div>
+    <div class="grid gap-2">
+      <Label for="project-create-end-date">
+        {{ t('projects.settings.dateEnd') }}
+        <span v-if="requireEndDate" class="text-destructive">*</span>
+      </Label>
+      <Popover>
+        <PopoverTrigger as-child>
+          <Button
+            id="project-create-end-date"
+            variant="outline"
+            class="justify-start"
+            type="button"
+            data-testid="project-create-end-date"
+            :disabled="!hydrated || isPending || !defaultsReady"
+            :aria-required="requireEndDate"
+          >
+            {{ endLabel }}
+          </Button>
+        </PopoverTrigger>
+        <PopoverContent class="w-auto p-0" align="start">
+          <Calendar :model-value="endValue" @update:model-value="dateEnd = fromCalendarDate($event as CalendarDate | undefined)" />
+        </PopoverContent>
+      </Popover>
+    </div>
     <p v-if="error" role="alert" class="text-sm text-destructive">{{ error }}</p>
     <div class="flex flex-wrap justify-end gap-2">
       <Button type="button" variant="outline" :disabled="isPending" @click="emit('cancel')">{{ t('app.cancel') }}</Button>
-      <Button type="submit" :disabled="!hydrated || isPending || !name.trim()">{{ t('app.create') }}</Button>
+      <Button type="submit" data-testid="project-create-submit" :disabled="submitBlocked || !name.trim()">{{ t('app.create') }}</Button>
     </div>
   </form>
 </template>
diff --git a/apps/web/app/components/project/ProjectGeneralForm.vue b/apps/web/app/components/project/ProjectGeneralForm.vue
index 6f194dd..b1f2150 100644
--- a/apps/web/app/components/project/ProjectGeneralForm.vue
+++ b/apps/web/app/components/project/ProjectGeneralForm.vue
@@ -76,14 +76,8 @@ function onVisibilityChange(v: unknown) {
 }
 
 // --- dates -----------------------------------------------------------------------
-// Odoo semantics (ruling, not a guess): PATCH /projects/{id} clears BOTH
-// date_start and date on the server whenever either is sent as null, because
-// project.project treats the pair as a single range rather than two
-// independent fields. The UI mirrors that: setting one edge alone sends only
-// that field (the other is left untouched, whatever it currently is), but
-// clearing either edge sends {date_start: null, date: null} together and
-// shows both as empty afterwards — never a half-cleared range that no longer
-// matches what the server actually stored.
+// A lone end-date PATCH sends only `{ date }`. Clearing still sends both
+// nulls together so an explicit clear cannot leave a half-range.
 const startValue = computed(() => toCalendarDate(props.project.date_start))
 const endValue = computed(() => toCalendarDate(props.project.date_end))
 const startLabel = computed(() => formatCalendarDate(props.project.date_start, locale.value) || t('projects.settings.noDate'))
@@ -112,6 +106,89 @@ type TagRef = ProjectDetail['tags'][number]
 function onTagsChange({ ids }: { ids: number[]; resolved: TagRef[] }) {
   patch({ tag_ids: ids })
 }
+
+const approverOpen = ref(false)
+const approverQ = ref('')
+const debouncedApproverQ = refDebounced(approverQ, 250)
+const { data: approverPeople } = usePeople(debouncedApproverQ)
+const pendingMode = ref<ProjectDetail['completion_approval'] | null>(null)
+const pendingApproverId = ref<number | null>(null)
+const approvalError = ref<string | null>(null)
+const approvalBusy = ref(false)
+const displayedMode = computed(() => pendingMode.value ?? props.project.completion_approval)
+
+watch(
+  () => [props.project.completion_approval, props.project.completion_approver?.id],
+  () => {
+    pendingMode.value = null
+    pendingApproverId.value = null
+    approvalError.value = null
+  },
+)
+
+function saveApproval(mode: ProjectDetail['completion_approval'], approverId: number | null) {
+  if (approvalBusy.value) return
+  approvalBusy.value = true
+  approvalError.value = null
+  updateProject(
+    {
+      id: props.project.id,
+      patch: {
+        nasq_completion_approval: mode,
+        nasq_completion_approver_id: mode === 'specific_user' ? approverId : null,
+      },
+    },
+    {
+      onError: (e) => {
+        approvalError.value = e instanceof ApiError ? e.message : t('errors.generic')
+        toast.error(approvalError.value)
+      },
+      onSuccess: () => {
+        pendingMode.value = null
+        pendingApproverId.value = null
+        toast.success(t('projects.settings.saved'))
+      },
+      onSettled: () => {
+        approvalBusy.value = false
+      },
+    },
+  )
+}
+
+function onApprovalChange(v: unknown) {
+  const mode = v as ProjectDetail['completion_approval']
+  if (!mode || mode === displayedMode.value || approvalBusy.value) return
+  if (mode === 'specific_user') {
+    pendingMode.value = mode
+    pendingApproverId.value = props.project.completion_approver?.id ?? null
+    return
+  }
+  pendingMode.value = null
+  saveApproval(mode, null)
+}
+
+function selectApprover(userId: number) {
+  approverOpen.value = false
+  approverQ.value = ''
+  pendingApproverId.value = userId
+  saveApproval('specific_user', userId)
+}
+
+function cancelPendingApproval() {
+  pendingMode.value = null
+  pendingApproverId.value = null
+  approvalError.value = null
+}
+
+const displayedApproverName = computed(() => {
+  if (pendingApproverId.value) {
+    return approverPeople.value?.find(person => person.id === pendingApproverId.value)?.name
+      ?? props.project.completion_approver?.name
+      ?? t('projects.settings.noApprover')
+  }
+  return props.project.completion_approver?.name ?? t('projects.settings.noApprover')
+})
+const approvalLocked = computed(() => approvalBusy.value)
 </script>
 
 <template>
