+            raise UserError(self.env._("A return note is required."))
+        self._nasq_check_completion_decision(revision)
+        return self._nasq_clear_completion_request(note=note.strip())
+
+    def _nasq_withdraw_completion(self, revision):
+        self.ensure_one()
