     <section class="space-y-2">
       <Label>{{ t('projects.settings.dateStart') }} / {{ t('projects.settings.dateEnd') }}</Label>
       <div class="grid grid-cols-2 gap-2">
@@ -226,6 +298,49 @@ function onTagsChange({ ids }: { ids: number[]; resolved: TagRef[] }) {
       />
