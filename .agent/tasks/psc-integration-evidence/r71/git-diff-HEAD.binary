+        finally:
+            marker[COMPLETION_ACCEPT_IDS] = previous
+            if not previous:
+                marker.pop(COMPLETION_ACCEPT_IDS, None)
+        return self
+
+    def _nasq_return_completion(self, revision, note):
+        self.ensure_one()
