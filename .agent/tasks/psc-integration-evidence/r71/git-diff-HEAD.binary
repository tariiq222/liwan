+    mutationFn: ({ id }: { id: number }) =>
+      $api(`/api/v1/tasks/${id}/completion/request`, { method: 'POST', body: {}, schema: TaskDetailSchema }),
+    onSuccess: (detail, { id }) => {
+      qc.setQueryData(taskKeys.detail(id), detail)
+      qc.invalidateQueries({ queryKey: ['tasks', 'list'] })
