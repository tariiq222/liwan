+
+def parse_project_create(payload):
+    unknown = set(payload) - CREATE_FIELDS
+    if unknown:
+        raise ApiError(422, 'unknown_field', f"field {sorted(unknown)[0]!r} is not writable", field=sorted(unknown)[0])
+    name = payload.get('name')
+    if not isinstance(name, str) or not name.strip():
+        raise ApiError(422, 'invalid', "name must not be empty", field='name')
+    settings = request.env['nasq.pmo.settings'].get()
+    if 'user_id' in payload:
+        value = payload['user_id']
+        if value in (None, False):
+            if settings['require_manager_on_create']:
+                raise ApiError(422, 'invalid', "manager is required to create a project", field='user_id')
+            user_id = False
+        else:
+            is_int = isinstance(value, int) and not isinstance(value, bool)
+            user = request.env['res.users'].browse(int(value)).exists() if is_int else None
+            if not user or user.share or not user.active:
+                raise ApiError(422, 'invalid', "user_id must be an active internal user", field='user_id')
+            if request.env.company.id not in user.sudo().company_ids.ids:
+                raise ApiError(422, 'invalid', "user_id must belong to the current company", field='user_id')
+            user_id = user.id
+    else:
+        user_id = request.env.uid
+        if settings['require_manager_on_create'] and not user_id:
+            raise ApiError(422, 'invalid', "manager is required to create a project", field='user_id')
+    date_end = None
+    if 'date_end' in payload:
+        date_end = parse_date(payload['date_end'], 'date_end')
+        if not date_end and settings['require_end_date_on_create']:
+            raise ApiError(422, 'invalid', "end date is required to create a project", field='date_end')
+    elif settings['require_end_date_on_create']:
+        raise ApiError(422, 'invalid', "end date is required to create a project", field='date_end')
+    return {'name': name.strip(), 'user_id': user_id, 'date_end': date_end or None}
