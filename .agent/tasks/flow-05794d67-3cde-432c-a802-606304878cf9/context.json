{
  "files": [
    {
      "path": "apps/web/app/app.vue",
      "hash": "668c7917eddce716133a465087d12ecf308879e896a246a1840f18af20dbc1dd",
      "content": "<script setup lang=\"ts\">\nimport { ConfigProvider } from 'reka-ui'\n\nconst { locale } = useI18n()\n// @nuxtjs/i18n does not patch <html lang/dir> on its own — the module only\n// computes the values via useLocaleHead(); applying them to the document\n// head is left to the app (see the module's lang-switcher guide).\nconst i18nHead = useLocaleHead({ seo: false })\nuseHead(() => ({\n  htmlAttrs: {\n    lang: i18nHead.value.htmlAttrs?.lang,\n    dir: i18nHead.value.htmlAttrs?.dir,\n  },\n}))\n</script>\n\n<template>\n  <ConfigProvider :dir=\"locale === 'ar' ? 'rtl' : 'ltr'\">\n    <NuxtLayout>\n      <NuxtPage />\n    </NuxtLayout>\n  </ConfigProvider>\n</template>\n"
    },
    {
      "path": "apps/web/app/components/access/__tests__/state-contract.test.ts",
      "hash": "0741da9479cd6cd5f9a3813f5c7fc694f99243abd427e5f7d10fcd7a29815863",
      "content": "import { readdirSync, readFileSync, statSync } from 'node:fs'\nimport { join } from 'node:path'\nimport { describe, expect, it } from 'vitest'\n\nfunction collectVueFiles(directory: string): string[] {\n  return readdirSync(directory).flatMap((name) => {\n    const path = join(directory, name)\n    if (name === '__tests__' || !statSync(path).isDirectory()) return name.endsWith('.vue') ? [path] : []\n    return collectVueFiles(path)\n  })\n}\n\nfunction accessComponentSource() {\n  const directory = join(import.meta.dirname, '..')\n  const files = collectVueFiles(directory)\n  expect(files.length, 'access components are not present yet').toBeGreaterThan(0)\n  return files.map((path) => readFileSync(path, 'utf8')).join('\\n')\n}\n\ndescribe('access component state contract', () => {\n  it('represents protected records and server allowed actions explicitly', () => {\n    const source = accessComponentSource()\n    expect(source).toMatch(/protected/)\n    expect(source).toMatch(/allowed_actions/)\n    expect(source).toMatch(/read[-_ ]?only|readonly/i)\n  })\n\n  it('renders write controls only from the returned action set and exposes forbidden/conflict states', () => {\n    const source = accessComponentSource()\n    expect(source).toMatch(/allowed_actions.*(includes|\\.includes)/s)\n    expect(source).toMatch(/403|forbidden|protected[_A-Z]?user/i)\n    expect(source).toMatch(/409|conflict|current_version|reload/i)\n  })\n\n  it('explains that disabling a custom role blocks new assignments but keeps existing effects', () => {\n    const source = accessComponentSource()\n    expect(source).toMatch(/!props\\.role\\.active|!role\\.active|role\\.active.*selectedRoleIds/s)\n    expect(source).toMatch(/existing|already|remain|current/i)\n    expect(source).toMatch(/assignment/i)\n  })\n\n  it('does not render password or session secrets from user and audit response data', () => {\n    const source = accessComponentSource()\n    expect(source).not.toMatch(/\\{\\{\\s*(?:user|event|query\\.data\\.value|props\\.user)\\.[^}]*\\b(password|password_hash|session_id|token|hash)\\b[^}]*\\}\\}/i)\n    expect(source).not.toMatch(/before\\.(password|token|session_id|hash)|after\\.(password|token|session_id|hash)/i)\n  })\n})\n"
    },
    {
      "path": "apps/web/app/components/access/roles/RoleTable.vue",
      "hash": "600cd4789bbde320bac48e9061fc12c3cb8851751fd6c52fa43e92aa59bd85e1",
      "content": "<script setup lang=\"ts\">\nimport type { RoleSummary } from '@nasq/contracts'\nimport AccessStateBadge from '@/components/access/AccessStateBadge.vue'\n\ndefineProps<{ roles: RoleSummary[]; canManage?: boolean }>()\ndefineEmits<{ open: [id: number]; clone: [id: number] }>()\nconst { t } = useI18n()\nconst hydrated = useHydrated()\n</script>\n\n<template>\n  <div class=\"overflow-x-auto rounded-lg border\">\n    <table class=\"w-full min-w-[680px] text-sm\">\n      <thead class=\"border-b bg-muted/30\">\n        <tr>\n          <th class=\"p-3 text-start font-medium\">{{ t('access.roles.columns.name') }}</th>\n          <th class=\"p-3 text-start font-medium\">{{ t('access.roles.columns.description') }}</th>\n          <th class=\"p-3 text-start font-medium\">{{ t('access.roles.columns.type') }}</th>\n          <th class=\"p-3 text-start font-medium\">{{ t('access.roles.columns.users') }}</th>\n          <th class=\"p-3 text-start font-medium\">{{ t('access.roles.columns.status') }}</th>\n          <th class=\"p-3 text-end font-medium\">{{ t('access.roles.columns.actions') }}</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr v-for=\"role in roles\" :key=\"role.id\" class=\"border-b last:border-0\">\n          <td class=\"p-3 font-medium\">{{ role.name.ar }}</td>\n          <td class=\"max-w-xs p-3\">{{ role.description }}</td>\n          <td class=\"p-3\">{{ role.type === 'built_in' ? t('access.roles.builtIn') : t('access.roles.custom') }}</td>\n          <td class=\"p-3\">{{ role.user_count }}</td>\n          <td class=\"p-3\"><AccessStateBadge :active=\"role.active\" :protected=\"role.protected\" /></td>\n          <td class=\"flex justify-end gap-1 p-3\">\n            <Button variant=\"ghost\" size=\"sm\" :disabled=\"!hydrated\" @click=\"$emit('open', role.id)\">{{ t('access.view') }}</Button>\n            <Button v-if=\"canManage\" variant=\"ghost\" size=\"sm\" :disabled=\"!hydrated\" @click=\"$emit('clone', role.id)\">{{ t('access.roles.clone') }}</Button>\n          </td>\n        </tr>\n      </tbody>\n    </table>\n  </div>\n</template>\n"
    },
    {
      "path": "apps/web/app/components/AppSidebar.vue",
      "hash": "f3bcbe19db5304c43c02604b3c9e8ba94cc4be5127dc21cac431d21a6c6b86c2",
      "content": "<script setup lang=\"ts\">\nimport { ChevronDown, LogOut, UserRound } from 'lucide-vue-next'\nimport { isNavPathActive } from '@/utils/accessPolicy'\nimport { useQueryClient } from '@tanstack/vue-query'\nimport { useSidebar } from '@/components/ui/sidebar/utils'\nconst queryClient = useQueryClient()\nconst { state, setOpenMobile } = useSidebar()\n\nconst { t, localeProperties } = useI18n()\nconst { me } = useMe()\nconst { branding } = useBranding()\nconst { connected } = useBus()\nconst route = useRoute()\nconst nav = computed(() => useNav(me.value))\nconst groups = computed(() => [\n  { id: 'projects', labelKey: 'nav.projects' },\n  { id: 'hr', labelKey: 'nav.humanResources' },\n  { id: 'admin', labelKey: 'nav.systemAdministration' },\n].map(group => ({ ...group, items: nav.value.filter(item => item.group === group.id) })).filter(group => group.items.length))\nconst standalone = computed(() => nav.value.filter(item => !item.group))\nconst openGroups = ref<Record<string, boolean>>({ projects: true, hr: true, admin: true })\nconst preferenceKey = computed(() => `nasq-nav:${me.value?.id ?? 'anonymous'}`)\nonMounted(() => {\n  try { const saved = sessionStorage.getItem(preferenceKey.value); if (saved) openGroups.value = { ...openGroups.value, ...JSON.parse(saved) } } catch { /* Optional preference. */ }\n})\nwatch(() => route.path, () => {\n  for (const group of groups.value) if (group.items.some(item => isActive(item.to))) openGroups.value[group.id] = true\n})\nfunction toggleGroup(id: string) {\n  openGroups.value[id] = !openGroups.value[id]\n  try { sessionStorage.setItem(preferenceKey.value, JSON.stringify(openGroups.value)) } catch { /* Navigation works without storage. */ }\n}\nconst initials = computed(() => (me.value?.name ?? '?').trim().slice(0, 1))\nconst productName = computed(() => branding.value?.name ?? t('app.productName'))\nfunction isActive(path: string) {\n  return isNavPathActive(route.path, path)\n}\n// The nav links above are NuxtLink/<a> — they navigate natively and work\n// fine before hydration, so they're left ungated. The account menu trigger\n// below (opening to the logout item) is SSR-rendered with an attached\n// listener and is racy the same way TaskToolbar's controls are; gate it.\nconst hydrated = useHydrated()\n\nasync function logout() {\n  // body: {} so ofetch sets application/json — the endpoint rejects anything else.\n  await $fetch('/api/auth/logout', { method: 'POST', body: {} })\n  sessionStorage.removeItem(preferenceKey.value)\n  await queryClient.cancelQueries()\n  queryClient.clear()\n  await refreshNuxtData('me')\n  await navigateTo('/login')\n}\n</script>\n\n<template>\n  <Sidebar :side=\"localeProperties.dir === 'rtl' ? 'right' : 'left'\" collapsible=\"icon\">\n    <SidebarHeader>\n      <div class=\"flex items-center gap-2 px-2 py-1.5\">\n        <img v-if=\"branding\" :src=\"branding.logo_url\" :alt=\"branding.name\" class=\"size-8 rounded-md object-contain\" />\n        <span v-else class=\"grid size-8 place-items-center rounded-md bg-primary text-sm font-bold text-primary-foreground\">ن</span>\n        <span class=\"truncate font-semibold group-data-[collapsible=icon]:hidden\">{{ productName }}</span>\n      </div>\n    </SidebarHeader>\n\n    <SidebarContent role=\"navigation\" :aria-label=\"$t('nav.goTo')\">\n      <SidebarGroup v-for=\"group in groups\" :key=\"group.id\">\n        <button type=\"button\" class=\"flex w-full items-center gap-2 rounded-md px-2 py-2 text-xs font-semibold text-muted-foreground hover:bg-sidebar-accent group-data-[collapsible=icon]:hidden\" :disabled=\"!hydrated\" :aria-expanded=\"openGroups[group.id]\" :aria-controls=\"`nav-group-${group.id}`\" @click=\"toggleGroup(group.id)\">\n          <span>{{ $t(group.labelKey) }}</span><ChevronDown class=\"ms-auto size-3.5 transition-transform\" :class=\"{ '-rotate-90': !openGroups[group.id] }\" />\n        </button>\n        <SidebarMenu v-show=\"openGroups[group.id] || state === 'collapsed'\" :id=\"`nav-group-${group.id}`\">\n          <SidebarMenuItem v-for=\"item in group.items\" :key=\"item.to\">\n            <SidebarMenuButton as-child :is-active=\"isActive(item.to)\" :tooltip=\"$t(item.labelKey)\">\n              <NuxtLink :to=\"item.to\" @click=\"setOpenMobile(false)\" :aria-current=\"isActive(item.to) ? 'page' : undefined\"><component :is=\"item.icon\" /><span>{{ $t(item.labelKey) }}</span></NuxtLink>\n            </SidebarMenuButton>\n          </SidebarMenuItem>\n        </SidebarMenu>\n      </SidebarGroup>\n      <SidebarGroup v-if=\"standalone.length\"><SidebarMenu><SidebarMenuItem v-for=\"item in standalone\" :key=\"item.to\"><SidebarMenuButton as-child :tooltip=\"$t(item.labelKey)\"><a :href=\"item.to\" target=\"_blank\" rel=\"noopener\"><component :is=\"item.icon\" /><span>{{ $t(item.labelKey) }}</span></a></SidebarMenuButton></SidebarMenuItem></SidebarMenu></SidebarGroup>\n    </SidebarContent>\n\n    <SidebarFooter>\n      <DropdownMenu>\n        <DropdownMenuTrigger as-child :disabled=\"!hydrated\">\n          <SidebarMenuButton size=\"lg\" :disabled=\"!hydrated\">\n            <div class=\"relative\">\n              <Avatar class=\"size-8 rounded-md\"><AvatarFallback class=\"rounded-md\">{{ initials }}</AvatarFallback></Avatar>\n              <!--\n                Client-only: the bus connection genuinely doesn't exist during\n                SSR (bus.client.ts never runs there), so an SSR-rendered dot\n                would always render \"disconnected\" and cause a hydration\n                mismatch the instant the client connects.\n              -->\n              <ClientOnly>\n                <span\n                  class=\"absolute -bottom-0.5 -end-0.5 block size-2.5 rounded-full ring-2 ring-sidebar\"\n                  :class=\"connected ? 'bg-emerald-500' : 'bg-muted-foreground/50'\"\n                  :title=\"connected ? t('bus.connected') : t('bus.disconnected')\"\n                  :aria-label=\"connected ? t('bus.connected') : t('bus.disconnected')\"\n                  role=\"status\"\n                />\n              </ClientOnly>\n            </div>\n            <div class=\"grid flex-1 text-start text-sm leading-tight group-data-[collapsible=icon]:hidden\">\n              <span class=\"truncate font-medium\">{{ me?.name }}</span>\n              <span class=\"truncate text-xs text-muted-foreground\">{{ me?.email }}</span>\n            </div>\n          </SidebarMenuButton>\n        </DropdownMenuTrigger>\n        <DropdownMenuContent side=\"top\" align=\"end\" class=\"w-56\">\n          <DropdownMenuItem as-child><NuxtLink to=\"/account\"><UserRound class=\"me-2 size-4\" />{{ $t('nav.account') }}</NuxtLink></DropdownMenuItem>\n          <DropdownMenuItem @select=\"logout\"><LogOut class=\"me-2 size-4\" />{{ $t('nav.logout') }}</DropdownMenuItem>\n        </DropdownMenuContent>\n      </DropdownMenu>\n    </SidebarFooter>\n    <SidebarRail />\n  </Sidebar>\n</template>\n"
    },
    {
      "path": "apps/web/app/components/shared/PageHeader.vue",
      "hash": "5b84512950e38b7350666e212888aab22e2dc603c2da11fad145c36eb499cfb8",
      "content": "<script setup lang=\"ts\">\nimport { ArrowRight } from 'lucide-vue-next'\nimport type { RouteLocationRaw } from 'vue-router'\n\nconst props = defineProps<{\n  title: string\n  description?: string\n  backTo?: RouteLocationRaw\n  backLabel?: string\n}>()\n</script>\n\n<template>\n  <header class=\"space-y-3\">\n    <div v-if=\"props.backTo || $slots.back\" class=\"flex items-center gap-2 text-sm\">\n      <slot name=\"back\">\n        <NuxtLink :to=\"props.backTo!\" class=\"inline-flex items-center gap-1 text-muted-foreground hover:text-foreground hover:underline\">\n          <ArrowRight aria-hidden=\"true\" class=\"size-4 ltr:rotate-180\" />{{ props.backLabel || $t('app.back') }}\n        </NuxtLink>\n      </slot>\n    </div>\n\n    <div class=\"flex flex-wrap items-start justify-between gap-3\">\n      <div class=\"min-w-0 text-start\">\n        <h1 class=\"text-2xl font-semibold\">\n          <slot name=\"title\">{{ props.title }}</slot>\n        </h1>\n        <p v-if=\"props.description\" class=\"mt-1 text-sm text-muted-foreground\">{{ props.description }}</p>\n      </div>\n      <div v-if=\"$slots.actions || $slots.default\" class=\"ms-auto flex w-full min-w-0 max-w-full flex-wrap items-center gap-2 sm:w-auto\">\n        <slot name=\"actions\"><slot /></slot>\n      </div>\n    </div>\n  </header>\n</template>\n"
    },
    {
      "path": "apps/web/app/components/shared/FilterBar.vue",
      "hash": "01cb636479e10871fcc661a160bcafdf0d55fda3a011fdb6bd3abceab12ca6a1",
      "content": "<template>\n  <div class=\"space-y-2\">\n    <div data-slot=\"filter-row\" class=\"flex flex-wrap items-center gap-2\">\n      <div data-slot=\"search\" class=\"basis-full min-w-0 sm:min-w-48 sm:flex-1\">\n        <slot name=\"search\" />\n      </div>\n      <div data-slot=\"controls\" class=\"contents\">\n        <slot />\n      </div>\n      <div data-slot=\"view\" class=\"contents\">\n        <slot name=\"view\" />\n      </div>\n    </div>\n    <div v-if=\"$slots.active\" data-slot=\"active-row\" class=\"flex flex-wrap items-center gap-2\">\n      <slot name=\"active\" />\n    </div>\n  </div>\n</template>\n"
    },
    {
      "path": "apps/web/app/components/project/ProjectTable.vue",
      "hash": "252484f4ab96ad4b084b90c1d9585248b76730ba51164775e37517485a669652",
      "content": "<script setup lang=\"ts\">\nimport type { Project } from '@nasq/contracts'\nimport { FlexRender, createColumnHelper, getCoreRowModel, useVueTable } from '@tanstack/vue-table'\nimport { h } from 'vue'\nimport ProjectMenu from './ProjectMenu.vue'\nimport ProjectProgress from './ProjectProgress.vue'\nimport ProjectStatusBadge from './ProjectStatusBadge.vue'\nimport EmptyState from '@/components/shared/EmptyState.vue'\n\nconst props = defineProps<{ items: Project[]; isLoading: boolean; archived: boolean; capped: boolean; filtered: boolean }>()\nconst emit = defineEmits<{ open: [id: number] }>()\n\nconst { t } = useI18n()\nconst hydrated = useHydrated()\n\nconst columnHelper = createColumnHelper<Project>()\nconst columns = [\n  columnHelper.accessor('name', {\n    id: 'name',\n    header: () => t('projects.columns.name'),\n  }),\n  columnHelper.display({\n    id: 'status',\n    header: () => t('projects.columns.status'),\n    cell: (info) => h(ProjectStatusBadge, { status: info.row.original.status }),\n  }),\n  columnHelper.display({\n    id: 'progress',\n    header: () => t('projects.columns.progress'),\n    cell: (info) =>\n      h(ProjectProgress, {\n        progress: info.row.original.progress,\n        taskCount: info.row.original.task_count,\n        closedTaskCount: info.row.original.closed_task_count,\n        compact: true,\n      }),\n  }),\n  columnHelper.display({\n    id: 'menu',\n    header: () => '',\n    // Settings live on the project page, not the table row — only\n    // archive/unarchive is reachable from here.\n    cell: (info) => h(ProjectMenu, { project: info.row.original, hideSettings: true }),\n  }),\n]\n\nconst table = useVueTable({\n  get data() {\n    return props.items\n  },\n  columns,\n  getCoreRowModel: getCoreRowModel(),\n})\n</script>\n\n<template>\n  <div class=\"space-y-2\">\n    <div class=\"rounded-md border\">\n      <Table class=\"table-fixed\">\n        <colgroup>\n          <col class=\"w-[40%]\" />\n          <col class=\"w-[20%]\" />\n          <col class=\"w-[30%]\" />\n          <col class=\"w-[10%]\" />\n        </colgroup>\n        <TableHeader>\n          <TableRow v-for=\"headerGroup in table.getHeaderGroups()\" :key=\"headerGroup.id\">\n            <TableHead v-for=\"header in headerGroup.headers\" :key=\"header.id\" class=\"text-start\">\n              <FlexRender v-if=\"!header.isPlaceholder\" :render=\"header.column.columnDef.header\" :props=\"header.getContext()\" />\n            </TableHead>\n          </TableRow>\n        </TableHeader>\n        <TableBody>\n          <!--\n            Vue Query can finish between the server render and client\n            hydration. Keep the initial table shape deterministic so rows\n            are mounted with their click handlers instead of being patched\n            over SSR skeletons during hydration.\n          -->\n          <template v-if=\"isLoading || !hydrated\">\n            <TableRow v-for=\"n in 5\" :key=\"n\">\n              <TableCell v-for=\"col in columns\" :key=\"col.id\">\n                <Skeleton class=\"h-5 w-full\" />\n              </TableCell>\n            </TableRow>\n          </template>\n          <TableEmpty v-else-if=\"items.length === 0\" :colspan=\"columns.length\">\n            <EmptyState\n              :title=\"t(filtered ? 'projects.filteredEmpty' : archived ? 'projects.archivedEmpty' : 'projects.empty')\"\n              :description=\"t(filtered ? 'projects.filteredEmptyHint' : archived ? 'projects.archivedEmptyHint' : 'projects.emptyHint')\"\n            />\n          </TableEmpty>\n          <template v-else>\n            <TableRow\n              v-for=\"row in table.getRowModel().rows\"\n              :key=\"row.original.id\"\n              class=\"cursor-pointer\"\n              data-testid=\"project-row\"\n              @click=\"hydrated && emit('open', row.original.id)\"\n            >\n              <TableCell v-for=\"cell in row.getVisibleCells()\" :key=\"cell.id\">\n                <FlexRender :render=\"cell.column.columnDef.cell\" :props=\"cell.getContext()\" />\n              </TableCell>\n            </TableRow>\n          </template>\n        </TableBody>\n      </Table>\n    </div>\n    <p v-if=\"capped\" class=\"text-xs text-muted-foreground\">{{ t('projects.capped') }}</p>\n  </div>\n</template>\n"
    },
    {
      "path": "apps/web/app/components/task/TaskDetailPage.vue",
      "hash": "1610d7e7c4a035ecdb83055967e4a1e5047b37354c5a997af418d0e6cb096602",
      "content": "<script setup lang=\"ts\">\nimport { ArrowLeft, ArrowRight } from 'lucide-vue-next'\nimport type { RouteLocationRaw } from 'vue-router'\nimport type { TaskListParams } from '@/composables/useTasks'\nimport TaskDetailPanel from './TaskDetailPanel.vue'\nimport PageHeader from '@/components/shared/PageHeader.vue'\n\nconst props = defineProps<{\n  taskId: number\n  basePath?: string\n  closeTo?: RouteLocationRaw\n  siblingParams?: TaskListParams\n  backLabel?: string\n}>()\n\nconst route = useRoute()\nconst router = useRouter()\nconst { t, localeProperties } = useI18n()\nconst isRtl = computed(() => localeProperties.value.dir === 'rtl')\n\nfunction close() {\n  router.push(props.closeTo ?? { path: '/tasks', query: route.query })\n}\n</script>\n\n<template>\n  <section data-testid=\"task-detail-page\" class=\"mx-auto flex min-h-[calc(100vh-7rem)] w-full max-w-[1440px] flex-col gap-4\">\n    <PageHeader :title=\"t('tasks.detail.pageLabel')\">\n      <template #back>\n        <Button variant=\"ghost\" size=\"sm\" class=\"gap-2 px-2 text-muted-foreground\" type=\"button\" :aria-label=\"props.backLabel ?? t('tasks.detail.back')\" @click=\"close\">\n          <component :is=\"isRtl ? ArrowRight : ArrowLeft\" class=\"size-4\" />\n          {{ props.backLabel ?? t('tasks.detail.back') }}\n        </Button>\n      </template>\n    </PageHeader>\n\n    <div class=\"min-h-0 flex-1 overflow-hidden rounded-xl border bg-card shadow-sm\">\n      <TaskDetailPanel :task-id=\"props.taskId\" :base-path=\"props.basePath\" :sibling-params=\"props.siblingParams\" @close=\"close\" />\n    </div>\n  </section>\n</template>\n"
    },
    {
      "path": "apps/web/app/components/hr/DirectoryTable.vue",
      "hash": "26d8f3f6593f851414562ede7772c4e7adce052a793108994f1e6db7a2b1db4f",
      "content": "<script setup lang=\"ts\">\nimport { FlexRender, createColumnHelper, getCoreRowModel, useVueTable } from '@tanstack/vue-table'\nimport { h } from 'vue'\nimport FilterBar from '@/components/shared/FilterBar.vue'\nimport EmptyState from '@/components/shared/EmptyState.vue'\nimport { Search, X } from 'lucide-vue-next'\nimport { useHrDepartments } from '@/composables/useHrDepartments'\nimport { useHrEmployees, type HrEmployee } from '@/composables/useHrEmployees'\nimport AccessBadge from './AccessBadge.vue'\n\nconst departmentId = defineModel<number | null>('departmentId', { default: null })\nconst emit = defineEmits<{ open: [id: number]; manage: [id: number]; archive: [id: number] }>()\n\nconst { t } = useI18n()\nconst route = useRoute()\nconst router = useRouter()\n// SSR renders the department Select trigger and search input as real,\n// focusable/clickable markup before Nuxt hydrates and attaches reka-ui's\n// listeners; a click in that window is silently dropped (see\n// useHydrated()). Gate both on hydration, same as TaskToolbar.vue.\nconst hydrated = useHydrated()\nconst search = ref(String(route.query.q ?? ''))\nconst archived = ref(route.query.archived === '1')\nconst offset = ref(Math.max(0, Number(route.query.offset ?? 0) || 0))\nconst { can } = useAccess()\nconst canManage = computed(() => can('hr.employees.manage'))\nconst canArchive = computed(() => can('hr.employees.archive'))\n\nconst params = computed(() => ({\n  q: search.value.trim() || undefined,\n  department_id: departmentId.value ?? undefined,\n  archived: archived.value || undefined,\n  limit: 25,\n  offset: offset.value,\n}))\n\nconst { data, isLoading } = useHrEmployees(params)\nconst { data: deptData } = useHrDepartments()\n\nconst items = computed<HrEmployee[]>(() => data.value?.items ?? [])\nconst departments = computed(() => deptData.value?.items ?? [])\nconst selectedDepartment = computed(() => departments.value.find(item => item.id === departmentId.value) ?? null)\nconst hasActiveFilters = computed(() => Boolean(search.value.trim()) || departmentId.value !== null)\nconst page = computed(() => Math.floor(offset.value / 25) + 1)\nconst pages = computed(() => Math.max(1, Math.ceil((data.value?.total ?? 0) / 25)))\n\nwatch(() => [route.query.q, route.query.department_id, route.query.archived, route.query.offset], ([q, department, archivedQuery, nextOffset]) => {\n  search.value = String(q ?? '')\n  const id = typeof department === 'string' ? Number(department) : NaN\n  departmentId.value = Number.isSafeInteger(id) && id > 0 ? id : null\n  archived.value = archivedQuery === '1'\n  offset.value = Math.max(0, Number(nextOffset ?? 0) || 0)\n}, { immediate: true })\nwatch(search, (value) => { if (value !== String(route.query.q ?? '')) updateQuery() })\n\nfunction updateQuery() {\n  offset.value = 0\n  void router.replace({ query: { ...route.query, ...(search.value.trim() ? { q: search.value.trim() } : { q: undefined }), ...(departmentId.value ? { department_id: departmentId.value } : { department_id: undefined }), ...(archived.value ? { archived: '1' } : { archived: undefined }), offset: undefined } })\n}\nfunction setPage(next: number) {\n  if (!hydrated.value || isLoading.value || next < 1 || next > pages.value) return\n  offset.value = (next - 1) * 25\n  void router.replace({ query: { ...route.query, ...(offset.value ? { offset: offset.value } : { offset: undefined }) } })\n}\n\nconst columnHelper = createColumnHelper<HrEmployee>()\nconst columns = [\n  columnHelper.accessor('name', {\n    id: 'name',\n    header: () => t('hr.directory.columns.name'),\n  }),\n  columnHelper.display({\n    id: 'jobTitle',\n    header: () => t('hr.directory.columns.jobTitle'),\n    cell: (info) => info.row.original.job_title || '—',\n  }),\n  columnHelper.display({\n    id: 'department',\n    header: () => t('hr.directory.columns.department'),\n    cell: (info) => info.row.original.department?.name ?? '—',\n  }),\n  columnHelper.display({\n    id: 'manager',\n    header: () => t('hr.directory.columns.manager'),\n    cell: (info) => info.row.original.manager?.name ?? '—',\n  }),\n  columnHelper.display({\n    id: 'access',\n    header: () => t('hr.directory.columns.account'),\n    cell: (info) => h(AccessBadge, { access: info.row.original.access }),\n  }),\n  columnHelper.display({\n    id: 'manage',\n    header: () => canManage.value || canArchive.value ? t('hr.directory.columns.actions') : '',\n    cell: (info) => canManage.value || canArchive.value\n      ? h('div', { class: 'flex gap-1' }, [\n          canManage.value ? h('button', {\n            type: 'button', class: 'rounded-md border px-2 py-1 text-xs hover:bg-accent', disabled: !hydrated.value,\n            'data-testid': 'hr-employee-manage', onClick: (event: Event) => { event.stopPropagation(); emit('manage', info.row.original.id) },\n          }, t('hr.directory.manage')) : null,\n          canArchive.value ? h('button', {\n            type: 'button', class: 'rounded-md border px-2 py-1 text-xs hover:bg-accent', disabled: !hydrated.value,\n            'data-testid': 'hr-employee-archive-row', onClick: (event: Event) => { event.stopPropagation(); emit('archive', info.row.original.id) },\n          }, info.row.original.active ? t('hr.employee.archive') : t('hr.employee.unarchive')) : null,\n        ])\n      : null,\n  }),\n]\n\nconst table = useVueTable({\n  get data() {\n    return items.value\n  },\n  columns,\n  getCoreRowModel: getCoreRowModel(),\n})\n\nfunction onDepartmentChange(value: unknown) {\n  departmentId.value = value === 'all' || !value ? null : Number(value)\n  updateQuery()\n}\nfunction clearFilters() {\n  search.value = ''\n  departmentId.value = null\n  updateQuery()\n}\n</script>\n\n<template>\n  <div class=\"space-y-2\">\n    <FilterBar>\n      <template #search>\n      <div class=\"relative min-w-48 flex-1\">\n        <Search class=\"pointer-events-none absolute start-2 top-1/2 size-4 -translate-y-1/2 text-muted-foreground\" />\n        <Input v-model=\"search\" :disabled=\"!hydrated\" :placeholder=\"t('hr.directory.search')\" class=\"ps-8\" @change=\"updateQuery\" />\n      </div>\n      </template>\n      <template #default>\n      <Button v-if=\"canArchive\" variant=\"outline\" size=\"sm\" :disabled=\"!hydrated\" @click=\"archived = !archived; updateQuery()\">\n        {{ archived ? t('hr.directory.showActive') : t('hr.directory.showArchived') }}\n      </Button>\n      <Select v-if=\"can('hr.departments.read')\" :model-value=\"departmentId ? String(departmentId) : 'all'\" @update:model-value=\"onDepartmentChange\">\n        <SelectTrigger size=\"sm\" class=\"w-48\" :disabled=\"!hydrated\">\n          <SelectValue :placeholder=\"t('hr.directory.allDepartments')\" />\n        </SelectTrigger>\n        <SelectContent>\n          <SelectItem value=\"all\">{{ t('hr.directory.allDepartments') }}</SelectItem>\n          <SelectItem v-for=\"dept in departments\" :key=\"dept.id\" :value=\"String(dept.id)\">{{ dept.name }}</SelectItem>\n        </SelectContent>\n      </Select>\n      </template>\n      <template #active>\n        <div v-if=\"hasActiveFilters\" class=\"flex flex-wrap items-center gap-2\">\n          <Badge v-if=\"search.trim()\" variant=\"secondary\">{{ t('hr.directory.searchValue', { value: search }) }}</Badge>\n          <Badge v-if=\"selectedDepartment\" variant=\"secondary\">{{ selectedDepartment.name }}</Badge>\n          <Button variant=\"ghost\" size=\"sm\" :disabled=\"!hydrated\" @click=\"clearFilters\"><X class=\"size-3.5\" />{{ t('hr.directory.clear') }}</Button>\n        </div>\n      </template>\n    </FilterBar>\n\n    <div class=\"rounded-md border\">\n      <Table>\n        <TableHeader>\n          <TableRow v-for=\"headerGroup in table.getHeaderGroups()\" :key=\"headerGroup.id\">\n            <TableHead v-for=\"header in headerGroup.headers\" :key=\"header.id\" class=\"text-start\">\n              <FlexRender v-if=\"!header.isPlaceholder\" :render=\"header.column.columnDef.header\" :props=\"header.getContext()\" />\n            </TableHead>\n          </TableRow>\n        </TableHeader>\n        <TableBody>\n          <template v-if=\"isLoading\">\n            <TableRow v-for=\"n in 5\" :key=\"n\">\n              <TableCell v-for=\"col in columns\" :key=\"col.id\">\n                <Skeleton class=\"h-5 w-full\" />\n              </TableCell>\n            </TableRow>\n          </template>\n          <TableEmpty v-else-if=\"items.length === 0\" :colspan=\"columns.length\">\n            <EmptyState :title=\"t(hasActiveFilters ? 'hr.directory.filteredEmpty' : 'hr.directory.empty')\" :description=\"hasActiveFilters ? t('hr.directory.filteredEmptyHint') : undefined\">\n              <template v-if=\"hasActiveFilters\" #action><Button size=\"sm\" :disabled=\"!hydrated\" @click=\"clearFilters\">{{ t('hr.directory.clear') }}</Button></template>\n            </EmptyState>\n          </TableEmpty>\n          <template v-else>\n            <TableRow\n              v-for=\"row in table.getRowModel().rows\"\n              :key=\"row.id\"\n              class=\"cursor-pointer\"\n              @click=\"emit('open', row.original.id)\"\n            >\n              <TableCell v-for=\"cell in row.getVisibleCells()\" :key=\"cell.id\" class=\"text-start\">\n                <FlexRender :render=\"cell.column.columnDef.cell\" :props=\"cell.getContext()\" />\n              </TableCell>\n            </TableRow>\n          </template>\n        </TableBody>\n      </Table>\n    </div>\n    <div v-if=\"pages > 1\" class=\"flex items-center justify-between text-sm text-muted-foreground\"><Button variant=\"ghost\" :disabled=\"!hydrated || page === 1 || isLoading\" @click=\"setPage(page - 1)\">{{ t('access.previousPage') }}</Button><span>{{ t('access.pageOf', { page, pages }) }}</span><Button variant=\"ghost\" :disabled=\"!hydrated || page >= pages || isLoading\" @click=\"setPage(page + 1)\">{{ t('access.nextPage') }}</Button></div>\n  </div>\n</template>\n"
    },
    {
      "path": "apps/web/app/components/shared/__tests__/composition.test.ts",
      "hash": "827bf56cd02bd75ba40abcb5cf27549ecd9a5e8af8c503060630fd0fea67d2b7",
      "content": "import { readFileSync } from 'node:fs'\nimport { dirname, resolve } from 'node:path'\nimport { fileURLToPath } from 'node:url'\nimport { compileTemplate, parse } from '@vue/compiler-sfc'\nimport { renderToString } from '@vue/server-renderer'\nimport ts from 'typescript'\nimport * as Vue from 'vue'\nimport { createSSRApp, defineComponent, h, type Component, type RenderFunction, type VNode } from 'vue'\nimport { describe, expect, it } from 'vitest'\n\nconst webRoot = resolve(dirname(fileURLToPath(import.meta.url)), '../../../../')\n\nconst NuxtLinkStub = defineComponent({\n  props: { to: { type: [String, Object], default: '#' } },\n  setup(props, { slots }) {\n    return () => h('a', { href: typeof props.to === 'string' ? props.to : '#' }, slots.default?.())\n  },\n})\n\nfunction loadShared(name: string): Component {\n  const filename = resolve(webRoot, `app/components/shared/${name}.vue`)\n  const source = readFileSync(filename, 'utf8')\n  const parsed = parse(source, { filename })\n  if (parsed.errors.length) throw parsed.errors[0]\n  if (!parsed.descriptor.template) throw new Error(`${name}.vue has no template`)\n\n  const compiled = compileTemplate({\n    source: parsed.descriptor.template.content,\n    filename,\n    id: `shared-${name}`,\n    compilerOptions: { mode: 'function', expressionPlugins: ['typescript'] },\n  })\n  if (compiled.errors.length) throw compiled.errors[0]\n\n  const runnableCode = ts.transpileModule(compiled.code, {\n    compilerOptions: { target: ts.ScriptTarget.ES2020, module: ts.ModuleKind.None },\n  }).outputText\n  const render = new Function('Vue', runnableCode)(Vue) as RenderFunction\n  return defineComponent({\n    name,\n    props: {\n      title: String,\n      description: String,\n      backTo: [String, Object],\n      backLabel: String,\n    },\n    setup(props) {\n      return { props }\n    },\n    render,\n  })\n}\n\nasync function renderShared(\n  name: string,\n  props: Record<string, unknown> = {},\n  slots: Record<string, () => VNode | VNode[]> = {},\n): Promise<string> {\n  const app = createSSRApp({ render: () => h(loadShared(name), props, slots) })\n  app.component('NuxtLink', NuxtLinkStub)\n  return renderToString(app)\n}\n\ndescribe('shared composition rendered contracts', () => {\n  it('renders PageHeader back link, title, description, and actions in order', async () => {\n    const html = await renderShared(\n      'PageHeader',\n      { title: 'Tasks', description: 'Track delivery', backTo: '/tasks', backLabel: 'Back' },\n      {\n        title: () => h('span', { 'data-slot-content': 'title' }, 'Title slot'),\n        actions: () => h('button', { type: 'button' }, 'Create'),\n      },\n    )\n\n    expect(html).toContain('href=\"/tasks\"')\n    expect(html).toContain('Back')\n    expect(html).toContain('Title slot')\n    expect(html).toContain('Track delivery')\n    expect(html).toContain('Create')\n    expect(html.indexOf('Back')).toBeLessThan(html.indexOf('Title slot'))\n    expect(html.indexOf('Title slot')).toBeLessThan(html.indexOf('Create'))\n  })\n\n  it('renders search and controls in the first row, with active filters below and view last in the first row', async () => {\n    const html = await renderShared('FilterBar', {}, {\n      search: () => h('input', { 'aria-label': 'Search' }),\n      default: () => h('button', { type: 'button' }, 'All states'),\n      active: () => h('span', { 'data-filter': 'active' }, 'State: Done'),\n      view: () => h('button', { type: 'button' }, 'Board'),\n    })\n\n    expect(html).toContain('aria-label=\"Search\"')\n    expect(html).toContain('All states')\n    expect(html).toContain('State: Done')\n    expect(html).toContain('Board')\n    const searchMarker = html.indexOf('data-slot=\"search\"')\n    const controlsMarker = html.indexOf('data-slot=\"controls\"')\n    const viewMarker = html.indexOf('data-slot=\"view\"')\n    const activeRowMarker = html.indexOf('data-slot=\"active-row\"')\n    expect(searchMarker).toBeGreaterThanOrEqual(0)\n    expect(controlsMarker).toBeGreaterThan(searchMarker)\n    expect(viewMarker).toBeGreaterThan(controlsMarker)\n    expect(activeRowMarker).toBeGreaterThan(viewMarker)\n  })\n\n  it('renders EmptyState as status with title, description, icon, and action', async () => {\n    const html = await renderShared(\n      'EmptyState',\n      { title: 'No tasks', description: 'Create one to get started' },\n      {\n        icon: () => h('svg', { 'aria-hidden': 'true' }),\n        action: () => h('button', { type: 'button' }, 'Create task'),\n      },\n    )\n\n    expect(html).toMatch(/role=\"status\"/)\n    expect(html).toContain('No tasks')\n    expect(html).toContain('Create one to get started')\n    expect(html).toContain('aria-hidden=\"true\"')\n    expect(html).toContain('Create task')\n  })\n})\n"
    }
  ],
