{
  "name": "web",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "node ../../tools/dev_web.mjs",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:rtl": "npm run build-storybook && playwright test -c playwright.rtl.config.ts",
    "lint": "python3 -B ../../tools/test_slot.py -- vue-tsc --build --noEmit",
    "storybook": "nuxt prepare && storybook dev -p 6006 --no-open",
    "build-storybook": "nuxt prepare && storybook build -o storybook-static"
  },
  "dependencies": {
    "@iconify-json/lucide": "1.2.151",
