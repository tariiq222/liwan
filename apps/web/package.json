    "@liwan/ui": "0.1.0",
    "@nuxt/ui": "4.12.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/vue-query": "^5.105.3",
    "@tanstack/vue-table": "^9.3.1",
    "@tiptap/extension-link": "^3.32.2",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/vue-3": "^3.32.2",
    "@unovis/ts": "^1.7.1",
    "@unovis/vue": "^1.7.1",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
