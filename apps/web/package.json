{
  "name": "web",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:rtl": "npm run build-storybook && playwright test -c playwright.rtl.config.ts",
    "lint": "vue-tsc --build --noEmit",
    "storybook": "nuxt prepare && storybook dev -p 6006 --no-open",
    "build-storybook": "nuxt prepare && storybook build -o storybook-static"
  },
  "dependencies": {
    "@iconify-json/lucide": "1.2.129",
    "@nasq/contracts": "^0.1.0",
    "@nuxt/ui": "4.11.1",
    "@nuxtjs/i18n": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/vue-query": "^5.102.8",
    "@tanstack/vue-table": "^8.21.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/vue-3": "^3.31.3",
    "@unovis/ts": "^1.6.7",
    "@unovis/vue": "^1.6.7",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "nuxt": "^4.5.2",
    "reka-ui": "^2.10.4",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.42",
    "vue-draggable-plus": "^0.6.1",
    "vue-router": "^5.3.0",
    "zod": "^4.5.4",
    "@nasq/commercial-contracts": "0.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/vue3-vite": "10.6.0",
    "@types/node": "^22.20.1",
    "@vitejs/plugin-vue": "6.0.8",
    "msw": "2.15.0",
    "msw-storybook-addon": "3.0.0",
    "storybook": "10.6.0",
    "typescript": "^5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
