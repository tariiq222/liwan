# Edge block for the vendor admin host. Add it next to the customer block of deploy/Caddyfile (or import it); it changes no
# existing block. The BFF in apps/vendor-admin signs every call to the control plane and overwrites x-nasq-client-ip itself.
{$ADMIN_DOMAIN} {
	encode zstd gzip

	# No request logging here: cookies and query strings of the admin console must never reach a log. Caddy logs nothing
	# unless a `log` directive is added, so none is declared on purpose.

	# Same cap as the BFF and the control plane (64 KiB); larger bodies are refused with 413 before reaching the app.
	request_body {
		max_size 64KB
	}

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		Content-Security-Policy "frame-ancestors 'none'"
		# Every response of the admin host, assets included, is private: nothing is cached by a browser or a proxy.
		Cache-Control "no-store"
		-Server
	}

	route {
		rate_limit {
			zone nasq_admin {
				key {remote_host}
				events 120
				window 1m
				ipv6_prefix 64
			}
			# Sign-in, enrollment and step-up: same budget as the customer auth zone in deploy/Caddyfile.
			zone nasq_admin_auth {
				match {
					path /api/auth/* /api/vendor/v1/admin/auth/*
				}
				key {remote_host}
				events 20
				window 1m
				ipv6_prefix 64
			}
		}
		reverse_proxy vendor-admin:3100 {
			# Set after Connection-nominated fields are stripped; never append. The BFF reads only X-Forwarded-For (trustProxy).
			header_up X-Forwarded-For {remote_host}
		}
	}
}
