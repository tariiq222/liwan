# Edge block for the vendor console host. deploy/docker-compose.shared-commercial.yml mounts this file into the proxy and
# deploy/shared/Caddyfile imports it, so there is one copy. The same overlay joins the edge to the console's `admin_edge`
# network (LIWAN_ADMIN_EDGE_NETWORK) and passes ADMIN_DOMAIN and LIWAN_ADMIN_ALLOW. The upstream is the `vendor-console`
# service of deploy/control-plane/compose.production.yml (plain HTTP on that internal network).
#
# Who may reach the console: LIWAN_ADMIN_ALLOW is the operator's client-address allowlist (`client_ip` syntax: CIDRs or bare
# addresses). It has no default on purpose, like LIWAN_RESTORE_ALLOW: unset or empty answers 404 for everyone, so the console
# is never exposed by forgetting to set it. It matches `client_ip`, not `remote_ip`: with no trusted proxy that is the socket
# peer, so a header cannot claim an allowed address; behind an outer edge (LIWAN_TRUSTED_PROXIES) the real client is matched.
# The allowlist is decided before anything reaches the upstream and sits on top of the console's own sign-in.
#
# The scheme prefix and the reserved default follow the other optional sites of the shared Caddyfile: an unset ADMIN_DOMAIN
# leaves a site that matches no real host. It has its own reserved name because invalid.invalid is the TikTok relay default
# and control-webhook.invalid the webhook's, and two equal site addresses are ambiguous. Behind an outer edge
# (LIWAN_SITE_SCHEME=http://) that forwards any Host, the reserved name could still reach this site, so it answers 404.
{$LIWAN_SITE_SCHEME:}{$ADMIN_DOMAIN:vendor-admin.invalid} {
	encode zstd gzip

	# No request logging here: cookies and query strings of the admin console must never reach a log. Caddy logs nothing
	# unless a `log` directive is added, so none is declared on purpose.

	# Same cap as the BFF and the control plane (64 KiB); larger bodies are refused with 413 before reaching the app.
	request_body {
		max_size 64KB
	}

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		# Pages carry the app's own nonce-based policy (apps/vendor-admin/server/plugins/content-security-policy.ts);
		# `?` keeps it and gives every other response (API JSON, assets) a policy that loads nothing.
		?Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		# Every response of the admin host is private: nothing is cached by a browser or a proxy, except the hashed
		# build assets below. Documents, API answers and build metadata stay `no-store`.
		Cache-Control "no-store"
		-Server
	}

	# The console's build assets are the only cacheable responses. Their names carry the content hash and change with
	# every release, so a stored copy can never be stale: the document that names them stays `no-store`, and a release
	# is picked up on the next document load. Without this the browser may not store them, Nuxt's own prefetch hints
	# (one per route chunk in the HTML of the sign-in page) are downloaded and thrown away, and the same files are
	# fetched again on the first navigation.
	# `private` keeps the browser as the only holder: no shared proxy stores the console's code, and the assets carry
	# no tenant data. `/_nuxt/builds/` is excluded: `latest.json` keeps its name while its content changes with every build.
	@buildAssets {
		path /_nuxt/*
		not path /_nuxt/builds/*
	}
	header @buildAssets {
		# A successful body and a revalidation answer are both worth storing. A 304 is a complete answer on its own:
		# the deferred value below replaces the headers of the 304, and a `no-store` there would make the browser drop
		# the copy it just proved valid. A 404 after a release is not matched, so it is never kept.
		match status 2xx 304
		# `>` defers the write to the moment the response is sent, so this value replaces the blanket `no-store`
		# above whatever the upstream sent.
		>Cache-Control "private, max-age=31536000, immutable"
	}

	# Refuse every request whose Host is not exactly the configured console host (case-folded). Caddy applies a
	# `{$VAR:default}` default only to an UNSET variable: handed an empty string, the site address above has no host, and this
	# comparison then matches nothing real and refuses every request. A reserved name or any other Host is refused the same way.
	@reserved expression `string({http.request.host}).lowerAscii() != "{$ADMIN_DOMAIN:vendor-admin.invalid}".lowerAscii() || string({http.request.host}).lowerAscii() == "vendor-admin.invalid"`
	@notOperator not client_ip {$LIWAN_ADMIN_ALLOW}

	# `handle` blocks are mutually exclusive and evaluated in order, so the host and the allowlist are decided before any
	# request reaches the upstream (a bare `respond` beside the proxy would be reordered by Caddy's directive sort).
	handle @reserved {
		respond 404
	}
	handle @notOperator {
		respond 404
	}
	handle {
		rate_limit {
			zone liwan_admin {
				key {client_ip}
				# One budget for the console's documents, API answers and build assets. The customer UI's own zone
				# (liwan_web in deploy/Caddyfile) allows 600 for the same traffic. A measured cold sign-in took 121
				# requests (89 for the sign-in page, 32 for the first page after it) and the 121st was refused at 120.
				# Caching the assets (see @buildAssets) removes the re-downloads among those 32, but the first page load
				# still needs about 90, so the budget keeps a margin for a second tab or a reload.
				events 600
				window 1m
				ipv6_prefix 64
			}
			# Sign-in, enrollment and step-up: same budget as the customer auth zone in deploy/Caddyfile. The module
			# counts a request in every zone whose matcher accepts it, so these requests also draw from the zone above.
			zone liwan_admin_auth {
				match {
					path /api/auth/* /api/vendor/v1/admin/auth/*
				}
				key {client_ip}
				events 20
				window 1m
				ipv6_prefix 64
			}
		}
		reverse_proxy vendor-console:3100 {
			# The BFF (trustProxy) reads only X-Forwarded-For and takes its first entry. It is set to `{client_ip}`, never
			# appended: an address the browser sent cannot reach it, and behind an outer edge it is the real client.
			header_up X-Forwarded-For {client_ip}
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Proto
			header_up -Forwarded
			header_up -X-Liwan-Proxy-Token
			header_up -X-Liwan-Tenant-Revision
			header_up -X-Liwan-Client-Ip
			header_up -X-Liwan-Signup-Client
		}
	}
}
