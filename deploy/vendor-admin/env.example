# Environment of the vendor admin app (apps/vendor-admin). Names and placeholders only: keep real values in a private
# runtime file or secret store, never in Git or in chat. Keys map to the private runtimeConfig keys named in each comment.
# Control plane base URL (controlUrl); https outside loopback.
NUXT_CONTROL_URL=https://control.example.internal:4187
# Service key (serviceKey): at least 32 bytes, equal to the control plane CONTROL_SERVICE_KEY.
NUXT_SERVICE_KEY=
# Installation id (installationId): equal to the control plane CONTROL_INSTALLATION_ID.
NUXT_INSTALLATION_ID=
# Public origin of this app (adminOrigin): the https origin of the `admin` host; equal to the control plane ADMIN_ORIGIN.
NUXT_ADMIN_ORIGIN=https://admin.example.com
# Trust X-Forwarded-For from the edge (trustProxy). The edge snippet overwrites it; the BFF overwrites x-nasq-client-ip.
NUXT_TRUST_PROXY=true
PORT=3100
HOST=0.0.0.0
