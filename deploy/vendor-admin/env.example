# Private environment of the vendor console (service vendor-console in deploy/control-plane/compose.production.yml). Copy it to
# LIWAN_VENDOR_ADMIN_ENV_FILE (mode 0600, owned by root, outside the repository). Plain KEY=value lines. Names and placeholders
# only; [SECRET] marks a secret and it has no value here. Keys map to the private runtimeConfig keys named in each comment.
# The console answers 503 on every route when a required value is missing or unsafe.

# ---- Required ----
# Control API base URL (controlUrl): https, the service name on the network that joins console and API.
NUXT_CONTROL_URL=https://control-api:4187
# [SECRET] (serviceKey) At least 32 bytes, equal to CONTROL_SERVICE_KEY of the control plane.
NUXT_SERVICE_KEY=
# (installationId) Equal to CONTROL_INSTALLATION_ID.
NUXT_INSTALLATION_ID=liwan-vendor
# (adminOrigin) The https origin of the admin host; equal to ADMIN_ORIGIN of the control plane.
NUXT_ADMIN_ORIGIN=https://admin.example.com
# (trustProxy) Must be true behind the https edge; the console answers 503 otherwise. The edge overwrites X-Forwarded-For.
NUXT_TRUST_PROXY=true

# ---- Server ----
PORT=3100
HOST=0.0.0.0
# Local development only, never in production: shows the development sign-in buttons.
# NUXT_PUBLIC_DEV_LOGIN=false
# Build-time debugging switch, not read at run time.
# LIWAN_HYDRATION_DEBUG=0
# Set by the Compose file (the private CA of the control API certificate): NODE_EXTRA_CA_CERTS=/run/secrets/control_ca
