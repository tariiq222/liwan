DB_PASSWORD=change-me
ODOO_ADMIN_PASSWORD=change-me
VENDOR_PASSWORD=change-me
# Required for dedicated provisioning. Use the mailbox for the vendor administrator’s sign-in code.
# Configure Odoo outgoing SMTP and email_from (or mail.default.from) before the first interactive sign-in.
VENDOR_EMAIL=
# Required for provisioning only: absolute local path, explicit per-database classification.
# See docs/verification/cp1-provisioning.md; do not store the real mapping in Git.
LIWAN_COMMERCIAL_CONFIG=/absolute/operator-owned/classification.json
# Secret storage master key (urlsafe base64 of 32 bytes) for every secret LiwanOS keeps encrypted at rest:
# Customer Inbox channel tokens and payment gateway (Paymob) keys. Each database and purpose derives its own
# key from it. Without it, saving a channel's or a payment gateway's secrets fails. The name is historical.
# Generate: python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
LIWAN_INBOX_SECRET_KEY=
# TikTok Business Messaging app (operator configuration, never per channel).
# A direct (non-SaaS) deployment points its own app at https://$DOMAIN; the callback route is
# /api/v1/inbox/tiktok/callback. Shared hosting sets them from LIWAN_TIKTOK_RELAY_HOST instead.
LIWAN_TIKTOK_CLIENT_KEY=
LIWAN_TIKTOK_CLIENT_SECRET=
LIWAN_TIKTOK_REDIRECT_URI=
