DB_PASSWORD=change-me
ODOO_ADMIN_PASSWORD=change-me
VENDOR_PASSWORD=change-me
# Required for provisioning only: absolute local path, explicit per-database classification.
# See docs/verification/cp1-provisioning.md; do not store the real mapping in Git.
WEBVUE_COMMERCIAL_CONFIG=/absolute/operator-owned/classification.json
# Customer Inbox master key (urlsafe base64 of 32 bytes); each database derives its own key from it.
# Without it, saving a channel's provider secrets fails. Generate: python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
WEBVUE_INBOX_SECRET_KEY=
