[options]
; Rendered by deploy/stack/render.py from the env file and deploy/odoo_sizing.py, then validated by
; deploy/shared/validate_odoo_config.py before it is used. The result holds secrets: never commit it.
; Every double-brace placeholder is filled or the render stops; a key the template does not use stops it too.
data_dir = /var/lib/odoo
db_host = db
db_user = odoo
db_password = {{DB_PASSWORD}}
admin_passwd = {{LIWAN_ODOO_ADMIN_PASSWD}}
dbfilter = ^%h$
list_db = False
server_wide_modules = base,rpc,web,liwan_shared_dbselect
proxy_mode = False
workers = {{ODOO_WORKERS}}
max_cron_threads = {{ODOO_MAX_CRON_THREADS}}
db_maxconn = {{ODOO_DB_MAXCONN}}
limit_memory_soft = {{ODOO_LIMIT_MEMORY_SOFT}}
limit_memory_hard = {{ODOO_LIMIT_MEMORY_HARD}}
