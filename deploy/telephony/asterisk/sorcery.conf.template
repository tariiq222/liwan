; Rendered by deploy/telephony/render.py from the company's env file (company {{COMPANY_ID}}).
; PJSIP realtime is listed first and static pjsip.conf second for endpoint, auth and aor: ARI dynamic writes land in
; PostgreSQL (extconfig.conf -> res_pgsql.conf -> pbx-db), while static objects (transports, plain SIP 103, trunk)
; still load from pjsip.conf.

[res_pjsip]
endpoint=realtime,ps_endpoints
endpoint=config,pjsip.conf,criteria=type=endpoint
auth=realtime,ps_auths
auth=config,pjsip.conf,criteria=type=auth
aor=realtime,ps_aors
aor=config,pjsip.conf,criteria=type=aor
