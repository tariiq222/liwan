; Rendered by deploy/telephony/render.py from the company's env file. Dynamic internal extension routing (PJSIP
; realtime plus static 103), the trunk in both directions, SIP REFER blind transfer context, MixMonitor named by the
; channel's linkedid under the company's recording policy read from pbx-db, the recording announcement Dial plays to
; the party that answers, and a spoken "not available" when the line is busy, unreachable or inside a move window
; (design 4.2, 4.3, 12.2). No IVR or queues yet: they are absent on purpose, not stubbed (README, "Not in this
; package yet").

[general]
static=yes
writeprotect=yes
clearglobalvars=no

[globals]
; The control plane flips LINE_STATE to `moving` for the length of a company move, and a new caller then hears the
; unavailable message instead of a ring (design 12.2).
LINE_STATE={{LINE_STATE}}
RECORDINGS_DIR=/var/spool/asterisk/monitor
; A sound name from /var/lib/asterisk/sounds; `ss-noservice` ships with Asterisk, and a company prompt can be dropped
; in beside it and named here.
UNAVAILABLE_SOUND={{UNAVAILABLE_SOUND}}
; Played to the party that answers when the company's recording config asks for the announcement: `[record-call]` turns
; it into Dial's `A()` option, which Asterisk plays to the called party once the call is answered. Asterisk ships no
; "being recorded" prompt, so this names a company prompt dropped in beside the stock sounds.
RECORDING_ANNOUNCE_SOUND={{RECORDING_ANNOUNCE_SOUND}}
TRUNK_CALLER_ID={{TRUNK_CALLER_ID}}
TRUNK_DIAL_PREFIX={{TRUNK_DIAL_PREFIX}}

[from-extension]
; Digits-only guard (fail-closed: any non-digit or expression parse error lands in reject).
; Any existing PJSIP extension (realtime in pbx-db or static in pjsip.conf) routes to internal.
; Short digit strings (< 7 digits) never leave the PBX to the external trunk: an offline or
; unregistered internal extension hears the unavailable prompt instead of dialling the PSTN.
; Longer digit strings (7+ digits) that are not a local endpoint route to outbound, and E.164
; numbers (`_+X.`, at least 7 digits after `+`) route to outbound.
exten => _X.,1,GotoIf($["${FILTER(0-9,${EXTEN})}"="${EXTEN}"]?allow:reject)
 same => n(allow),GotoIf($["${DEVICE_STATE(PJSIP/${EXTEN})}"!="INVALID"]?internal,${EXTEN},1:check-length)
 same => n(check-length),GotoIf($[${LEN(${EXTEN})}>=7]?outbound,${EXTEN},1:unavailable)
 same => n(unavailable),Gosub(line-unavailable,s,1)
 same => n,Hangup()
 same => n(reject),Hangup()
exten => _+X.,1,GotoIf($["${FILTER(0-9,${EXTEN:1})}"="${EXTEN:1}"]?allow:reject)
 same => n(allow),GotoIf($[${LEN(${EXTEN})}>=8]?outbound,${EXTEN},1:reject)
 same => n(reject),Hangup()

[internal]
; Digits-only fail-closed guard before any Dial: `_X.` matches characters after the first digit, so `&`, `/` or an
; expression-breaking character lands in `reject`.
exten => _X.,1,GotoIf($["${FILTER(0-9,${EXTEN})}"="${EXTEN}"]?allow:reject)
 same => n(allow),NoOp(Internal call from ${CALLERID(num)} to ${EXTEN})
 same => n,Set(__TRANSFER_CONTEXT=from-extension)
 same => n,GotoIf($["${LINE_STATE}"="available"]?dial)
 same => n,Gosub(line-unavailable,s,1)
 same => n,Hangup()
 same => n(dial),Gosub(record-call,s,1)
 same => n,Dial(PJSIP/${EXTEN},30${RECORDING_ANNOUNCE_OPTION})
 same => n,GotoIf($["${DIALSTATUS}"="ANSWER"]?done)
 same => n,Gosub(line-unavailable,s,1)
 same => n(done),Hangup()
 same => n(reject),Hangup()

[outbound]
; The dialled number, with the provider's prefix when it wants one; the plus of an E.164 number is kept as dialled.
; `_X.` and `_+X.` match any character after the first, so `&` or `/` reaches this context and `Dial` would read it as
; another destination (a second number, or another endpoint that then receives the trunk's digest). `_X.` must be
; digits only (at least 7 digits) and `_+X.` must be a single leading `+` followed by digits only (at least 7 digits
; after `+`). Every guard is fail-closed so any unexpected character or expression parse error lands in `reject`.
exten => _X.,1,GotoIf($["${FILTER(0-9,${EXTEN})}"="${EXTEN}"]?allow:reject)
 same => n(allow),GotoIf($[${LEN(${EXTEN})}>=7]?dial:reject)
 same => n(dial),Set(DIAL_NUMBER=${TRUNK_DIAL_PREFIX}${EXTEN})
 same => n,Goto(dial-outbound,s,1)
 same => n(reject),Hangup()
exten => _+X.,1,GotoIf($["${FILTER(0-9,${EXTEN:1})}"="${EXTEN:1}"]?allow:reject)
 same => n(allow),GotoIf($[${LEN(${EXTEN})}>=8]?dial:reject)
 same => n(dial),Set(DIAL_NUMBER=${TRUNK_DIAL_PREFIX}${EXTEN})
 same => n,Goto(dial-outbound,s,1)
 same => n(reject),Hangup()

[dial-outbound]
exten => s,1,NoOp(Outbound call to ${DIAL_NUMBER})
 same => n,Set(__TRANSFER_CONTEXT=from-extension)
 same => n,GotoIf($["${LINE_STATE}"="available"]?dial)
 same => n,Gosub(line-unavailable,s,1)
 same => n,Hangup()
 same => n(dial),Set(CALLERID(num)=${TRUNK_CALLER_ID})
 same => n,Gosub(record-call,s,1)
 same => n,Dial(PJSIP/${DIAL_NUMBER}@trunk,60${RECORDING_ANNOUNCE_OPTION})
 same => n,GotoIf($["${DIALSTATUS}"="ANSWER"]?done)
 same => n,Gosub(line-unavailable,s,1)
 same => n(done),Hangup()

[from-trunk]
; The provider may send the Contact user it registered (`s` when the contact has no user), a DID without the plus, or
; a full E.164 number with it. Every DID rings 101 in phase 1: routing by number is a phase-2 setting (design 5).
exten => s,1,Gosub(inbound-call,s,1(${EXTEN}))
 same => n,Hangup()
exten => _X.,1,Gosub(inbound-call,s,1(${EXTEN}))
 same => n,Hangup()
exten => _+X.,1,Gosub(inbound-call,s,1(${EXTEN}))
 same => n,Hangup()
; Anything else the provider addresses to the registered contact (a letter-starting username, say) rings 101 as well
; in phase 1. The pattern needs at least two characters, so the single-character special extensions cannot reach it.
exten => _[a-zA-Z].,1,Gosub(inbound-call,s,1(${EXTEN}))
 same => n,Hangup()
; The exact h wins over every pattern above: a pattern that matched it would re-enter inbound-call and ring 101 on
; every hangup, a phantom call and a phantom leg in Odoo.
exten => h,1,NoOp()

[inbound-call]
exten => s,1,NoOp(Inbound call from ${CALLERID(num)} to ${ARG1})
 same => n,Set(__TRANSFER_CONTEXT=from-extension)
 same => n,GotoIf($["${LINE_STATE}"="available"]?ring)
 same => n,Gosub(line-unavailable,s,1)
 same => n,Return()
 same => n(ring),Gosub(record-call,s,1)
 same => n,Dial(PJSIP/101,30${RECORDING_ANNOUNCE_OPTION})
 same => n,GotoIf($["${DIALSTATUS}"="ANSWER"]?done)
 same => n,Gosub(line-unavailable,s,1)
 same => n(done),Return()

; The policy is the single row of `liwan_recording_config`, read through extconfig ([settings]) so the setting in the
; company's database decides it, tenant-wide, and this static dialplan carries no default: `always` records both
; legs of a bridged call and `off` records nothing. The row is read once per call: REALTIME_HASH() is a single
; ast_load_realtime_all() of the record matched on its fixed id, and HASH() exposes every field of that one snapshot,
; so `policy` and `announce` always come from the same read and neither can be a value the other did not see. Both
; fields are validated before MixMonitor runs: only `always` records, and only `t` or `f` is a readable announce. A
; missing row, a database that is unreachable, a policy the schema does not allow and an announce that is absent,
; empty or otherwise unknown therefore record nothing, so no call is ever recorded without a configured policy or
; without the notice it may owe. ClearHash runs first, because HASH() keys live on the channel: a repeat on the same
; channel starts from no keys and cannot answer from a previous row's fields. `announce` is a
; PostgreSQL boolean, whose realtime value is `t` or `f`; when it is `t` the caller sets RECORDING_ANNOUNCE_OPTION to
; Dial's `A()` argument, and each `Dial` in this file appends it to its timeout so Asterisk plays the file to the
; party that answers. A `Playback` here would run before the called party has answered, so only the caller would hear
; it. The option is cleared first, so a call this context does not record never carries a stale announcement. The
; file is named by the channel's linkedid, the call key every event is matched on (design 4.4, 4.5), read with
; CHANNEL(linkedid): there is no plain linkedid channel variable. The recorder starts before `Dial` so the file
; exists under the linkedid as recording begins and the recorder runs before the legs bridge, missing no audio;
; `b` captures bridged audio only, so ringback is absent. Whether a call that is never answered leaves a file,
; and whether that file is empty, is not verified here: the live acceptance run settles it (README).
[record-call]
exten => s,1,Set(RECORDING_ANNOUNCE_OPTION=)
 same => n,ClearHash(RECORDING_CONFIG)
 same => n,Set(HASH(RECORDING_CONFIG)=${REALTIME_HASH(liwan_recording_config,id,1)})
 same => n,GotoIf($["${HASH(RECORDING_CONFIG,policy)}"!="always"]?done)
 same => n,GotoIf($["${HASH(RECORDING_CONFIG,announce)}"="f"]?start)
 same => n,GotoIf($["${HASH(RECORDING_CONFIG,announce)}"!="t"]?done)
 same => n,Set(RECORDING_ANNOUNCE_OPTION=,A(${RECORDING_ANNOUNCE_SOUND}))
 same => n(start),MixMonitor(${RECORDINGS_DIR}/${CHANNEL(linkedid)}.wav,b)
 same => n(done),Return()

; Busy, unreachable or moving: answer, play the message, return; the caller hangs up with the line. Answering first
; creates the media path to the browser or to the provider, which a ringing channel has not opened yet.
[line-unavailable]
exten => s,1,Answer()
 same => n,Playback(${UNAVAILABLE_SOUND})
 same => n,Return()
