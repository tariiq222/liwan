# Environment file of one company's telephony package (deploy/telephony/compose.yml and its Asterisk and coturn
# templates). Names and placeholders only: copy it to a root-only file on the host (mode 0600, outside the checkout) and
# fill it in there. No value here is a secret and none may become one, this file is tracked. Every variable is documented
# in README.md; the values below describe a local acceptance run, not a production company.

# --- The company and its names (design 12.3, 12.8) ---
# The company tag: it names the package's networks, volumes and TURN realm, and is never reused after a drop.
LIWAN_TELEPHONY_COMPANY_ID=acme
# The company host that opens LiwanOS and carries /ws through the shared edge; the edge part reads this name, and the
# agent binds recording tokens to it.
LIWAN_TELEPHONY_HOST_NAME=acme.liwan.example
# The company's own SIP name for mode-b devices only. It resolves to this package's host (or its dedicated address) with
# a 60 second TTL and does not serve /ws; the DNS part creates and moves it.
LIWAN_TELEPHONY_SIP_DNS_NAME=sip.acme.liwan.example

# --- The host (design 12.3) ---
# The static public IPv4 of the package host. Every published port binds this address and nothing else, and coturn
# advertises it. A reserved test address is safe to render with and cannot be bound: replace it before `up`.
LIWAN_TELEPHONY_STATIC_ADDRESS=192.0.2.10
# The company's own SIP port on that address: one per company per public address, never a shared 5060.
LIWAN_TELEPHONY_SIP_PORT=5062
# The company's fixed RTP block, unique on the address and never overlapping another company's block or the TURN relay
# range below.
LIWAN_TELEPHONY_RTP_START=40100
LIWAN_TELEPHONY_RTP_END=40200

# --- The line: the company's provider (D4, section 13) ---
# `ip` means the provider authenticates this host by address, so the SIP port is published as well; `credentials` means
# Asterisk registers with a username and password and the SIP port stays closed. The RTP block is published in both
# modes (design 12.3); in `credentials` mode whether the provider's inbound INVITE reaches it is a phase-1 line test.
LIWAN_TELEPHONY_TRUNK_AUTH=credentials
# true when the company runs devices that register into Liwan (a gateway, or a softphone during the acceptance run), so
# the SIP port is published for them too.
LIWAN_TELEPHONY_MODE_B_DEVICES=true
LIWAN_TELEPHONY_TRUNK_HOST=sip.provider.example
LIWAN_TELEPHONY_TRUNK_PORT=5060
LIWAN_TELEPHONY_TRUNK_USERNAME=REPLACE_WITH_PROVIDER_SIP_USERNAME
LIWAN_TELEPHONY_TRUNK_PASSWORD=REPLACE_WITH_PROVIDER_SIP_PASSWORD
# The From user the provider assigned; it also becomes the registration Contact user. The provider may show it instead
# of the caller id below: which one it uses is a phase-1 line check (README).
LIWAN_TELEPHONY_TRUNK_FROM_USER=REPLACE_WITH_PROVIDER_FROM_USER
# The number the dialplan sets as the caller id on outbound calls, as the provider expects it. In the credentials mode it
# is also the registration's Contact user, the number the provider returns calls to.
LIWAN_TELEPHONY_TRUNK_CALLER_ID=REPLACE_WITH_OUTBOUND_NUMBER
# Digits the provider requires before every dialled number (empty when it wants the number as dialled).
LIWAN_TELEPHONY_TRUNK_DIAL_PREFIX=
# The codecs the provider accepts, lowercase and comma separated.
LIWAN_TELEPHONY_TRUNK_CODECS=ulaw,alaw

# --- The company in Odoo (design 12.5) ---
# The company database name the agent carries in every event; a letter, then lowercase letters, digits or underscore.
LIWAN_TELEPHONY_DATABASE=liwan_acme

# --- The PBX (design 11.2) ---
# The ARI user pbx-agent signs in with; it is a section name in ari.conf, so letters, digits, "_" and "-" only.
LIWAN_TELEPHONY_ARI_USER=liwan-agent
LIWAN_TELEPHONY_ARI_PASSWORD=REPLACE_WITH_GENERATED_ARI_PASSWORD
# Password for this company's PostgreSQL 16 PJSIP realtime database (pbx-db / telephony_pbx). Must contain no
# whitespace, ";", "#" or "'".
LIWAN_TELEPHONY_PBX_DB_PASSWORD=REPLACE_WITH_GENERATED_PBX_DB_PASSWORD

# --- The three test extensions (design 13, phase 1) ---
# 101 and 102 are the browser (WebRTC) extensions seeded into pbx-db (PJSIP realtime) on first boot; 103 stays static
# in pjsip.conf as a plain SIP extension for a softphone such as Linphone, whose default settings offer no ICE,
# DTLS-SRTP or rtcp-mux.
LIWAN_TELEPHONY_EXTENSION_101_PASSWORD=REPLACE_WITH_GENERATED_EXTENSION_101_PASSWORD
LIWAN_TELEPHONY_EXTENSION_102_PASSWORD=REPLACE_WITH_GENERATED_EXTENSION_102_PASSWORD
LIWAN_TELEPHONY_EXTENSION_103_PASSWORD=REPLACE_WITH_GENERATED_EXTENSION_103_PASSWORD

# --- TURN and browser sessions (design 3, 4.1, 12.3) ---
# true when this package runs its own coturn (non_saas, or a standalone acceptance run); false when the host's shared
# coturn serves the browser leg in the shared SaaS deployment (D2), and then no TURN port is published.
LIWAN_TELEPHONY_TURN_PUBLISHED=true
LIWAN_TELEPHONY_TURN_PORT=3478
# The TURN relay block: as many ports as concurrent browser sessions need, disjoint from the RTP block above.
LIWAN_TELEPHONY_TURN_MIN_PORT=40201
LIWAN_TELEPHONY_TURN_MAX_PORT=40250
# The TURN REST secret, at least 32 characters. pbx-agent mints each browser session's temporary HMAC credentials from
# it (design 4.1), and coturn verifies them with the same secret.
LIWAN_TELEPHONY_TURN_SECRET=REPLACE_WITH_GENERATED_TURN_REST_SECRET
# Optional STUN and TURN URLs returned to browser sessions (leave empty when unused). Must start with stun:/stuns: or
# turn:/turns: when set.
LIWAN_TELEPHONY_STUN_URL=stun:192.0.2.10:3478
LIWAN_TELEPHONY_TURN_URL=turn:192.0.2.10:3478
# Per-session browser credential lifetime (30..120) and previous-credential overlap window (0..60, strictly less than
# session seconds).
LIWAN_TELEPHONY_SESSION_SECONDS=120
LIWAN_TELEPHONY_SESSION_OVERLAP_SECONDS=30
# Native ceilings: a browser session's allocations, the instance's allocations, and one session's bandwidth in bytes per
# second (0 removes the bandwidth ceiling).
LIWAN_TELEPHONY_TURN_USER_QUOTA=4
LIWAN_TELEPHONY_TURN_TOTAL_QUOTA=100
LIWAN_TELEPHONY_TURN_MAX_BPS=800000

# --- Events to Odoo (design 4.5, 12.6) ---
# The route as this package host reaches it: the private address of the app hosts in the shared deployment (12.3), the
# public tenant host only when no private path exists. It is not necessarily the browser's URL.
LIWAN_TELEPHONY_EVENTS_URL=https://odoo.internal.example/api/v1/telephony/events
# The company's two derived keys, computed on the shared side from LIWAN_TELEPHONY_KEY and written here once. The root
# key never exists on a PBX host.
LIWAN_TELEPHONY_EVENTS_KEY=REPLACE_WITH_DERIVED_EVENTS_KEY
LIWAN_TELEPHONY_REVERSE_KEY=REPLACE_WITH_DERIVED_REVERSE_KEY

# --- Behaviour (design 7, 12.2) ---
# `available` lets calls through; `moving` answers every new caller with the unavailable message during a company move.
LIWAN_TELEPHONY_LINE_STATE=available
# `always`, `on_demand` (only when the product asks for it) or `off`.
LIWAN_TELEPHONY_RECORDING_POLICY=always
# Days a recording is kept once retention deletion lands (phase 4, design 4.4). Today the render validates the value and
# nothing reads it; no component deletes a file yet.
LIWAN_TELEPHONY_RECORDING_RETENTION_DAYS=90
# The free-space floor the agent's health report compares the recordings volume against, in bytes (0 removes the floor).
LIWAN_TELEPHONY_RECORDINGS_MIN_FREE_BYTES=536870912
# Seconds between the agent's CEL comparisons (30 to 86400); a lost event is recovered on the next pass (design 4.6).
LIWAN_TELEPHONY_RECONCILE_SECONDS=300
# The sound played when a line is busy, unreachable or moving. `ss-noservice` ships with Asterisk; a company prompt can
# be put beside it under its own name.
LIWAN_TELEPHONY_UNAVAILABLE_SOUND=ss-noservice

# --- The release image (written by the release path, never typed) ---
LIWAN_IMAGE_TAG=REPLACE_WITH_RELEASE_IMAGE_TAG
