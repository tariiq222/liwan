# LiwanOS AI is optional and off by default. To enable it add these to deploy/.env and start with
# COMPOSE_PROFILES=ai. Without COMPOSE_PROFILES=ai the ai service does not exist and /ai stays hidden.
COMPOSE_PROFILES=ai
NUXT_AI_SERVICE_URL=http://ai:8600
# LiwanOS AI provider for this deployment: anthropic, openai, ollama or openrouter (AI_MODEL is the OpenRouter model id then,
# AI_API_KEY is required). Sovereign customers use ollama with a local AI_BASE_URL.
# Optional, openrouter only (attribution headers HTTP-Referer and X-Title): AI_OPENROUTER_REFERER, AI_OPENROUTER_TITLE.
AI_PROVIDER=ollama
AI_MODEL=qwen2.5:7b
AI_BASE_URL=http://ollama:11434
AI_API_KEY=
AI_OPENROUTER_REFERER=
AI_OPENROUTER_TITLE=
AI_RUN_RETENTION_DAYS=30
# AI_DB_PASSWORD and AI_SERVICE_TOKEN are generated by `deploy/ai/ensure_secrets.sh` when `deploy/provision.sh`
# runs with COMPOSE_PROFILES=ai (64 hex characters, deploy/.env mode 600). Their values are never printed.
# Do not rotate them casually: the token is shared by `web` and `ai`, so rotating it needs both restarted
# together; the password is used by the `liwan_ai` role on a fresh db volume (and by AI_DATABASE_URL).
# Used by the liwan_ai database role; it must stay URL-safe because it is placed inside AI_DATABASE_URL.
AI_DB_PASSWORD=
# REQUIRED: the service refuses to start without it (docker-compose.yml passes it through).
# Its own database URL for the liwan_ai role: user liwan_ai, host db, port 5432, database liwan_ai, using the secret above.
# (kept out of docker-compose.yml so no password name sits next to a literal in a tracked file).
AI_DATABASE_URL=
# The service database above holds release control state only. Each tenant's AI state lives in schema
# liwan_ai inside that tenant's own database: docker-compose.yml sets LIWAN_TENANCY_MODE=dedicated and
# AI_TENANT_DATABASE=${DB_NAME}; docker-compose.shared.yml switches to the tenant registry.
# REQUIRED, shared secret between web and ai, min 24 characters (generated by ensure_secrets.sh).
AI_SERVICE_TOKEN=
