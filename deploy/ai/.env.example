# WebVue AI is optional and off by default. To enable it add these to deploy/.env and start with
# COMPOSE_PROFILES=ai. Without COMPOSE_PROFILES=ai the ai service does not exist and /ai stays hidden.
COMPOSE_PROFILES=ai
NUXT_AI_SERVICE_URL=http://ai:8600
# WebVue AI provider for this deployment: anthropic, openai, ollama or openrouter (AI_MODEL is the OpenRouter model id then,
# AI_API_KEY is required). Sovereign customers use ollama with a local AI_BASE_URL.
# Optional, openrouter only (attribution headers HTTP-Referer and X-Title): AI_OPENROUTER_REFERER, AI_OPENROUTER_TITLE.
AI_PROVIDER=ollama
AI_MODEL=qwen2.5:7b
AI_BASE_URL=http://ollama:11434
AI_API_KEY=
AI_OPENROUTER_REFERER=
AI_OPENROUTER_TITLE=
AI_RUN_RETENTION_DAYS=30
# Generate with: openssl rand -hex 24 (must be URL-safe: it is placed inside AI_DATABASE_URL).
# Used by the webvue_ai database role on a fresh db volume only.
AI_DB_PASSWORD=
# REQUIRED: the service refuses to start without it (docker-compose.yml passes it through).
# Its own database URL for the webvue_ai role: user webvue_ai, host db, port 5432, database webvue_ai, using the secret above.
# (kept out of docker-compose.yml so no password name sits next to a literal in a tracked file).
AI_DATABASE_URL=
# Shared secret between web and ai, min 24 chars. Generate with: openssl rand -hex 32
AI_SERVICE_TOKEN=
