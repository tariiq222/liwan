# Copy via init-local.sh. This file contains names/references only; generated synthetic credentials live only in the private runtime home.
LIWAN_CONTROL_HOME=/tmp/liwan-saas-control-local
LIWAN_REPOSITORY_ROOT=/path/to/liwan
LIWAN_NODE_BIN=/path/to/node/bin
LIWAN_CONTROL_DB_PASSWORD_FILE=/tmp/liwan-saas-control-local/control-db-password
LIWAN_CONTROL_SERVICE_KEY_FILE=/tmp/liwan-saas-control-local/control-service-key
LIWAN_CONTROL_INVENTORY=/tmp/liwan-saas-control-local/inventory-v2.json
LIWAN_CONTROL_STATE_DIR=/tmp/liwan-saas-control-local/operator-state
LIWAN_CONTROL_LOG_DIR=/tmp/liwan-saas-control-local/logs
CONTROL_INSTALLATION_ID=liwan-local-management
CONTROL_HOST=127.0.0.1
CONTROL_PORT=14179
CONTROL_DATABASE_URL_FILE=/tmp/liwan-saas-control-local/control-database-url
LIWAN_CLI_PYTHON=/path/to/odoo/.venv/bin/python

# Vendor admin sign-in (apps/vendor-admin). Set these in the private runtime environment; sign-in is off without ADMIN_SECRET_KEY.
# ADMIN_SECRET_KEY: at least 32 bytes and distinct from CONTROL_SERVICE_KEY, CUSTOMER_COMMERCIAL_SERVICE_KEY and INTERNAL_EFFECT_KEY.
# ADMIN_RP_ID: the host name of the admin origin (WebAuthn relying party id), for example admin.example.com.
# ADMIN_ORIGIN: the https origin of the vendor admin app (loopback http only with ADMIN_RP_ID=localhost); equals NUXT_ADMIN_ORIGIN there.
# ADMIN_DEV_LOGIN_EMAIL: local development only, never set it in production. It opens a sign-in without passkey or authenticator
# for that one account; the control plane refuses to start unless ADMIN_ORIGIN is http loopback, CONTROL_HOST is loopback and NODE_ENV is not production.
ADMIN_RP_ID=admin.example.com
ADMIN_ORIGIN=https://admin.example.com

# Days from issuing an invoice to its due date (0-90, default 7). Dunning and the overdue lists count from the due date.
# LIWAN_INVOICE_DUE_DAYS=7

# Public shared SaaS signup. Off by default. Configure SMTP on the API process as well as the worker.
# LIWAN_TENANCY_MODE=shared
# In shared mode run-local.sh starts the shared worker too (the commercial scheduler and the
# tenant status push to Odoo). Both paths are required and must be absolute.
# LIWAN_SHARED_RUNTIME_CONFIG=/absolute/path/shared-runtime.json
# LIWAN_TENANT_REGISTRY_PATH=/absolute/path/registry.json
# LIWAN_PUBLIC_SIGNUP=true
# LIWAN_SIGNUP_PLAN_REVISION_ID=<published-public-monthly-revision-with-14-trial-days>
# LIWAN_SIGNUP_AUTHENTICA_KEY is a private Liwan-specific credential, not a shared app key.
# LIWAN_SIGNUP_AUTHENTICA_TEMPLATE_ID=<approved-sms-template-id>
# LIWAN_SIGNUP_DAILY_LIMIT=100
# The legal pages the sign-up form links to (<base>/terms and <base>/privacy, <base>/en/... in English) and the terms
# version stored with each acceptance. Both are required; change the version whenever the lawyer updates the texts.
# LIWAN_SIGNUP_LEGAL_BASE_URL=https://liwanos.com
# LIWAN_SIGNUP_TERMS_VERSION=2026-11-01
# Cloudflare Turnstile bot check on the sign-up start step. Both are required; create a managed widget for the app
# domain in the Cloudflare dashboard. The site key is public (the page receives it); the secret stays on this process.
# LIWAN_SIGNUP_TURNSTILE_SITE_KEY=<turnstile-site-key>
# LIWAN_SIGNUP_TURNSTILE_SECRET_KEY=<turnstile-secret-key>
# CUSTOMER_COMMERCIAL_ISSUER must match the web BFF, distinct from CONTROL_INSTALLATION_ID.
# CUSTOMER_COMMERCIAL_SERVICE_KEY is a private BFF signing key, distinct from CONTROL_SERVICE_KEY.
# LIWAN_MAIL_SMTP_HOST, LIWAN_MAIL_SMTP_PORT, LIWAN_MAIL_FROM and any required SMTP credentials.

# Control plane database backup (deploy/control-plane/backup-control-plane.sh). Not read by the control plane itself.
# It is the same pipeline, bucket, passphrase and retention as the tenant backups (deploy/OPERATIONS.md), with the
# source name "control-plane". Set these in the scheduler's private environment, never in this repository.
# LIWAN_CONTROL_BACKUP_DB_NAME: the control plane database ("liwan_control" in the local harness).
# LIWAN_CONTROL_BACKUP_PG_DUMP: absolute path of a pg_dump matching the server's major version.
# LIWAN_CONTROL_BACKUP_WORK_ROOT: absolute private staging directory with room for the dump, the archive and its ciphertext.
# LIWAN_CONTROL_BACKUP_PG_HOST / _PG_PORT / _PG_USER: optional; use a role that can read every table (pg_read_all_data).
#   The password is never an argument: point PGPASSFILE at a mode 0600 file.
# LIWAN_CONTROL_BACKUP_STORE_ROOT: optional local directory used instead of the bucket (drills only).
# Also required, as for tenant backups: LIWAN_BACKUP_S3_ENDPOINT, LIWAN_BACKUP_S3_REGION, LIWAN_BACKUP_S3_BUCKET,
# LIWAN_BACKUP_S3_ACCESS_KEY, LIWAN_BACKUP_S3_SECRET_KEY and LIWAN_BACKUP_PASSPHRASE_FILE (mode 0600 or 0400), plus the
# LIWAN_ALERT_* channels of deploy/alerts.py.
# LIWAN_CONTROL_BACKUP_DB_NAME=liwan_control
# LIWAN_CONTROL_BACKUP_PG_DUMP=/usr/lib/postgresql/16/bin/pg_dump
# LIWAN_CONTROL_BACKUP_WORK_ROOT=/var/lib/liwan-control-backup
# LIWAN_CONTROL_BACKUP_PG_HOST=127.0.0.1
# LIWAN_CONTROL_BACKUP_PG_USER=liwan_control_backup
