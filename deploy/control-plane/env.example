# Copy via init-local.sh. This file contains names/references only; generated synthetic credentials live only in the private runtime home.
WEBVUE_CONTROL_HOME=/tmp/webvue-saas-control-local
WEBVUE_REPOSITORY_ROOT=/Users/tariq/code/webvue-saas-control-runtime
WEBVUE_NODE_BIN=/opt/homebrew/opt/node@22/bin
WEBVUE_CONTROL_DB_PASSWORD_FILE=/tmp/webvue-saas-control-local/control-db-password
WEBVUE_CONTROL_SERVICE_KEY_FILE=/tmp/webvue-saas-control-local/control-service-key
WEBVUE_CONTROL_INVENTORY=/tmp/webvue-saas-control-local/inventory-v2.json
WEBVUE_CONTROL_STATE_DIR=/tmp/webvue-saas-control-local/operator-state
WEBVUE_CONTROL_LOG_DIR=/tmp/webvue-saas-control-local/logs
CONTROL_INSTALLATION_ID=webvue-local-management
CONTROL_HOST=127.0.0.1
CONTROL_PORT=14179
CONTROL_DATABASE_URL_FILE=/tmp/webvue-saas-control-local/control-database-url
WEBVUE_CLI_PYTHON=/Users/tariq/code/odoo/.venv/bin/python

# Vendor admin sign-in (apps/vendor-admin). Set these in the private runtime environment; sign-in is off without ADMIN_SECRET_KEY.
# ADMIN_SECRET_KEY: at least 32 bytes and distinct from CONTROL_SERVICE_KEY, CUSTOMER_COMMERCIAL_SERVICE_KEY and INTERNAL_EFFECT_KEY.
# ADMIN_RP_ID: the host name of the admin origin (WebAuthn relying party id), for example admin.example.com.
# ADMIN_ORIGIN: the https origin of the vendor admin app (loopback http only with ADMIN_RP_ID=localhost); equals NUXT_ADMIN_ORIGIN there.
# ADMIN_DEV_LOGIN_EMAIL: local development only, never set it in production. It opens a sign-in without passkey or authenticator
# for that one account; the control plane refuses to start unless ADMIN_ORIGIN is http loopback, CONTROL_HOST is loopback and NODE_ENV is not production.
ADMIN_RP_ID=admin.example.com
ADMIN_ORIGIN=https://admin.example.com
