# systemd unit that runs the host alert for the vendor console's services (service_health_alert.py) once per start; the timer
# next to it starts it every minute. It reads the control database directly through a read-only role, so it still alerts when
# the control API and liwan-shared-worker.service are both down, and it needs neither of them (no Requires=, no After=).
#
# Example, not an installer. Adjust the /opt/liwan/current prefix to the host; keep the shape. Install:
#   install -m 0644 deploy/control-plane/liwan-service-health-alert.service deploy/control-plane/liwan-service-health-alert.timer /etc/systemd/system/
#   install -m 0600 deploy/control-plane/service-health-alert.env.example /etc/liwan/service-health-alert.env   # then fill it in
#   systemctl daemon-reload
#   systemctl enable --now liwan-service-health-alert.timer
#
# Prerequisites this unit does not create:
#   * /etc/liwan/service-health-alert.env, operator-owned, mode 0600, plain KEY=value lines (see the example file): the database
#     name and read-only role, the PGPASSFILE, and the LIWAN_ALERT_* channels (the same keys the release env file holds). Values
#     never go in this unit file.
#   * `psql` on the host, and a role with pg_read_all_data (the control plane backup role does).
# State: systemd gives it /var/lib/liwan-service-health (StateDirectory); it holds the file of what was already announced.
[Unit]
Description=Liwan vendor console service health alert
Documentation=file:///opt/liwan/current/docs/operations/control-plane-deployment.md

[Service]
Type=oneshot
EnvironmentFile=/etc/liwan/service-health-alert.env
ExecStart=/usr/bin/python3 -B /opt/liwan/current/deploy/control-plane/service_health_alert.py
StateDirectory=liwan-service-health
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
TimeoutStartSec=120
