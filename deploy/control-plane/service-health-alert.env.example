# /etc/liwan/service-health-alert.env: the EnvironmentFile of liwan-service-health-alert.service (host process).
# Plain KEY=value lines, mode 0600. [SECRET] marks a secret; none has a value here. No value belongs in this repository.

# ---- The control database, through a role of its own ----
# liwan_control_health holds LOGIN and EXECUTE on service_health_states(timestamptz) and nothing else: it cannot read a table, so this
# host holds no read credential for the control plane's data (the backup role is NOT used here). The operator creates it once, after
# the control API has migrated: see step A6.3 of docs/operations/environment-bringup.md.
LIWAN_CONTROL_HEALTH_DB_NAME=liwan_control
LIWAN_CONTROL_HEALTH_PG_HOST=127.0.0.1
LIWAN_CONTROL_HEALTH_PG_PORT=15432
LIWAN_CONTROL_HEALTH_PG_USER=liwan_control_health
# Optional: the psql binary when it is not on PATH.
# LIWAN_CONTROL_HEALTH_PSQL=/usr/lib/postgresql/16/bin/psql
# The password is never an argument: this file (mode 0600) holds it in the usual pgpass format. [SECRET file]
PGPASSFILE=/etc/liwan/service-health.pgpass

# ---- What was already announced ----
# Optional: systemd's STATE_DIRECTORY (/var/lib/liwan-service-health) is used when this is unset.
# LIWAN_SERVICE_HEALTH_STATE_FILE=/var/lib/liwan-service-health/service-health-alert.json

# ---- Alert channels: the keys of deploy/alerts.py, with the same values as the release env file ----
# One complete channel is enough; a channel with only some of its keys is refused.
LIWAN_ALERT_SMTP_HOST=
LIWAN_ALERT_SMTP_FROM=
LIWAN_ALERT_SMTP_TO=
# LIWAN_ALERT_SMTP_PORT=587
# LIWAN_ALERT_SMTP_USER=
# [SECRET]
# LIWAN_ALERT_SMTP_PASSWORD=
# [SECRET]
LIWAN_ALERT_TELEGRAM_BOT_TOKEN=
LIWAN_ALERT_TELEGRAM_CHAT_ID=
