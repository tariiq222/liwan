# Private environment of the control plane processes in compose.production.yml (control-api, control-migrate, control-worker,
# control-admin). Copy it to LIWAN_CONTROL_ENV_FILE (mode 0600, owned by root, outside the repository). Plain KEY=value lines, no
# quotes and no `export`: Compose and systemd read the same syntax. Names and placeholders only; every secret is marked [SECRET]
# and has no value here. The host's shared worker reads deploy/control-plane/shared-worker.env.example, which repeats the same
# values for the groups it needs; keep the two in step (one source: generate both from the same operator secret store).
#
# Values compose.production.yml already sets (do not repeat them here): LIWAN_TENANCY_MODE=shared, LIWAN_REPOSITORY_ROOT,
# LIWAN_CLI_INVENTORY, LIWAN_CLI_STATE_DIR, LIWAN_SHARED_RUNTIME_CONFIG, LIWAN_TENANT_REGISTRY_PATH, CONTROL_HOST, CONTROL_PORT,
# CONTROL_TLS_KEY, CONTROL_TLS_CERT. They are listed below, commented, so the file documents every name the code reads.

# ---- 1. Required to start (the process exits at start without them) ----
NODE_ENV=production
# [SECRET] The URL carries the database password; the same password is in the control_db_password secret file.
CONTROL_DATABASE_URL=
CONTROL_INSTALLATION_ID=liwan-vendor
# [SECRET] At least 32 bytes. The vendor console holds the same value as NUXT_SERVICE_KEY.
CONTROL_SERVICE_KEY=
# LIWAN_CLI_INVENTORY=/etc/liwan-control/inventory-v2.json
# LIWAN_CLI_STATE_DIR=/var/lib/liwan-control/state
# LIWAN_REPOSITORY_ROOT=/app
# LIWAN_TENANCY_MODE=shared
# LIWAN_SHARED_RUNTIME_CONFIG=/etc/liwan-control/shared-runtime.json
# LIWAN_TENANT_REGISTRY_PATH=/var/lib/liwan/registry/registry.json
# CONTROL_HOST=0.0.0.0
# CONTROL_PORT=4187
# CONTROL_TLS_KEY=/run/secrets/control_tls_key
# CONTROL_TLS_CERT=/run/secrets/control_tls_cert
# Optional: the Python used for the catalog check; the image has python3.
# LIWAN_CLI_PYTHON=python3
# Optional: the dedicated-mode inventory of managed targets. Unused in shared mode.
# LIWAN_MANAGED_INVENTORY=
# Optional: where the platform AI provider file is written for the shared AI service. Unset: the choice is stored, not delivered.
# LIWAN_AI_PLATFORM_PROVIDER_PATH=/var/lib/liwan-control/state/ai-platform/platform-provider.json

# ---- 2. Vendor console sign-in (off without ADMIN_SECRET_KEY: nobody can sign in to the console) ----
# [SECRET] At least 32 bytes, distinct from every other key in this file.
ADMIN_SECRET_KEY=
ADMIN_RP_ID=admin.example.com
ADMIN_ORIGIN=https://admin.example.com
# ADMIN_DEV_LOGIN_EMAIL is for local development only. NEVER set it in production; the control plane refuses it there.
# ADMIN_DEV_LOGIN_EMAIL=

# ---- 3. Tenant web tier and public sign-up ----
# The web tier signs with these; the issuer must differ from CONTROL_INSTALLATION_ID.
CUSTOMER_COMMERCIAL_ISSUER=liwan-web
# [SECRET] At least 32 bytes, different from CONTROL_SERVICE_KEY. The web tier holds the same value.
CUSTOMER_COMMERCIAL_SERVICE_KEY=
# The channel from the API to the shared worker for the administrator password. Unset: every invitation acceptance answers 503.
# [SECRET] Distinct from the two keys above.
INTERNAL_EFFECT_KEY=
INTERNAL_EFFECT_URL=https://control-host.internal:4188
INTERNAL_EFFECT_CA=/run/secrets/control_ca
# Listener side (shared worker only, see shared-worker.env.example).
# INTERNAL_EFFECT_HOST=172.29.40.1
# INTERNAL_EFFECT_PORT=4188
# INTERNAL_EFFECT_TLS_KEY=
# INTERNAL_EFFECT_TLS_CERT=
LIWAN_PUBLIC_SIGNUP=false
# The published public monthly plan revision with 14 trial days.
LIWAN_SIGNUP_PLAN_REVISION_ID=
# [SECRET] Authentica key used only for the sign-up SMS; not the sign-in key of Odoo.
LIWAN_SIGNUP_AUTHENTICA_KEY=
LIWAN_SIGNUP_AUTHENTICA_TEMPLATE_ID=
LIWAN_SIGNUP_DAILY_LIMIT=100
LIWAN_SIGNUP_LEGAL_BASE_URL=https://www.example.com
LIWAN_SIGNUP_TERMS_VERSION=2026-11-01
LIWAN_SIGNUP_TURNSTILE_SITE_KEY=
# [SECRET] Cloudflare Turnstile secret; sign-up stays off without both Turnstile values.
LIWAN_SIGNUP_TURNSTILE_SECRET_KEY=

# ---- 4. Billing and payments ----
# moyasar in production. `simulator` is refused when NODE_ENV=production.
LIWAN_PAYMENT_PROVIDER=moyasar
# test or live; live needs the owner's explicit production authorization.
MOYASAR_MODE=test
# [SECRET]
MOYASAR_SECRET_KEY=
# Needed for card payments through the form; hosted invoices, renewals and refunds work without it. Public by design (the browser needs it).
# pk_test_ with MOYASAR_MODE=test, pk_live_ with live; a mismatch disables the payment adapter at boot.
MOYASAR_PUBLISHABLE_KEY=
# Leave empty. Set to `open` only while registering the webhook at the provider, then remove it again: it lets the provider's one-time
# registration event in without the shared secret (see the commercial runbook, section 4.2).
MOYASAR_WEBHOOK_REGISTRATION=
# [SECRET] At least 32 bytes; also entered in the Moyasar webhook settings as the secret token.
MOYASAR_WEBHOOK_SECRET=
MOYASAR_ACCOUNT_NAME=
# Comma-separated allowlist of origins a payment may return to (https://app.example.com or https://*.example.com).
LIWAN_PAYMENT_RETURN_ORIGINS=https://app.example.com
# Shared mode: where a payer with no workspace yet returns. Must be one of the origins above.
LIWAN_PAYMENT_PROSPECT_ORIGIN=https://app.example.com
# Days from issuing an invoice to its due date (0-90).
LIWAN_INVOICE_DUE_DAYS=7

# ---- 5. Mail and customer notices (billing, cancellation, trial and delay notices, invitations, sign-up email) ----
LIWAN_MAIL_MODE=smtp
LIWAN_MAIL_SMTP_HOST=smtp.example.com
LIWAN_MAIL_SMTP_PORT=587
LIWAN_MAIL_FROM=no-reply@example.com
LIWAN_MAIL_REQUIRE_TLS=true
LIWAN_MAIL_SMTP_USER=
# [SECRET]
LIWAN_MAIL_SMTP_PASSWORD=

# ---- 6. Scheduler pacing (shared worker only; the defaults are right for production) ----
# LIWAN_COMMERCIAL_BILLING_INTERVAL_SEC=300
# LIWAN_COMMERCIAL_USAGE_INTERVAL_SEC=300
# LIWAN_COMMERCIAL_RECONCILE_EVERY=10

# Final deletion of a customer's workspace (kill switch, shared worker). Off by default: while it is not exactly `true` the runner records the plan and
# "would do" lines only and never runs a destructive effect. Turn it on only after a live scratch-tenant drop has passed.
LIWAN_TENANT_DELETION_ENABLED=false

# ---- 7. Owner alerts (shared worker) ----
LIWAN_VENDOR_ALERT_EMAIL_TO=owner@example.com
# [SECRET] One bot serves these alerts and deploy/alerts.py.
LIWAN_ALERT_TELEGRAM_BOT_TOKEN=
LIWAN_ALERT_TELEGRAM_CHAT_ID=
# off, 0, false or no switches a channel off while keeping its settings.
# LIWAN_VENDOR_ALERT_EMAIL=off
# LIWAN_VENDOR_ALERT_TELEGRAM=off

# ---- 8. Release routing, passed on to the effect children by the worker (leave unset unless the shared runbook says otherwise) ----
# LIWAN_RELEASE_ROUTES_DIR=
# LIWAN_RELEASE_HELPER_POOL_ID=

# ---- 9. Database backup (deploy/control-plane/backup-control-plane.sh, run by the operator's scheduler, not by these services) ----
# Documented in env.example; set them in the scheduler's own private environment.
