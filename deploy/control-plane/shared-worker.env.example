# /etc/liwan/shared-worker.env: the EnvironmentFile of liwan-shared-worker.service (host process, not a container).
# Plain KEY=value lines, mode 0600, owner root. [SECRET] marks a secret; none has a value here. The groups the worker needs are
# the same as in env.production.example and must carry the SAME values; only the database address and the file paths differ
# because this process runs on the host.

# ---- Required to start ----
LIWAN_TENANCY_MODE=shared
LIWAN_SHARED_RUNTIME_CONFIG=/etc/liwan-control/shared-runtime.json
LIWAN_TENANT_REGISTRY_PATH=/var/lib/liwan/registry/registry.json
# [SECRET] Loopback port published by compose.host-link.yml.
CONTROL_DATABASE_URL=
CONTROL_INSTALLATION_ID=liwan-vendor
# [SECRET]
CONTROL_SERVICE_KEY=
LIWAN_CLI_INVENTORY=/etc/liwan-control/inventory-v2.json
LIWAN_CLI_STATE_DIR=/var/lib/liwan-control/state
LIWAN_REPOSITORY_ROOT=/opt/liwan/current
NODE_ENV=production
# LIWAN_CLI_PYTHON=python3
# LIWAN_MANAGED_INVENTORY=

# ---- Internal effect channel (listener) ----
# [SECRET]
INTERNAL_EFFECT_KEY=
INTERNAL_EFFECT_HOST=172.29.40.1
INTERNAL_EFFECT_PORT=4188
INTERNAL_EFFECT_TLS_KEY=/etc/liwan-control/effect-tls.key
INTERNAL_EFFECT_TLS_CERT=/etc/liwan-control/effect-tls.crt

# ---- Same values as env.production.example (copy, do not invent) ----
CUSTOMER_COMMERCIAL_ISSUER=liwan-web
# [SECRET]
CUSTOMER_COMMERCIAL_SERVICE_KEY=
ADMIN_ORIGIN=https://admin.example.com
LIWAN_PAYMENT_PROVIDER=moyasar
MOYASAR_MODE=test
# [SECRET]
MOYASAR_SECRET_KEY=
# Needed for card payments through the form. Public by design. pk_test_ with MOYASAR_MODE=test, pk_live_ with live.
MOYASAR_PUBLISHABLE_KEY=
# Leave empty; see env.production.example.
MOYASAR_WEBHOOK_REGISTRATION=
# [SECRET]
MOYASAR_WEBHOOK_SECRET=
MOYASAR_ACCOUNT_NAME=
LIWAN_PAYMENT_RETURN_ORIGINS=https://app.example.com
LIWAN_PAYMENT_PROSPECT_ORIGIN=https://app.example.com
LIWAN_INVOICE_DUE_DAYS=7
LIWAN_MAIL_MODE=smtp
LIWAN_MAIL_SMTP_HOST=smtp.example.com
LIWAN_MAIL_SMTP_PORT=587
LIWAN_MAIL_FROM=no-reply@example.com
LIWAN_MAIL_REQUIRE_TLS=true
LIWAN_MAIL_SMTP_USER=
# [SECRET]
LIWAN_MAIL_SMTP_PASSWORD=
LIWAN_VENDOR_ALERT_EMAIL_TO=owner@example.com
# [SECRET]
LIWAN_ALERT_TELEGRAM_BOT_TOKEN=
LIWAN_ALERT_TELEGRAM_CHAT_ID=
# Final deletion of a customer's workspace (kill switch). Off by default: while it is not exactly `true` the runner records the plan and "would do"
# lines only and never runs a destructive effect. Turn it on only after a live scratch-tenant drop has passed (docs/operations/saas-commercial-runbook.md 4.4.1).
LIWAN_TENANT_DELETION_ENABLED=false
# The off-site purge reads the bucket from LIWAN_BACKUP_S3_* (as the backup pipeline does); a filesystem store for an acceptance drill:
# LIWAN_TENANT_DELETION_OFFSITE_STORE_ROOT=/var/lib/liwan-control/state/offsite-drill
# LIWAN_AI_PLATFORM_PROVIDER_PATH=/var/lib/liwan-control/state/ai-platform/platform-provider.json
# LIWAN_COMMERCIAL_BILLING_INTERVAL_SEC=300
# LIWAN_COMMERCIAL_USAGE_INTERVAL_SEC=300
# LIWAN_COMMERCIAL_RECONCILE_EVERY=10
# LIWAN_VENDOR_ALERT_EMAIL=off
# LIWAN_VENDOR_ALERT_TELEGRAM=off
# LIWAN_RELEASE_ROUTES_DIR=
# LIWAN_RELEASE_HELPER_POOL_ID=
