{
  "schema_version": 3,
  "descriptor_grammar": "limit:key | limit:key:<int> | boolean:key",
  "id": "platform_v4",
  "name": "liwan Platform",
  "description": "Release 1 composition: tasks, chat, meetings, documents, operations and the AI assistant join the always-included platform base; CRM and customer messages are the only applications sold. Every other application is installed in every tenant and locked by entitlement. Earlier catalog revisions remain unchanged.",
  "industry": "none",
  "base_modules": [
    "liwan_core",
    "liwan_platform",
    "liwan_api"
  ],
  "tiers": [
    {
      "id": "core",
      "name": "Core",
      "description": "Base modules and the always-included applications: the platform, its capability catalog, the shared API, tasks, chat, meetings, documents, operations, the AI assistant and the tenant's own payment gateway connection.",
      "modules": [
        "liwan_ai",
        "liwan_chat",
        "liwan_documents",
        "liwan_meetings",
        "liwan_operations",
        "liwan_payments",
        "liwan_tasks"
      ],
      "features": [
        "limit:users.limit",
        "limit:storage.limit_mb",
        "limit:branches.extra_limit:0",
        "boolean:tasks.enabled",
        "boolean:chat.enabled",
        "boolean:meetings.enabled",
        "boolean:documents.enabled",
        "boolean:operations.enabled",
        "boolean:ai.enabled",
        "boolean:ai.knowledge",
        "limit:ai.messages.monthly",
        "limit:ai.tool_calls.per_run",
        "limit:ai.tokens.monthly",
        "limit:ai.assist.monthly:300",
        "limit:ai.output_tokens.per_run",
        "boolean:payments.enabled"
      ]
    },
    {
      "id": "crm",
      "name": "CRM",
      "description": "The CRM application.",
      "sellable": true,
      "modules": [
        "liwan_crm"
      ],
      "features": [
        "boolean:crm.enabled",
        "boolean:crm.import",
        "boolean:crm.export"
      ]
    },
    {
      "id": "inbox",
      "name": "Customer Inbox",
      "description": "The Customer Inbox application: WhatsApp and TikTok customer messages.",
      "sellable": true,
      "modules": [
        "liwan_inbox",
        "liwan_inbox_payments"
      ],
      "features": [
        "boolean:inbox.enabled",
        "boolean:inbox.whatsapp",
        "boolean:inbox.tiktok",
        "boolean:inbox.templates",
        "boolean:inbox.automation",
        "boolean:inbox.flows",
        "boolean:inbox.reports",
        "boolean:inbox.catalog",
        "boolean:inbox.campaigns",
        "limit:inbox.channels",
        "limit:inbox.messages_out",
        "limit:inbox.campaign_recipients"
      ]
    },
    {
      "id": "projects",
      "name": "Projects",
      "description": "The project management application.",
      "sellable": false,
      "modules": [
        "liwan_pmo"
      ],
      "features": [
        "boolean:pmo.enabled",
        "boolean:pmo.change_control",
        "boolean:pmo.baselines",
        "boolean:pmo.evm",
        "limit:projects.max_projects"
      ]
    },
    {
      "id": "people",
      "name": "People",
      "description": "The HR application.",
      "sellable": false,
      "modules": [
        "liwan_hr"
      ],
      "features": [
        "boolean:hr.enabled",
        "boolean:hr.recruitment",
        "boolean:hr.shifts",
        "boolean:hr.onboarding",
        "boolean:hr.offboarding",
        "boolean:hr.assets",
        "boolean:hr.warnings",
        "boolean:hr.insurance",
        "boolean:hr.payroll"
      ]
    },
    {
      "id": "finance",
      "name": "Finance",
      "description": "The Finance application: Saudi accounting over Odoo accounting.",
      "sellable": false,
      "modules": [
        "liwan_finance"
      ],
      "features": [
        "boolean:finance.enabled"
      ]
    },
    {
      "id": "integrations",
      "name": "Saudi integrations",
      "description": "Status of the live ZATCA and bank links on the dedicated settings page.",
      "sellable": false,
      "modules": [
        "liwan_integrations_sa"
      ],
      "features": [
        "boolean:integrations.enabled"
      ]
    },
    {
      "id": "appointments",
      "name": "Appointments",
      "description": "The Appointments application.",
      "sellable": false,
      "modules": [
        "liwan_appointments"
      ],
      "features": [
        "boolean:appointments.enabled"
      ]
    }
  ]
}
