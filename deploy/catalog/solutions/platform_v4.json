{
  "schema_version": 3,
  "descriptor_grammar": "limit:key | limit:key:<int> | boolean:key",
  "id": "platform_v4",
  "name": "webvue Platform",
  "description": "Operations application release revision; earlier catalog revisions remain unchanged.",
  "industry": "none",
  "base_modules": [
    "webvue_core",
    "webvue_platform",
    "webvue_api"
  ],
  "tiers": [
    {
      "id": "core",
      "name": "Core",
      "description": "Base modules only: the platform, its capability catalog and the shared API.",
      "modules": [],
      "features": [
        "limit:users.limit",
        "limit:storage.limit_mb",
        "limit:branches.extra_limit:0"
      ]
    },
    {
      "id": "projects",
      "name": "Projects",
      "description": "The project and meeting applications.",
      "modules": [
        "webvue_pmo",
        "webvue_meetings"
      ],
      "features": [
        "boolean:pmo.enabled",
        "boolean:meetings.enabled",
        "limit:projects.max_projects"
      ]
    },
    {
      "id": "people",
      "name": "People",
      "description": "The HR application.",
      "modules": [
        "webvue_hr"
      ],
      "features": [
        "boolean:hr.enabled",
        "boolean:hr.recruitment",
        "boolean:hr.shifts",
        "boolean:hr.onboarding",
        "boolean:hr.offboarding",
        "boolean:hr.assets",
        "boolean:hr.payroll"
      ]
    },
    {
      "id": "finance",
      "name": "Finance",
      "description": "The Finance application: Saudi accounting over Odoo accounting.",
      "modules": [
        "webvue_finance"
      ],
      "features": [
        "boolean:finance.enabled"
      ]
    },
    {
      "id": "integrations",
      "name": "Saudi integrations",
      "description": "Status of the live ZATCA and bank links on the dedicated settings page.",
      "modules": [
        "webvue_integrations_sa"
      ],
      "features": [
        "boolean:integrations.enabled"
      ]
    },
    {
      "id": "payments",
      "name": "Online payments",
      "description": "The tenant's own payment gateway account, connected from the payments settings page.",
      "modules": [
        "webvue_payments"
      ],
      "features": [
        "boolean:payments.enabled"
      ]
    },
    {
      "id": "messaging",
      "name": "Messaging",
      "description": "The member-private chat application.",
      "modules": [
        "webvue_chat"
      ],
      "features": [
        "boolean:chat.enabled"
      ]
    },
    {
      "id": "tasks",
      "name": "Tasks",
      "description": "Personal and team tasks that need no project.",
      "modules": [
        "webvue_tasks"
      ],
      "features": [
        "boolean:tasks.enabled"
      ]
    },
    {
      "id": "operations",
      "name": "Operations",
      "description": "The Operations application.",
      "modules": [
        "webvue_operations"
      ],
      "features": [
        "boolean:operations.enabled"
      ]
    },
    {
      "id": "assistant",
      "name": "WebVue AI",
      "description": "The WebVue AI assistant: tool registry, audit log and message limits.",
      "modules": [
        "webvue_ai"
      ],
      "features": [
        "boolean:ai.enabled",
        "limit:ai.messages.monthly",
        "limit:ai.tool_calls.per_run"
      ]
    },
    {
      "id": "documents",
      "name": "Documents",
      "description": "The Documents application.",
      "modules": [
        "webvue_documents"
      ],
      "features": [
        "boolean:documents.enabled"
      ]
    },
    {
      "id": "crm",
      "name": "CRM",
      "description": "The CRM application.",
      "modules": [
        "webvue_crm"
      ],
      "features": [
        "boolean:crm.enabled",
        "boolean:crm.import",
        "boolean:crm.export"
      ]
    },
    {
      "id": "appointments",
      "name": "Appointments",
      "description": "The Appointments application.",
      "modules": [
        "webvue_appointments"
      ],
      "features": [
        "boolean:appointments.enabled"
      ]
    },
    {
      "id": "inbox",
      "name": "Customer Inbox",
      "description": "The Customer Inbox application.",
      "modules": [
        "webvue_inbox"
      ],
      "features": [
        "boolean:inbox.enabled",
        "boolean:inbox.whatsapp",
        "limit:inbox.channels",
        "limit:inbox.messages_out"
      ]
    }
  ]
}
