# Names and safe placeholders only for the staging definition
# (`deploy/staging/docker-compose.staging.yml`). Copy it to a private file outside
# Git (for example `deploy/staging/.env`, which is never committed), replace every
# `REPLACE_WITH_...` value there, and keep the real values in the operator's secret
# store. No value here is a credential, and none may become one: this file is
# tracked. Every name below is one the compose file requires (`${NAME:?...}`), and
# `deploy/staging/test_staging.py` fails when the two lists disagree.
# قائمة المتغيرات: أسماء وقيم بديلة فقط، ولا سرّ حقيقي في هذا الملف المتابَع في Git.

# اسم مشروع Openship لهذه البيئة؛ مشروع مستقل تمامًا عن أي مشروع آخر على الخادم.
# This staging project's own OpenShip/Compose project name; never another project's name.
COMPOSE_PROJECT_NAME=REPLACE_WITH_STAGING_COMPOSE_PROJECT_NAME

# نطاق البيئة التمثيلية (مضيف https)؛ لا يُستخدم نطاق الإنتاج هنا.
# The staging host name; the production domain is not used in this definition.
STAGING_DOMAIN=REPLACE_WITH_STAGING_DOMAIN

# اسم قاعدة بيانات البيئة التمثيلية؛ مختلف عن اسم قاعدة الإنتاج وعن odoo19 المحلية.
# The staging database name, distinct from the production database name.
STAGING_DB_NAME=REPLACE_WITH_STAGING_DATABASE_NAME

# كلمة مرور مستخدم odoo في قاعدة البيئة التمثيلية؛ تُولَّد لها ولا تُنسخ من الإنتاج.
# The staging database password: generated for staging, never copied from production.
STAGING_DB_PASSWORD=REPLACE_WITH_STAGING_DATABASE_PASSWORD

# وسم صور ليوان المبنية لهذه البيئة؛ لا وسم إنتاج ولا latest.
# The tag of the built LiwanOS images this staging stack runs; never a production tag.
STAGING_IMAGE_TAG=REPLACE_WITH_STAGING_IMAGE_TAG

# إصدار Odoo المثبَّت لبناء صورة odoo، من الملف deploy/odoo/ODOO_COMMIT.
# The pinned Odoo revision for the odoo image build, read from deploy/odoo/ODOO_COMMIT.
ODOO_COMMIT=REPLACE_WITH_ODOO_COMMIT_FROM_DEPLOY_ODOO_COMMIT_FILE
