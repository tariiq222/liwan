# Shared opt-in; requires deploy/proxy/Dockerfile with pinned caddy-ratelimit.
# Only TLS edge publishes ports. No trusted_proxies: client_ip is the socket peer.
{$DOMAIN} {
	@privateToken header X-WebVue-Proxy-Token *
	@privateRevision header X-WebVue-Tenant-Revision *
	route {
		respond @privateToken 403
		respond @privateRevision 403
		rate_limit {
			zone webvue_auth {
				match {
					path /api/auth/* /api/v1/auth/* /web/session/* /web/login
					# F5: the browser's version probe is not a credential endpoint
					# (guard 403s it); it must not drain the 20/min login budget.
					not path /web/session/get_session_info
				}
				key {client_ip}
				events 20
				window 1m
				ipv6_prefix 64
			}
			zone webvue_api {
				match {
					path /api/v1/*
					not path /api/v1/auth/*
				}
				key {client_ip}
				events 300
				window 1m
				ipv6_prefix 64
			}
			# F5: ACL-checked image bytes keep their own limited budget so avatar
			# grids cannot starve the rest of the Odoo-routed traffic.
			zone webvue_odoo_image {
				match {
					path /web/image/* /web/binary/company_logo
				}
				key {client_ip}
				events 1200
				window 1m
				ipv6_prefix 64
			}
			zone webvue_odoo {
				match {
					path /web/* /odoo/* /jsonrpc /xmlrpc/* /report/* /mail/* /bus/* /discuss/*
					not path /web/session/* /web/login /web/image/* /web/binary/company_logo
				}
				match {
					path /web/session/get_session_info
				}
				key {client_ip}
				events 600
				window 1m
				ipv6_prefix 64
			}
			zone webvue_web {
				match {
					not path /api/auth/* /api/v1/* /web/* /odoo/* /jsonrpc /xmlrpc/* /report/* /mail/* /bus/* /discuss/* /websocket /_nuxt/* /_i18n/* /fonts/* /favicon.ico /robots.txt
				}
				key {client_ip}
				events 600
				window 1m
				ipv6_prefix 64
			}
		}
		reverse_proxy guard:8080 {
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Proto
			header_up -Forwarded
			header_up -X-WebVue-Proxy-Token
			header_up -X-WebVue-Tenant-Revision
		}
	}
}
