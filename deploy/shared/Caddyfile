# Shared opt-in; requires deploy/proxy/Dockerfile with pinned caddy-ratelimit.
# Only this proxy publishes ports (compose binds them from LIWAN_EDGE_BIND and the two port variables).
#
# Real client address. `{client_ip}` keys every rate-limit zone and feeds the signup and invitation headers below.
# By default no proxy is trusted, so it is the socket peer and no header can change it. When an outer edge terminates
# TLS in front of this proxy (the Openship edge on the staging host), `LIWAN_TRUSTED_PROXIES` names that edge as seen
# from inside the container (the `edge` network gateway, see deploy/docker-compose.shared.yml) and the client is read
# from X-Forwarded-For. `trusted_proxies_strict` reads that header right to left, skipping trusted hops, so an
# address the client put in the header (the outer edge appends the real peer to it) never becomes `{client_ip}`.
# The default is an address in TEST-NET-1 (RFC 5737): reserved for documentation, never a peer, trusts nothing.
#
# `LIWAN_SITE_SCHEME` prefixes the restore and relay site addresses, which carry no scheme of their own (the tenant
# addresses in `DOMAIN` carry theirs). Empty keeps them on TLS (:443). `http://` puts them on :80 beside the tenant
# sites, which is the only port an outer edge forwards to; without it those sites would sit on :443 and never match.
#
# `LIWAN_AUTO_HTTPS` is Caddy's `auto_https` mode. The default changes nothing (no certificate is loaded by hand, so
# Caddy keeps issuing and redirecting for site names that carry TLS). `off` is for an environment whose outer edge
# terminates TLS: sites are given as `http://host` in `DOMAIN`, and the restore and relay sites, which carry no scheme,
# must not start certificate issuance or an HTTP redirect either.
{
	auto_https {$LIWAN_AUTO_HTTPS:ignore_loaded_certs}
	servers {
		trusted_proxies static {$LIWAN_TRUSTED_PROXIES:192.0.2.1/32}
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
	}
}

# The edge every guarded host gets: tenant hosts and restore hosts alike, so a restored copy is throttled,
# stripped and forwarded exactly like a tenant and gains no route of its own (the guard decides the rest).
(guarded_site) {
	@privateToken header X-Liwan-Proxy-Token *
	@privateRevision header X-Liwan-Tenant-Revision *
	@signup path /api/commercial/signup/*
	@invitationReissue path /api/invitations/reissue
	@workspaceLookup path /api/invitations/find-workspace
	@publicContact path /api/commercial/public/contact
	@tenantDeletion path /api/commercial/v1/deletion/request /api/commercial/v1/deletion/confirm /api/commercial/v1/deletion/withdraw
	route {
		respond @privateToken 403
		respond @privateRevision 403
		rate_limit {
			zone liwan_auth {
				match {
					path /api/auth/* /api/v1/auth/* /web/session/* /web/login
					# F5: the browser's version probe is not a credential endpoint
					# (guard 403s it); it must not drain the 20/min login budget.
					not path /web/session/get_session_info
				}
				key {client_ip}
				events 20
				window 1m
				ipv6_prefix 64
			}
			# A provider webhook arrives in bursts from a few addresses after an outage, and a 429 would
			# delay or lose deliveries Meta and TikTok retry: its own budget, kept out of the UI's 300.
			# The shared edge reaches Odoo directly (no TikTok relay route here), so a relayed delivery
			# lands on /api/v1/inbox/hooks/tiktok like any other hook and gets this zone too.
			zone liwan_provider_hook {
				match {
					path /api/v1/inbox/hooks/*
				}
				key {client_ip}
				events 1200
				window 1m
				ipv6_prefix 64
			}
			zone liwan_api {
				match {
					path /api/v1/*
					not path /api/v1/auth/* /api/v1/inbox/hooks/*
				}
				key {client_ip}
				events 300
				window 1m
				ipv6_prefix 64
			}
			# An invited requester's token routes have no session to throttle: one budget per
			# client address, on top of the general API budget.
			zone liwan_public_appointments_ip {
				match {
					path /api/v1/public/appointments/*
				}
				key {client_ip}
				events 60
				window 1m
				ipv6_prefix 64
			}
			# F5: ACL-checked image bytes keep their own limited budget so avatar
			# grids cannot starve the rest of the Odoo-routed traffic.
			zone liwan_odoo_image {
				match {
					path /web/image/* /web/binary/company_logo
				}
				key {client_ip}
				events 1200
				window 1m
				ipv6_prefix 64
			}
			zone liwan_odoo {
				match {
					path /web/* /odoo/* /jsonrpc /xmlrpc/* /report/* /mail/* /bus/* /discuss/*
					not path /web/session/* /web/login /web/image/* /web/binary/company_logo
				}
				match {
					path /web/session/get_session_info
				}
				key {client_ip}
				events 600
				window 1m
				ipv6_prefix 64
			}
			zone liwan_signup {
				match {
					path /api/commercial/signup/*
				}
				key {client_ip}
				events 30
				window 1m
				ipv6_prefix 64
			}
			# The marketing site's pricing read and contact form (the control plane budgets each visitor again).
			zone liwan_public_site {
				match {
					path /api/commercial/public/*
				}
				key {client_ip}
				events 30
				window 1m
				ipv6_prefix 64
			}
			zone liwan_web {
				match {
					not path /api/auth/* /api/v1/* /web/* /odoo/* /jsonrpc /xmlrpc/* /report/* /mail/* /bus/* /discuss/* /websocket /_nuxt/* /_i18n/* /fonts/* /favicon.ico /robots.txt
				}
				key {client_ip}
				events 600
				window 1m
				ipv6_prefix 64
			}
		}
		request_header -X-Liwan-Signup-Client
		request_header -X-Liwan-Client-Ip
		request_header @invitationReissue X-Liwan-Client-Ip {client_ip}
		request_header @workspaceLookup X-Liwan-Client-Ip {client_ip}
		request_header @publicContact X-Liwan-Client-Ip {client_ip}
		request_header @tenantDeletion X-Liwan-Client-Ip {client_ip}
		request_header @signup X-Liwan-Signup-Client {client_ip}
		reverse_proxy guard:8080 {
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Proto
			header_up -Forwarded
			header_up -X-Liwan-Proxy-Token
			header_up -X-Liwan-Tenant-Revision
		}
	}
}

# While an update stops the application services the edge stays up: a failed upstream answers a short
# Arabic 503 with Retry-After instead of a bare gateway error, but only while the deploy script's marker file
# `active` exists in the read-only maintenance directory. Without it a 502/504 is a real outage and keeps its
# own answer. Tenant sites only; restore hosts have no maintenance page.
(maintenance_page) {
	handle_errors {
		@upstreamDown {
			file {
				root /srv/liwan-maintenance
				try_files active
			}
			expression `{http.error.status_code} in [502, 503, 504]`
		}
		handle @upstreamDown {
			header Retry-After 60
			header Cache-Control no-store
			header Content-Type "text/plain; charset=utf-8"
			respond "نحدّث النظام الآن، عُد بعد دقائق." 503
		}
	}
}

{$DOMAIN} {
	import guarded_site
	import maintenance_page
}

# Restore hosts, `r<approval uuid hex>.restore.<domain>`, are published by the control plane's restore
# publication and resolved by the guard from its separate restore registry. They need a wildcard DNS record
# AND a certificate valid for `*.restore.<domain>`; see "Restore hosts" in deploy/shared/README.md. Caddy cannot
# issue that wildcard itself with the stock proxy image (no DNS-challenge module), so until the operator supplies
# it a restore host has no usable TLS.
#
# Access control: a restored database still holds the credentials the backup held, including a user disabled since
# the backup or an old password, so this site is not open to the internet. `LIWAN_RESTORE_ALLOW` is the operator's
# client-address allowlist (`client_ip` syntax: CIDRs, `private_ranges`, or bare addresses). It has no default on
# purpose: an unset or empty value answers 404 for every restore host, so a deployment cannot expose a restore by
# forgetting to set it. It matches `client_ip`, not `remote_ip`: with no trusted proxy that is the socket peer, so a
# header cannot claim an allowlisted address; behind an outer edge the socket peer is the edge's gateway, which a
# `remote_ip` match would treat as one client (and as private for `private_ranges`), so the real client is matched.
# The restore suffix is its own variable on purpose: `DOMAIN` is a site-address list that may carry several tenant
# hosts (`DOMAIN="a.example.test b.example.test"`), and deriving the wildcard from it would produce a host that
# matches no published restore (`r<hex>.restore.example.test`). Set `LIWAN_RESTORE_DOMAIN` to the control plane's
# `domainSuffix`. A default keeps `caddy validate` working when only `DOMAIN` is set.
{$LIWAN_SITE_SCHEME:}*.restore.{$LIWAN_RESTORE_DOMAIN:invalid.invalid} {
	# `handle` blocks are mutually exclusive and evaluated in order, so the allowlist is decided before any
	# request reaches the guarded snippet (a bare `respond` beside `import` is reordered by Caddy's directive sort).
	@notOperator not client_ip {$LIWAN_RESTORE_ALLOW}
	handle @notOperator {
		respond 404
	}
	handle {
		import guarded_site
	}
}

# The platform TikTok app's single delivery host (D13/D14): the webhook and the OAuth bounce only.
# Tenants are reached through the relay. Compose supplies the reserved address for an empty or unset
# host. The Caddyfile default covers direct validation when the variable is absent.
{$LIWAN_SITE_SCHEME:}{$LIWAN_TIKTOK_RELAY_HOST:invalid.invalid} {
	@privateToken header X-Liwan-Proxy-Token *
	@privateRevision header X-Liwan-Tenant-Revision *
	route {
		respond @privateToken 403
		respond @privateRevision 403
		# TikTok delivers in bursts after an outage; this budget bounds one app, not a customer.
		rate_limit {
			zone liwan_tiktok {
				match {
					path /tiktok/*
				}
				key {client_ip}
				events 120
				window 1m
				ipv6_prefix 64
			}
		}
		handle /tiktok/* {
			reverse_proxy tiktok-relay:8090 {
				header_up -X-Forwarded-For
				header_up -X-Forwarded-Host
				header_up -X-Forwarded-Proto
				header_up -Forwarded
				header_up -X-Liwan-Proxy-Token
				header_up -X-Liwan-Tenant-Revision
			}
		}
		respond 404
	}
}
