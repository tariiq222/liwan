# Shared opt-in; requires deploy/proxy/Dockerfile with pinned caddy-ratelimit.
# Only TLS edge publishes ports. No trusted_proxies: client_ip is the socket peer.
# The edge every guarded host gets: tenant hosts and restore hosts alike, so a restored copy is throttled,
# stripped and forwarded exactly like a tenant and gains no route of its own (the guard decides the rest).
(guarded_site) {
	@privateToken header X-Liwan-Proxy-Token *
	@privateRevision header X-Liwan-Tenant-Revision *
	@signup path /api/commercial/signup/*
	route {
		respond @privateToken 403
		respond @privateRevision 403
		rate_limit {
			zone liwan_auth {
				match {
					path /api/auth/* /api/v1/auth/* /web/session/* /web/login
					# F5: the browser's version probe is not a credential endpoint
					# (guard 403s it); it must not drain the 20/min login budget.
					not path /web/session/get_session_info
				}
				key {client_ip}
				events 20
				window 1m
				ipv6_prefix 64
			}
			# A provider webhook arrives in bursts from a few addresses after an outage, and a 429 would
			# delay or lose deliveries Meta and TikTok retry: its own budget, kept out of the UI's 300.
			# The shared edge reaches Odoo directly (no TikTok relay route here), so a relayed delivery
			# lands on /api/v1/inbox/hooks/tiktok like any other hook and gets this zone too.
			zone liwan_provider_hook {
				match {
					path /api/v1/inbox/hooks/*
				}
				key {client_ip}
				events 1200
				window 1m
				ipv6_prefix 64
			}
			zone liwan_api {
				match {
					path /api/v1/*
					not path /api/v1/auth/* /api/v1/inbox/hooks/*
				}
				key {client_ip}
				events 300
				window 1m
				ipv6_prefix 64
			}
			# An invited requester's token routes have no session to throttle: one budget per
			# client address, on top of the general API budget.
			zone liwan_public_appointments_ip {
				match {
					path /api/v1/public/appointments/*
				}
				key {client_ip}
				events 60
				window 1m
				ipv6_prefix 64
			}
			# F5: ACL-checked image bytes keep their own limited budget so avatar
			# grids cannot starve the rest of the Odoo-routed traffic.
			zone liwan_odoo_image {
				match {
					path /web/image/* /web/binary/company_logo
				}
				key {client_ip}
				events 1200
				window 1m
				ipv6_prefix 64
			}
			zone liwan_odoo {
				match {
					path /web/* /odoo/* /jsonrpc /xmlrpc/* /report/* /mail/* /bus/* /discuss/*
					not path /web/session/* /web/login /web/image/* /web/binary/company_logo
				}
				match {
					path /web/session/get_session_info
				}
				key {client_ip}
				events 600
				window 1m
				ipv6_prefix 64
			}
			zone liwan_signup {
				match {
					path /api/commercial/signup/*
				}
				key {client_ip}
				events 30
				window 1m
				ipv6_prefix 64
			}
			zone liwan_web {
				match {
					not path /api/auth/* /api/v1/* /web/* /odoo/* /jsonrpc /xmlrpc/* /report/* /mail/* /bus/* /discuss/* /websocket /_nuxt/* /_i18n/* /fonts/* /favicon.ico /robots.txt
				}
				key {client_ip}
				events 600
				window 1m
				ipv6_prefix 64
			}
		}
		request_header -X-Liwan-Signup-Client
		request_header @signup X-Liwan-Signup-Client {client_ip}
		reverse_proxy guard:8080 {
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Proto
			header_up -Forwarded
			header_up -X-Liwan-Proxy-Token
			header_up -X-Liwan-Tenant-Revision
		}
	}
}

{$DOMAIN} {
	import guarded_site
}

# Restore hosts, `r<approval uuid hex>.restore.<domain>`, are published by the control plane's restore
# publication and resolved by the guard from its separate restore registry. They need a wildcard DNS record
# AND a certificate valid for `*.restore.<domain>`; see "Restore hosts" in deploy/shared/README.md. Caddy cannot
# issue that wildcard itself with the stock proxy image (no DNS-challenge module), so until the operator supplies
# it a restore host has no usable TLS.
#
# Access control: a restored database still holds the credentials the backup held, including a user disabled since
# the backup or an old password, so this site is not open to the internet. `LIWAN_RESTORE_ALLOW` is the operator's
# client-address allowlist (`remote_ip` syntax: CIDRs, `private_ranges`, or bare addresses). It has no default on
# purpose: an unset or empty value answers 404 for every restore host, so a deployment cannot expose a restore by
# forgetting to set it. `trusted_proxies` stays unset, so `remote_ip` reads the socket peer and no client header
# can claim an allowlisted address.
# The restore suffix is its own variable on purpose: `DOMAIN` is a site-address list that may carry several tenant
# hosts (`DOMAIN="a.example.test b.example.test"`), and deriving the wildcard from it would produce a host that
# matches no published restore (`r<hex>.restore.example.test`). Set `LIWAN_RESTORE_DOMAIN` to the control plane's
# `domainSuffix`. A default keeps `caddy validate` working when only `DOMAIN` is set.
*.restore.{$LIWAN_RESTORE_DOMAIN:invalid.invalid} {
	# `handle` blocks are mutually exclusive and evaluated in order, so the allowlist is decided before any
	# request reaches the guarded snippet (a bare `respond` beside `import` is reordered by Caddy's directive sort).
	@notOperator not remote_ip {$LIWAN_RESTORE_ALLOW}
	handle @notOperator {
		respond 404
	}
	handle {
		import guarded_site
	}
}

# The platform TikTok app's single delivery host (D13/D14): the webhook and the OAuth bounce only.
# Tenants are reached through the relay. Compose supplies the reserved address for an empty or unset
# host. The Caddyfile default covers direct validation when the variable is absent.
{$LIWAN_TIKTOK_RELAY_HOST:invalid.invalid} {
	@privateToken header X-Liwan-Proxy-Token *
	@privateRevision header X-Liwan-Tenant-Revision *
	route {
		respond @privateToken 403
		respond @privateRevision 403
		# TikTok delivers in bursts after an outage; this budget bounds one app, not a customer.
		rate_limit {
			zone liwan_tiktok {
				match {
					path /tiktok/*
				}
				key {client_ip}
				events 120
				window 1m
				ipv6_prefix 64
			}
		}
		handle /tiktok/* {
			reverse_proxy tiktok-relay:8090 {
				header_up -X-Forwarded-For
				header_up -X-Forwarded-Host
				header_up -X-Forwarded-Proto
				header_up -Forwarded
				header_up -X-Liwan-Proxy-Token
				header_up -X-Liwan-Tenant-Revision
			}
		}
		respond 404
	}
}
