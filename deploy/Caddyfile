# Direct dedicated edge: only the socket peer is client authority.
# Apply one aggregate credential budget before choosing Nuxt or Odoo.
{$DOMAIN} {
	encode zstd gzip

	@odoo path /web/*

	route {
		rate_limit {
			# One aggregate budget per client address for every credential endpoint: the
			# password step, the code send/verify/device steps of the two-step sign-in,
			# sign-out, and the stock session calls. Per-account limits (resend cooldown,
			# code attempts, send caps) are Odoo's, in liwan_core/models/login_code.py:
			# the edge sees one address behind a shared NAT and never learns the account.
			zone liwan_auth {
				match {
					path /api/auth/* /api/v1/auth/* /web/session/* /web/login /web/login/*
					not path /web/session/get_session_info
				}
				key {remote_host}
				events 20
				window 1m
				ipv6_prefix 64
			}
			# A provider webhook arrives in bursts from a few addresses after an outage, and a 429 would
			# delay or lose deliveries Meta and TikTok retry: its own budget, kept out of the UI's 300.
			zone liwan_provider_hook {
				match {
					path /api/v1/inbox/hooks/*
				}
				key {remote_host}
				events 1200
				window 1m
				ipv6_prefix 64
			}
			zone liwan_api {
				match {
					path /api/v1/*
					not path /api/v1/auth/* /api/v1/public/appointments/* /api/v1/inbox/hooks/*
				}
				key {remote_host}
				events 300
				window 1m
				ipv6_prefix 64
			}
			# An invited requester's token routes have no session to throttle: their own budget.
			zone liwan_public_appointments_ip {
				match {
					path /api/v1/public/appointments/*
				}
				key {remote_host}
				events 60
				window 1m
				ipv6_prefix 64
			}
			zone liwan_odoo {
				match {
					path /web/*
					not path /web/session/* /web/login /web/login/* /web/health
				}
				match {
					path /web/session/get_session_info
				}
				key {remote_host}
				events 600
				window 1m
				ipv6_prefix 64
			}
			zone liwan_web {
				match {
					not path /api/auth/* /api/v1/* /web/* /websocket*
				}
				key {remote_host}
				events 600
				window 1m
				ipv6_prefix 64
			}
		}
		handle @odoo {
			reverse_proxy odoo:8069
		}
		handle /websocket* {
			reverse_proxy odoo:8072
		}
		handle {
			# Browser documents come only from Nuxt. The Odoo handles above answer JSON,
			# PDF reports and binary downloads, where a document CSP breaks report
			# rendering, so these headers never leave this block.
			# `defer` gives the edge the last word over an upstream value: the baseline policy
			# below is the one the browser enforces. If Nuxt ever emits its own CSP (for a
			# nonce), merge the two here instead of letting either layer win.
			#
			# script-src needs 'unsafe-inline': Nuxt 4 writes its hydration payload, the
			# import map and the entry bootstrap as inline <script> elements, and the edge
			# cannot mint a nonce for them (that is a Nuxt-side change). style-src needs it
			# too: Nuxt inlines component CSS and Vue binds `:style` attributes.
			# img-src allows any https host because the WhatsApp business profile picture
			# is returned as a remote https URL (pps.whatsapp.net), and blob:/data: because
			# an upload preview is a local object URL. connect-src is same-origin plus wss:
			# for the /websocket live bus. form-action allows https because the pay page
			# submits a hidden form to the payment gateway rather than framing it. frame-src
			# is empty: the app embeds no document. frame-ancestors 'none' is repeated as
			# X-Frame-Options because older browsers read only the latter.
			header {
				defer
				Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' wss:; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'self' https:; frame-ancestors 'none'"
				# '?' keeps a stricter value the app already sent: the pages that carry a
				# document token in their address (/pay, /book, /join, /reset-password)
				# set `referrer-policy: no-referrer` themselves.
				?Referrer-Policy "strict-origin-when-cross-origin"
				# A year, no includeSubDomains: a tenant's other subdomains are not ours to
				# promise over TLS.
				Strict-Transport-Security "max-age=31536000"
				X-Content-Type-Options "nosniff"
				X-Frame-Options "DENY"
				# Only what the app uses: the inbox location picker reads geolocation, and a
				# message's video player is allowed to go fullscreen. Nothing here records
				# audio, video or a screen.
				Permissions-Policy "camera=(), microphone=(), display-capture=(), geolocation=(self), fullscreen=(self)"
			}
			reverse_proxy web:3000 {
				# Set after Connection-nominated fields are stripped; never append.
				header_up X-Liwan-Client-IP {remote_host}
				header_up X-Liwan-Client-Host {hostport}
				header_up X-Liwan-Client-Proto {scheme}
			}
		}
	}
}
