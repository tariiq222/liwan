{$DOMAIN} {
	encode zstd gzip

	# */static/* (not /*/static/*): Caddy's path matcher does not let * cross / in multi-wildcard patterns
	@odoo path /api/v1/* /web/* /odoo/* /website/translations /base_setup/* /bus/* /json/* /doc/* */static/* /report/* /mail/* /discuss/*
	handle @odoo {
		reverse_proxy odoo:8069
	}
	handle /websocket* {
		reverse_proxy odoo:8072
	}
	handle {
		reverse_proxy web:3000
	}
}
