# Direct dedicated edge: only the socket peer is client authority.
# Apply one aggregate credential budget before choosing Nuxt or Odoo.
{$DOMAIN} {
	encode zstd gzip

	@odoo path /api/v1/* /web/* /odoo/* /website/translations /base_setup/* /bus/* /json/* /doc/* */static/* /report/* /mail/* /discuss/*

	route {
		rate_limit {
			zone webvue_auth {
				match {
					path /api/auth/* /api/v1/auth/* /web/session/* /web/login /web/login/*
					not path /web/session/get_session_info
				}
				key {remote_host}
				events 20
				window 1m
				ipv6_prefix 64
			}
			zone webvue_api {
				match {
					path /api/v1/*
					not path /api/v1/auth/*
				}
				key {remote_host}
				events 300
				window 1m
				ipv6_prefix 64
			}
			zone webvue_odoo {
				match {
					path /web/* /odoo/* /website/translations /base_setup/* /bus/* /json/* /doc/* */static/* /report/* /mail/* /discuss/*
					not path /web/session/* /web/login /web/login/* /web/health
				}
				match {
					path /web/session/get_session_info
				}
				key {remote_host}
				events 600
				window 1m
				ipv6_prefix 64
			}
			zone webvue_web {
				match {
					not path /api/auth/* /api/v1/* /web/* /odoo/* /website/translations /base_setup/* /bus/* /json/* /doc/* */static/* /report/* /mail/* /discuss/* /websocket*
				}
				key {remote_host}
				events 600
				window 1m
				ipv6_prefix 64
			}
		}
		handle @odoo {
			reverse_proxy odoo:8069
		}
		handle /websocket* {
			reverse_proxy odoo:8072
		}
		handle {
			reverse_proxy web:3000 {
				# Set after Connection-nominated fields are stripped; never append.
				header_up X-WebVue-Client-IP {remote_host}
				header_up X-WebVue-Client-Host {hostport}
				header_up X-WebVue-Client-Proto {scheme}
			}
		}
	}
}
