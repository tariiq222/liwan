# Staging environment file for the compose set that production runs too. Names and placeholders only:
# copy to a root-only file on the host (0600, outside the checkout) and fill it in there. No value here
# is a secret and none may become one, this file is tracked. Every variable is documented in README.md.
# Staging holds test data only and must never carry a real customer. It runs on its own Oracle server in Jeddah.

# --- Release inputs (written by the release path, never typed) ---
LIWAN_IMAGE_TAG=release-placeholder
ODOO_COMMIT=REPLACE_WITH_ODOO_COMMIT

# --- Edge: the stack owns ports 80 and 443 on every address of the host ---
LIWAN_EDGE_BIND=0.0.0.0
LIWAN_EDGE_HTTP_PORT=80
LIWAN_EDGE_HTTPS_PORT=443

# --- Domains ---
# Site-address list of the tenant edge: the staging base domain and its wildcard.
DOMAIN=staging.example.test, *.staging.example.test
LIWAN_PROSPECT_HOST=app.staging.example.test
NUXT_CUSTOMER_COMMERCIAL_PUBLIC_ORIGIN=https://app.staging.example.test
# Origins of the marketing site (comma separated) that may read the public pricing and post the contact form.
NUXT_MARKETING_SITE_ORIGINS=
LIWAN_RESTORE_DOMAIN=restore.staging.example.test
LIWAN_RESTORE_ALLOW=
LIWAN_TIKTOK_RELAY_HOST=

# --- Database ---
DB_NAME=liwan_staging
DB_PASSWORD=REPLACE_WITH_GENERATED_DB_PASSWORD

# --- Shared-tier secrets (generated on the host, test values distinct from production) ---
LIWAN_SHARED_PROXY_TOKEN=REPLACE_WITH_GENERATED_PROXY_TOKEN
LIWAN_SESSION_KEYS=REPLACE_WITH_KID_AND_KEY_PAIRS
LIWAN_SESSION_ACTIVE_KID=k1

# --- Customer commercial link (web tier to the control plane) ---
NUXT_CUSTOMER_COMMERCIAL_CONTROL_URL=https://control.staging.example.test:4187
CUSTOMER_COMMERCIAL_ISSUER=liwan-web
CUSTOMER_COMMERCIAL_SERVICE_KEY=REPLACE_WITH_GENERATED_SERVICE_KEY
LIWAN_PUBLIC_SIGNUP=false

# --- Host paths ---
LIWAN_SHARED_ODOO_CONFIG=/srv/liwan-staging/config/odoo.conf
LIWAN_MAINTENANCE_DIR=/var/lib/liwan-release/maintenance
LIWAN_TENANT_REGISTRY_DIR=/srv/liwan-staging/state/registry
LIWAN_COMMERCIAL_CONTROL_NETWORK=liwan_staging_control
LIWAN_ADMIN_EDGE_NETWORK=liwan_staging_admin_edge

# --- Control plane (compose.production.yml) ---
LIWAN_CONTROL_UID=990
LIWAN_CONTROL_GID=990
LIWAN_CONTROL_CONFIG_DIR=/srv/liwan-staging/control/config
LIWAN_CONTROL_STATE_DIR=/srv/liwan-staging/control/state
LIWAN_CONTROL_PRIVATE_DIR=/srv/liwan-staging/control/private
LIWAN_CONTROL_ENV_FILE=/srv/liwan-staging/control/control.env
LIWAN_VENDOR_ADMIN_ENV_FILE=/srv/liwan-staging/control/vendor-admin.env
LIWAN_SHARED_COMPOSE_FILE=/srv/liwan-staging/shared.compose.json
LIWAN_SHARED_ENV_FILE=/srv/liwan-staging/shared.env
