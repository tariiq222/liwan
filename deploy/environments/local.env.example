# Local environment file for the stack of a developer machine or an acceptance harness (deploy/stack/compose.yml). Names and placeholders only:
# copy to a root-only file on the host (0600, outside the checkout) and fill it in there. No value here
# is a secret and none may become one, this file is tracked. Every variable is documented in README.md.
# Nothing here is reachable from outside the machine: the edge publishes on loopback, and the commercial edge and the host link are off.

# --- Stack shape (deploy/stack/compose.yml; exactly true or false) ---
# The public commercial host, the customer BFF and the vendor console host: the three control networks, the control CA and the two Caddy snippets.
LIWAN_STACK_COMMERCIAL_EDGE=false
# The tenant database's loopback port and host-link network, for the release path's pg_dump.
LIWAN_STACK_DB_HOST_LINK=false
# Which release tag this environment applies: `highest` follows the highest release tag, `explicit` only the tag it is given.
LIWAN_RELEASE_TAG_POLICY=explicit

# --- Release inputs (written by the release path, never typed) ---
LIWAN_IMAGE_TAG=release-placeholder
# Use the content of deploy/odoo/ODOO_COMMIT; the release's release.env overrides it later.
ODOO_COMMIT=REPLACE_WITH_ODOO_COMMIT

# --- Edge: loopback only, on ports that cannot clash with another stack on the machine ---
LIWAN_EDGE_BIND=127.0.0.1
LIWAN_EDGE_HTTP_PORT=18080
LIWAN_EDGE_HTTPS_PORT=18443
# Empty trusts no proxy: the client address is the socket peer. Compose turns an empty value into its default
# 192.0.2.1/32 (reserved TEST-NET-1, no real peer); an empty string reaching Caddy would not parse as a range list.
LIWAN_EDGE_SUBNET=172.29.50.0/24
LIWAN_TRUSTED_PROXIES=
LIWAN_AUTO_HTTPS=off
# The restore and relay sites follow the tenant sites onto plain HTTP (:80).
LIWAN_SITE_SCHEME=http://

# --- Domains ---
# Site-address list of the tenant edge: the base domain and its wildcard.
DOMAIN=http://localtest.example.test, http://*.localtest.example.test
LIWAN_PROSPECT_HOST=app.localtest.example.test
NUXT_CUSTOMER_COMMERCIAL_PUBLIC_ORIGIN=http://app.localtest.example.test
# Origins of the marketing site (comma separated) that may read the public pricing and post the contact form.
NUXT_MARKETING_SITE_ORIGINS=
LIWAN_RESTORE_DOMAIN=localtest.example.test
LIWAN_RESTORE_ALLOW=
LIWAN_TIKTOK_RELAY_HOST=
# Host of the payment webhook site (the edge forwards only the Moyasar event there). Empty means the reserved name: nothing is exposed.
CONTROL_WEBHOOK_DOMAIN=
# Host of the vendor console. Empty means the reserved name: nothing is exposed.
ADMIN_DOMAIN=
# Client addresses that may reach the vendor console (Caddy `client_ip` syntax: CIDRs or bare addresses, space separated, never commas: one bad entry stops Caddy from loading).
# Empty means closed: the console host answers 404 to everyone.
LIWAN_ADMIN_ALLOW=

# --- Database ---
DB_NAME=liwan_local
# DB_PASSWORD is the `odoo` runtime role (Odoo, pgbouncer); DB_ADMIN_PASSWORD is the `postgres` admin role, used by tooling and the db service only.
DB_PASSWORD=REPLACE_WITH_GENERATED_DB_PASSWORD
DB_ADMIN_PASSWORD=REPLACE_WITH_GENERATED_DB_ADMIN_PASSWORD

# --- Shared-tier secrets (generated on the host, never reused from staging) ---
LIWAN_SHARED_PROXY_TOKEN=REPLACE_WITH_GENERATED_PROXY_TOKEN
LIWAN_SESSION_KEYS='{"k1":"REPLACE_WITH_GENERATED_SESSION_KEY"}'
LIWAN_SESSION_ACTIVE_KID=k1

# --- Customer commercial link (web tier to the control plane) ---
NUXT_CUSTOMER_COMMERCIAL_CONTROL_URL=https://control-api:4187
CUSTOMER_COMMERCIAL_ISSUER=liwan-web
CUSTOMER_COMMERCIAL_SERVICE_KEY=REPLACE_WITH_GENERATED_SERVICE_KEY
LIWAN_PUBLIC_SIGNUP=false

# --- AI service (the release always starts `ai`; see docs/operations/environment-bringup.md A4.8) ---
# Generate the AI secrets with deploy/ai/ensure_secrets.sh on the host, before the first start of `db`: the `liwan_ai`
# role is created only when AI_DB_PASSWORD is set while the db volume is first initialised. The password inside
# AI_DATABASE_URL is the same value as AI_DB_PASSWORD. Tenant provider keys are encrypted under AI_KEY_ENCRYPTION_KEYS
# (`id:secret` pairs, comma separated).
NUXT_AI_SERVICE_URL=http://ai:8600
AI_SERVICE_TOKEN=REPLACE_WITH_GENERATED_AI_SERVICE_TOKEN
AI_TOKEN_KEY=REPLACE_WITH_GENERATED_AI_TOKEN_KEY
# The AI usage root secret is 64 hex characters (`openssl rand -hex 32`), the same value for `web` and `odoo` and for nothing else.
# Without it every AI run is refused. Rotate by replacing it and recreating odoo, then web.
LIWAN_AI_USAGE_KEY=REPLACE_WITH_GENERATED_AI_USAGE_ROOT_SECRET
AI_DB_PASSWORD=REPLACE_WITH_GENERATED_AI_DB_PASSWORD
AI_DATABASE_URL=postgresql://liwan_ai:REPLACE_WITH_GENERATED_AI_DB_PASSWORD@db:5432/liwan_ai
AI_KEY_ENCRYPTION_KEYS=k1:REPLACE_WITH_GENERATED_KEY_ENCRYPTION_SECRET
AI_KEY_ENCRYPTION_KEY_ID=k1
# Hosts the ai-egress proxy allows besides the platform chat providers, whose hosts the ai service publishes itself. Leave empty
# unless an internal endpoint (a self-hosted Ollama), the embedding host (AI_EMBEDDING_PROVIDER) or the Sentry host (a DSN) needs
# one. Comma separated items: `host`, `.domain` or `host:port` (deploy/ai-egress/render.sh).
AI_EGRESS_HOSTS=

# The `$pbkdf2-sha512$...` hash of Odoo's master password (never the plain password): rendered into the Odoo config with DB_PASSWORD.
LIWAN_ODOO_ADMIN_PASSWD=REPLACE_WITH_GENERATED_ODOO_ADMIN_PASSWD_HASH

# --- Host paths ---
LIWAN_SHARED_ODOO_CONFIG=/tmp/liwan-local/config/odoo.conf
LIWAN_MAINTENANCE_DIR=/var/lib/liwan-release/maintenance
LIWAN_TENANT_REGISTRY_DIR=/tmp/liwan-local/state/registry
LIWAN_COMMERCIAL_CONTROL_NETWORK=liwan_local_control
LIWAN_ADMIN_EDGE_NETWORK=liwan_local_admin_edge
# Internal network between the edge and the control API; the web tier is not on it.
LIWAN_CONTROL_EDGE_NETWORK=liwan_local_control_edge

# --- Control plane (compose.production.yml) ---
# The uid and gid of the liwan-worker account on the host: `id -u liwan-worker` and `id -g liwan-worker`.
LIWAN_CONTROL_UID=REPLACE_WITH_WORKER_UID
LIWAN_CONTROL_GID=REPLACE_WITH_WORKER_GID
LIWAN_CONTROL_CONFIG_DIR=/tmp/liwan-local/control/config
LIWAN_CONTROL_STATE_DIR=/tmp/liwan-local/control/state
# The control plane writes the AI platform provider file here when the vendor saves a provider. Unset, compose falls back to ./data/ai inside the per-commit release checkout and the file is lost at the next release.
LIWAN_AI_PLATFORM_DIR=/tmp/liwan-local/control/state/ai-platform
LIWAN_CONTROL_PRIVATE_DIR=/tmp/liwan-local/control/private
LIWAN_CONTROL_ENV_FILE=/tmp/liwan-local/control/control.env
LIWAN_VENDOR_ADMIN_ENV_FILE=/tmp/liwan-local/control/vendor-admin.env
LIWAN_SHARED_COMPOSE_FILE=/tmp/liwan-local/shared.compose.json
LIWAN_SHARED_ENV_FILE=/tmp/liwan-local/shared.env
# Loopback port of the tenant database for the host pg_dump (`LIWAN_STACK_DB_HOST_LINK`); the release reads it for the backup.
LIWAN_DB_HOST_PORT=15433
# Tenant storage (per-tenant OCI object storage, off until LIWAN_TENANT_STORAGE_ENABLED=true in the control plane): the directory
# with the files `oci_provision_key` and `oci_naming_key` (mode 0400), which bring-up creates.
LIWAN_TENANT_STORAGE_FILES_DIR=/tmp/liwan-local/control/tenant-storage
# `<namespace>.compat.objectstorage.<region>.oraclecloud.com`, added to Odoo's egress allowlist. Empty while tenant storage is off.
LIWAN_OBJECT_STORAGE_COMPAT_HOST=
# Per-tenant OCI object storage settings (read by the `tenant-storage` service); empty keeps the code defaults (region me-jeddah-1, policy per_tenant). No secret here.
OCI_TENANCY_OCID=
OCI_USER_OCID=
OCI_FINGERPRINT=
OCI_COMPARTMENT_OCID=
OCI_REGION=
OCI_HOME_REGION=
OCI_NAMESPACE=
OCI_POLICY_MODE=
