# Production environment file for the compose set that development and staging run too. Names and placeholders only:
# copy to a root-only file on the host (0600, outside the checkout) and fill it in there. No value here
# is a secret and none may become one, this file is tracked. Every variable is documented in README.md.
# Production data stays inside Saudi Arabia (the Oracle Jeddah server).

# --- Release inputs (written by the release path, never typed) ---
LIWAN_IMAGE_TAG=release-placeholder
ODOO_COMMIT=REPLACE_WITH_ODOO_COMMIT

# --- Edge: the stack owns ports 80 and 443 on every address of the host ---
LIWAN_EDGE_BIND=0.0.0.0
LIWAN_EDGE_HTTP_PORT=80
LIWAN_EDGE_HTTPS_PORT=443
# Empty trusts no proxy: the client address is the socket peer. Compose turns an empty value into its default
# 192.0.2.1/32 (reserved TEST-NET-1, no real peer); an empty string reaching Caddy would not parse as a range list.
# Set to the outer edge's gateway only if production also runs behind one (the first address of LIWAN_EDGE_SUBNET, as a /32).
LIWAN_EDGE_SUBNET=172.29.50.0/24
LIWAN_TRUSTED_PROXIES=
LIWAN_AUTO_HTTPS=ignore_loaded_certs
# Empty keeps the restore and relay sites on TLS (:443), as today.
LIWAN_SITE_SCHEME=

# --- Domains ---
# Site-address list of the tenant edge: the base domain and its wildcard.
DOMAIN=example.test, *.example.test
LIWAN_PROSPECT_HOST=app.example.test
NUXT_CUSTOMER_COMMERCIAL_PUBLIC_ORIGIN=https://app.example.test
# Origins of the marketing site (comma separated) that may read the public pricing and post the contact form.
NUXT_MARKETING_SITE_ORIGINS=
LIWAN_RESTORE_DOMAIN=restore.example.test
LIWAN_RESTORE_ALLOW=
LIWAN_TIKTOK_RELAY_HOST=

# --- Database ---
DB_NAME=liwan
DB_PASSWORD=REPLACE_WITH_GENERATED_DB_PASSWORD

# --- Shared-tier secrets (generated on the host, never reused from staging) ---
LIWAN_SHARED_PROXY_TOKEN=REPLACE_WITH_GENERATED_PROXY_TOKEN
LIWAN_SESSION_KEYS=REPLACE_WITH_KID_AND_KEY_PAIRS
LIWAN_SESSION_ACTIVE_KID=k1

# --- Customer commercial link (web tier to the control plane) ---
NUXT_CUSTOMER_COMMERCIAL_CONTROL_URL=https://control.example.test:4187
CUSTOMER_COMMERCIAL_ISSUER=liwan-web
CUSTOMER_COMMERCIAL_SERVICE_KEY=REPLACE_WITH_GENERATED_SERVICE_KEY
LIWAN_PUBLIC_SIGNUP=false

# --- Host paths ---
LIWAN_SHARED_ODOO_CONFIG=/srv/liwan/config/odoo.conf
LIWAN_MAINTENANCE_DIR=/var/lib/liwan-release/maintenance
LIWAN_TENANT_REGISTRY_DIR=/srv/liwan/state/registry
LIWAN_COMMERCIAL_CONTROL_NETWORK=liwan_control
LIWAN_ADMIN_EDGE_NETWORK=liwan_admin_edge

# --- Control plane (compose.production.yml) ---
# The uid and gid of the liwan-worker account on the host: `id -u liwan-worker` and `id -g liwan-worker`.
LIWAN_CONTROL_UID=REPLACE_WITH_WORKER_UID
LIWAN_CONTROL_GID=REPLACE_WITH_WORKER_GID
LIWAN_CONTROL_CONFIG_DIR=/srv/liwan/control/config
LIWAN_CONTROL_STATE_DIR=/srv/liwan/control/state
LIWAN_CONTROL_PRIVATE_DIR=/srv/liwan/control/private
LIWAN_CONTROL_ENV_FILE=/srv/liwan/control/control.env
LIWAN_VENDOR_ADMIN_ENV_FILE=/srv/liwan/control/vendor-admin.env
LIWAN_SHARED_COMPOSE_FILE=/srv/liwan/shared.compose.json
LIWAN_SHARED_ENV_FILE=/srv/liwan/shared.env
# Loopback port of the tenant database for the host pg_dump (docker-compose.host-link.yml).
LIWAN_DB_HOST_PORT=15433
