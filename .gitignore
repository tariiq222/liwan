# --- Dependencies and build output ------------------------------------------
node_modules/
.nuxt/
.output/
.nitro/
.cache/
dist/
*.tsbuildinfo
apps/web/storybook-static/
# Generated by tools/ui_catalog.mjs on demand; committing it made every open PR stale after each merge.
docs/design-system/catalog.json
# Stray Nuxt root created by `nuxt dev 127.0.0.1` (positional arg, not --host)
apps/web/127.0.0.1/

# --- Test and coverage output -----------------------------------------------
test-results/
playwright-report/
blob-report/
coverage/
.vitest/
# e2e (TesterArmy) run output and replay cache. Docs default: ignore .e2e/;
# commit .e2e/cache/ only to share replay recordings (opt-in, keep this line then).
.e2e/

# --- Python tooling caches (ruff is the linter for odoo-addons) -------------
__pycache__/
*.pyc
.ruff_cache/
.pytest_cache/
.mypy_cache/
*.egg-info/
.venv/
venv/

# --- Logs and local runtime -------------------------------------------------
*.log
.runtime/
.worktrees/
deploy/branding.json
deploy/data/

# --- Secrets: only documented, sanitized env templates are shared -----------
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pem
*.key
*.p12
*.pfx
*.p8
*.jks
*.keystore

# --- Local databases, backups and captured customer/run artifacts -----------
*.db
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm
*.dump
/backups/
/dumps/
/artifacts/
/screenshots/

# --- Editor and OS ----------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*~

# --- Claude: share the project setup; keep machine-local files private ------
!/.claude/
/.claude/*
!/.claude/settings.json
!/.claude/agents/
/.claude/agents/*
!/.claude/agents/frontend-theme.md
!/.claude/agents/odoo-reviewer.md
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/e2e/
!/.claude/skills/user-test/
!/.claude/scripts/
/.claude/scripts/*
!/.claude/scripts/guard-bash.sh
!/.claude/scripts/session-start.sh

# --- Other agent tools: local state and scratch, never part of the product --
# Planner-skill output: local specs and tickets only, never committed or published
.scratch/
.superpowers/
.impeccable/
.fastembed_cache/
.playwright-mcp/
# The plugin may name its state dir .agent-teams-<project>
.agent-teams*/
.dsh-auto/
.council/
.project-council/
/.codex/
/.agents/
/.dsh/
