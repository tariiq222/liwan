{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(npm test:*)",
      "Bash(npm run check:fast:*)",
      "Bash(npm run lint:*)",
      "Bash(npm -w apps/web run lint:*)",
      "Bash(npm -w apps/web run test:*)",
      "Bash(npm -w apps/vendor-admin run lint:*)",
      "Bash(npm -w apps/vendor-admin run test:*)",
      "Bash(npm run wt -- check:*)",
      "Bash(python3 -B tools/arch_policy.py)",
      "Bash(python3 -B tools/git_policy.py:*)",
      "Bash(python3 -B tools/docs_policy.py:*)",
      "Bash(python3 -B tools/ui_policy.py:*)",
      "Bash(python3 -B -m unittest:*)",
      "Bash(ruff check:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/scripts/guard-bash.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/scripts/session-start.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "audit-context-building@trailofbits": true,
    "static-analysis@trailofbits": true,
    "differential-review@trailofbits": true,
    "insecure-defaults@trailofbits": true,
    "sharp-edges@trailofbits": true,
    "supply-chain-risk-auditor@trailofbits": true,
    "testing-handbook-skills@trailofbits": true,
    "comprehensive-review@claude-code-workflows": true,
    "security-scanning@claude-code-workflows": true,
    "performance-testing-review@claude-code-workflows": true,
    "database-design@claude-code-workflows": true,
    "observability-monitoring@claude-code-workflows": true,
    "deployment-validation@claude-code-workflows": true,
    "grafana-k6@grafana-skills": true
  },
  "extraKnownMarketplaces": {
    "trailofbits": {
      "source": {
        "source": "github",
        "repo": "trailofbits/skills"
      }
    },
    "claude-code-workflows": {
      "source": {
        "source": "github",
        "repo": "wshobson/agents"
      }
    },
    "grafana-skills": {
      "source": {
        "source": "github",
        "repo": "grafana/skills"
      }
    }
  }
}
