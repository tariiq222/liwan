<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_cap_{{app}}_records_read" model="res.groups"><field name="name">Capability: read {{name_en}} records</field><field name="privilege_id" ref="nasq_core.res_groups_privilege_nasq"/></record>
    <record id="group_cap_{{app}}_records_manage" model="res.groups"><field name="name">Capability: manage {{name_en}} records</field><field name="privilege_id" ref="nasq_core.res_groups_privilege_nasq"/></record>

    <record id="group_{{app}}_manager" model="res.groups">
        <field name="name">{{name_en}} Manager</field><field name="privilege_id" ref="nasq_core.res_groups_privilege_nasq"/>
        <field name="implied_ids" eval="[Command.set([ref('nasq_core.group_employee'),ref('group_cap_{{app}}_records_read'),ref('group_cap_{{app}}_records_manage')])]"/>
    </record>

    <!-- nasq_core's support group reaches this application through this link. -->
    <record id="nasq_core.group_vendor_support" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_{{app}}_manager'))]"/>
    </record>
</odoo>
