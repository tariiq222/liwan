from odoo.tests import TransactionCase, new_test_user, tagged

from odoo.addons.nasq_{{app}}.models.access_service import (
    EMPLOYEE_PERMISSIONS,
    PERMISSIONS,
)


@tagged('nasq', 'nasq_access')
class Test{{App}}AccessComposition(TransactionCase):
    """nasq_{{app}} owns its capabilities, groups and role (spec R2) and runs at install."""

    @classmethod
    def setUpClass(cls):
        super().setUpClass()
        cls.service = cls.env['nasq.access.service']
        cls.Permission = cls.env['nasq.access.permission']

    def _keys(self, role_xmlid):
        return set(self.env.ref(role_xmlid).permission_ids.mapped('key'))

    def test_owns_its_capabilities_and_their_groups(self):
        catalog = self.service._nasq_capability_map()
        self.assertEqual(
            {key for key, item in catalog.items() if item['owner'] == 'nasq_{{app}}'},
            set(PERMISSIONS),
        )
        permissions = self.Permission.search([('key', 'in', sorted(PERMISSIONS))])
        self.assertEqual(len(permissions), len(PERMISSIONS))
        for permission in permissions:
            self.assertTrue(permission.group_xmlid.startswith('nasq_{{app}}.group_cap_{{app}}_'), permission.key)
            self.assertTrue(self.env.ref(permission.group_xmlid, raise_if_not_found=False), permission.key)

    def test_manager_role_is_unique_and_owned_by_the_addon(self):
        role = self.env.ref('nasq_{{app}}.role_{{app}}_manager')
        self.assertEqual((role.key, role.type, role.protected), ('{{app}}_manager', 'built_in', True))
        self.assertEqual(self.env['nasq.access.role'].search_count([('key', '=', '{{app}}_manager')]), 1)
        self.assertEqual(self._keys('nasq_{{app}}.role_{{app}}_manager'), set(PERMISSIONS))
        self.assertTrue(self._keys('nasq_core.role_employee') >= EMPLOYEE_PERMISSIONS)
        self.assertTrue(self._keys('nasq_core.role_vendor_support') >= PERMISSIONS)

    def test_manage_depends_on_read(self):
        manage = self.Permission.search([('key', '=', '{{app}}.records.manage')])
        self.assertEqual(manage.dependency_ids.mapped('key'), ['{{app}}.records.read'])

    def test_legacy_groups_still_grant_capabilities(self):
        manager = new_test_user(self.env, login='{{app}}_comp_manager', groups='nasq_{{app}}.group_{{app}}_manager')
        employee = new_test_user(self.env, login='{{app}}_comp_employee', groups='nasq_core.group_employee')
        self.assertTrue(self.service._nasq_capability_keys(manager) >= PERMISSIONS)
        self.assertTrue(self.service._nasq_capability_keys(employee) >= EMPLOYEE_PERMISSIONS)
