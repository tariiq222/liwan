from odoo import api, models

PERMISSIONS = frozenset({'{{app}}.records.read', '{{app}}.records.manage'})
EMPLOYEE_PERMISSIONS = frozenset({'{{app}}.records.read'})
PERMISSION_DEPENDENCIES = {
    '{{app}}.records.manage': {'{{app}}.records.read'},
}


class Nasq{{App}}AccessService(models.AbstractModel):
    _inherit = 'nasq.access.service'

    @api.model
    def _nasq_capability_definitions(self):
        return super()._nasq_capability_definitions() + tuple(
            {'key': key, 'owner': 'nasq_{{app}}'} for key in sorted(PERMISSIONS)
        )

    @api.model
    def _nasq_permission_dependencies(self):
        dependencies = super()._nasq_permission_dependencies()
        for key, required in PERMISSION_DEPENDENCIES.items():
            dependencies[key] = dependencies.get(key, set()) | required
        return dependencies

    @api.model
    def _nasq_builtin_role_grants(self):
        grants = super()._nasq_builtin_role_grants()
        for role_xmlid, keys in (
            ('nasq_{{app}}.role_{{app}}_manager', PERMISSIONS),
            ('nasq_core.role_employee', EMPLOYEE_PERMISSIONS),
            ('nasq_core.role_vendor_support', PERMISSIONS),
        ):
            grants[role_xmlid] = grants.get(role_xmlid, set()) | keys
        return grants

    @api.model
    def _nasq_legacy_capability_keys(self, user):
        keys = super()._nasq_legacy_capability_keys(user)
        if user.has_group('nasq_{{app}}.group_{{app}}_manager'):
            keys |= PERMISSIONS
        if user.has_group('nasq_core.group_employee'):
            keys |= EMPLOYEE_PERMISSIONS
        return keys

    @api.model
    def _nasq_legacy_admin_roles(self):
        return [*super()._nasq_legacy_admin_roles(), '{{app}}_manager']
