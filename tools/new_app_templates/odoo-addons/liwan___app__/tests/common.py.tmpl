from odoo.tests import new_test_user

from odoo.addons.liwan_api.tests.common import LiwanApiCase


class Liwan{{App}}Case(LiwanApiCase):
    """The shared liwan_api fixture plus a {{name_en}} manager user and one record."""

    @classmethod
    def setUpClass(cls):
        super().setUpClass()
        cls.manager = new_test_user(
            cls.env, login='{{app}}_manager', password='{{app}}_manager_pass_123',
            name='{{name_en}} Manager', groups='liwan_core.group_employee',
        )
        cls.env['liwan.access.service']._liwan_replace_assignments(cls.manager, [{
            'role_id': cls.env.ref('liwan_{{app}}.role_{{app}}_manager').id,
            'company_id': cls.env.company.id,
        }])
        cls.outsider = new_test_user(
            cls.env, login='{{app}}_outsider', password='{{app}}_outsider_pass_123',
            name='No {{name_en}} access', groups='base.group_user',
        )
        cls.record = cls.env['liwan.{{app}}.record'].create({'name': 'First record'})
